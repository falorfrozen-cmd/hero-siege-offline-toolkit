@@ -0,0 +1,483 @@
+// Host test for the thread freeze around a hook write (Hero Siege patch series, patch 0002).
+// No game, no Aurie framework, no SafetyHook: the unit stands alone and is included here whole.
+//
+// Build and run, from a Visual Studio x64 developer prompt:
+//   cl /nologo /std:c++latest /EHsc /W3 thread_freeze_test.cpp && thread_freeze_test.exe
+//
+// One line per case, PASS or FAIL. Exit code 0 only if every case passed.
+//
+// The baseline-* cases pin upstream's walk (one Toolhelp snapshot of every thread on the system)
+// as it behaves today, faults included. The target-* cases are what the per-process walk has to
+// do. Both run against the same threads: at least 4 workers that each spin on a counter of their
+// own, and a child process (this executable again, with --child) that holds at least 1000 idle
+// threads, so the system's thread count rises while this process's own count does not. The test
+// reads suspend counts from what SuspendThread and ResumeThread return, and ends the child it
+// started.
+//
+// Nothing in this file is compiled into the DLL.
+
+#define AURIE_HS_FREEZE_TEST_SEAM 1
+#include "../source/framework/Memory Manager/thread_freeze.cpp"
+
+#include <TlHelp32.h>
+#include <algorithm>
+#include <cstdarg>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <cwchar>
+#include <string>
+#include <vector>
+
+namespace HsFreeze = Aurie::Internal::HsFreeze;
+
+namespace
+{
+	constexpr int kWorkers = 4;
+	constexpr unsigned kChildThreads = 1100;
+	constexpr int kCostRuns = 9;
+	constexpr DWORD kSettleMs = 20;
+	constexpr DWORD kGapMs = 60;
+
+	int g_Failures = 0;
+	int g_Cases = 0;
+
+	void Check(const char* Name, bool Passed, const std::string& Detail)
+	{
+		g_Cases++;
+		if (!Passed)
+			g_Failures++;
+		std::printf("%s %s: %s\n", Passed ? "PASS" : "FAIL", Name, Detail.c_str());
+		std::fflush(stdout);
+	}
+
+	std::string Format(const char* Pattern, ...)
+	{
+		char buffer[512];
+		va_list list;
+		va_start(list, Pattern);
+		std::vsnprintf(buffer, sizeof(buffer), Pattern, list);
+		va_end(list);
+		return buffer;
+	}
+
+	// ===== Threads of this process =====
+
+	volatile LONG g_Stop = 0;
+	HANDLE g_StopEvent = nullptr;
+	// Set by Idle on entry, when the new thread's start-up (which holds the loader lock for a
+	// moment) is over: a later freeze must not catch it there.
+	HANDLE g_IdleStarted = nullptr;
+
+	struct Worker
+	{
+		HANDLE Thread = nullptr;
+		volatile LONG64 Counter = 0;
+	};
+
+	Worker g_Workers[kWorkers];
+
+	DWORD WINAPI Spin(LPVOID Parameter)
+	{
+		auto* counter = static_cast<volatile LONG64*>(Parameter);
+		while (!g_Stop)
+		{
+			InterlockedIncrement64(counter);
+			SwitchToThread();
+		}
+		return 0;
+	}
+
+	// Idle until the test ends: a thread whose suspend count is read must still exist then.
+	DWORD WINAPI Idle(LPVOID)
+	{
+		SetEvent(g_IdleStarted);
+		WaitForSingleObject(g_StopEvent, INFINITE);
+		return 0;
+	}
+
+	LONG64 Read(volatile LONG64* Counter)
+	{
+		return InterlockedCompareExchange64(Counter, 0, 0);
+	}
+
+	// Two reads kGapMs apart, after a settle: true when the counter did not move.
+	bool Stopped(volatile LONG64* Counter)
+	{
+		Sleep(kSettleMs);
+		LONG64 first = Read(Counter);
+		Sleep(kGapMs);
+		return Read(Counter) == first;
+	}
+
+	bool Moving(volatile LONG64* Counter)
+	{
+		LONG64 first = Read(Counter);
+		Sleep(kGapMs);
+		return Read(Counter) != first;
+	}
+
+	// The suspend count, read without changing it: SuspendThread returns the count before it
+	// added one, and ResumeThread takes that one away again. MAXDWORD when the call failed.
+	DWORD SuspendCount(HANDLE Thread)
+	{
+		DWORD previous = SuspendThread(Thread);
+		if (previous != static_cast<DWORD>(-1))
+			ResumeThread(Thread);
+		return previous;
+	}
+
+	unsigned OwnThreadCount()
+	{
+		unsigned count = 0;
+		HANDLE snapshot = CreateToolhelp32Snapshot(TH32CS_SNAPTHREAD, 0);
+		if (snapshot == INVALID_HANDLE_VALUE)
+			return 0;
+		THREADENTRY32 entry = {}; entry.dwSize = sizeof(entry);
+		if (Thread32First(snapshot, &entry))
+		{
+			do
+			{
+				if (entry.th32OwnerProcessID == GetCurrentProcessId())
+					count++;
+			} while (Thread32Next(snapshot, &entry));
+		}
+		CloseHandle(snapshot);
+		return count;
+	}
+
+	// ===== The thread a seam starts between two passes =====
+
+	// One per case that starts one, each with a counter of its own: the baseline's keeps running.
+	Worker g_Late[2];
+	Worker* volatile g_LateSlot = nullptr;
+
+	void StartLateThread(unsigned Pass)
+	{
+		Worker* slot = static_cast<Worker*>(InterlockedExchangePointer(
+			reinterpret_cast<PVOID volatile*>(&g_LateSlot), nullptr));
+		if (Pass != 1 || !slot)
+			return;
+		slot->Thread = CreateThread(nullptr, 0, Spin, const_cast<LONG64*>(&slot->Counter), 0, nullptr);
+	}
+
+	// ===== The child that holds many idle threads =====
+
+	DWORD WINAPI ChildIdle(LPVOID Parameter)
+	{
+		WaitForSingleObject(static_cast<HANDLE>(Parameter), INFINITE);
+		return 0;
+	}
+
+	int RunChild(HANDLE Ready)
+	{
+		HANDLE never = CreateEventW(nullptr, TRUE, FALSE, nullptr);
+		for (unsigned i = 0; i < kChildThreads; i++)
+		{
+			HANDLE thread = CreateThread(nullptr, 64 * 1024, ChildIdle, never,
+			                             STACK_SIZE_PARAM_IS_A_RESERVATION, nullptr);
+			if (!thread)
+				return 2;
+			CloseHandle(thread);
+		}
+		SetEvent(Ready);
+		Sleep(INFINITE);
+		return 0;
+	}
+
+	struct Child
+	{
+		HANDLE Job = nullptr;
+		HANDLE Process = nullptr;
+	};
+
+	bool StartChild(Child& Out, std::string& Why)
+	{
+		SECURITY_ATTRIBUTES inherit = { sizeof(inherit), nullptr, TRUE };
+		HANDLE ready = CreateEventW(&inherit, TRUE, FALSE, nullptr);
+		wchar_t self[MAX_PATH] = {};
+		GetModuleFileNameW(nullptr, self, MAX_PATH);
+		wchar_t command[MAX_PATH + 64] = {};
+		std::swprintf(command, MAX_PATH + 64, L"\"%ls\" --child %llu", self,
+		              static_cast<unsigned long long>(reinterpret_cast<ULONG_PTR>(ready)));
+
+		// A job that kills the child when this process ends, however it ends.
+		Out.Job = CreateJobObjectW(nullptr, nullptr);
+		JOBOBJECT_EXTENDED_LIMIT_INFORMATION limits = {};
+		limits.BasicLimitInformation.LimitFlags = JOB_OBJECT_LIMIT_KILL_ON_JOB_CLOSE;
+		if (Out.Job)
+			SetInformationJobObject(Out.Job, JobObjectExtendedLimitInformation, &limits, sizeof(limits));
+
+		STARTUPINFOW startup = { sizeof(startup) };
+		PROCESS_INFORMATION process = {};
+		if (!CreateProcessW(nullptr, command, nullptr, nullptr, TRUE, CREATE_SUSPENDED, nullptr,
+		                    nullptr, &startup, &process))
+		{
+			Why = Format("CreateProcessW failed, error %lu", GetLastError());
+			return false;
+		}
+		if (Out.Job)
+			AssignProcessToJobObject(Out.Job, process.hProcess);
+		ResumeThread(process.hThread);
+		CloseHandle(process.hThread);
+		Out.Process = process.hProcess;
+
+		HANDLE waits[2] = { ready, process.hProcess };
+		DWORD woke = WaitForMultipleObjects(2, waits, FALSE, 60000);
+		CloseHandle(ready);
+		if (woke != WAIT_OBJECT_0)
+		{
+			Why = woke == WAIT_OBJECT_0 + 1 ? "the child exited before it was ready"
+			                                : "the child was not ready within 60 s";
+			return false;
+		}
+		return true;
+	}
+
+	void EndChild(Child& Started)
+	{
+		if (Started.Process)
+		{
+			TerminateProcess(Started.Process, 0);
+			WaitForSingleObject(Started.Process, 10000);
+			CloseHandle(Started.Process);
+		}
+		if (Started.Job)
+			CloseHandle(Started.Job);
+	}
+
+	// ===== Cases =====
+
+	// One freeze/resume pair, either walk, for the cases both walks share.
+	struct Pair
+	{
+		bool Target;
+		unsigned Freeze() const
+		{
+			if (Target)
+			{
+				HsFreeze::Freeze();
+				return 0;
+			}
+			return HsFreeze::FreezeSystemSnapshot();
+		}
+		void Resume() const
+		{
+			if (Target)
+				HsFreeze::Resume();
+			else
+				HsFreeze::ResumeSystemSnapshot();
+		}
+	};
+
+	void SuspendsOthers(const Pair& Walk, const char* Name)
+	{
+		// The target case also holds one worker the test suspended itself beforehand: a freeze
+		// must give it back exactly as suspended as it found it.
+		HANDLE held = Walk.Target ? g_Workers[0].Thread : nullptr;
+		if (held)
+			SuspendThread(held);
+
+		Walk.Freeze();
+		bool all_stopped = true;
+		for (auto& worker : g_Workers)
+			all_stopped = Stopped(&worker.Counter) && all_stopped;
+		Walk.Resume();
+
+		bool all_moving = true;
+		for (auto& worker : g_Workers)
+		{
+			if (worker.Thread == held)
+				continue;
+			all_moving = Moving(&worker.Counter) && all_moving;
+		}
+
+		std::string detail = Format("workers stopped while frozen: %s; moving again after resume: %s",
+		                            all_stopped ? "yes" : "NO", all_moving ? "yes" : "NO");
+		bool passed = all_stopped && all_moving;
+		if (Walk.Target)
+		{
+			HsFreeze::Report report = HsFreeze::LastReport();
+			DWORD count = SuspendCount(held);
+			ResumeThread(held);
+			bool per_process = report.Route == HsFreeze::Walk::PerProcess;
+			bool counted = report.Suspended >= kWorkers;
+			detail += Format("; held worker's suspend count after resume: %lu (want 1); route: %s; "
+			                 "suspended by the walk: %u (want >= %d)",
+			                 count, per_process ? "per-process" : "NOT per-process",
+			                 report.Suspended, kWorkers);
+			passed = passed && count == 1 && per_process && counted;
+		}
+		Check(Name, passed, detail);
+	}
+
+	void UnseenThread(const Pair& Walk, const char* Name, DWORD Want)
+	{
+		Walk.Freeze();
+		HANDLE created = CreateThread(nullptr, 0, Idle, nullptr, CREATE_SUSPENDED, nullptr);
+		Walk.Resume();
+
+		DWORD count = created ? SuspendCount(created) : static_cast<DWORD>(-1);
+		Check(Name, count == Want,
+		      Format("a thread created CREATE_SUSPENDED between freeze and resume has suspend "
+		             "count %lu after resume (want %lu)", count, Want));
+		if (created)
+		{
+			DWORD previous;
+			do
+				previous = ResumeThread(created);
+			while (previous > 1 && previous != static_cast<DWORD>(-1));
+			WaitForSingleObject(g_IdleStarted, 5000);
+			CloseHandle(created);
+		}
+	}
+
+	void LateThread(const Pair& Walk, const char* Name, bool WantSuspended, Worker& Late)
+	{
+		Late.Thread = nullptr;
+		InterlockedExchangePointer(reinterpret_cast<PVOID volatile*>(&g_LateSlot), &Late);
+		HsFreeze::g_AfterPass = StartLateThread;
+		Walk.Freeze();
+		HsFreeze::g_AfterPass = nullptr;
+
+		DWORD count = Late.Thread ? SuspendCount(Late.Thread) : static_cast<DWORD>(-1);
+		bool running = Late.Thread && Moving(&Late.Counter);
+		Walk.Resume();
+
+		bool started = Late.Thread != nullptr;
+		bool suspended = started && count != static_cast<DWORD>(-1) && count >= 1;
+		bool passed = started && (WantSuspended ? (suspended && !running) : (!suspended && running));
+		Check(Name, passed,
+		      Format("a thread started between passes: suspend count %lu and %s when freeze returned "
+		             "(want %s)", count, running ? "running" : "not running",
+		             WantSuspended ? "suspended" : "running"));
+	}
+
+	double Milliseconds(LARGE_INTEGER From, LARGE_INTEGER To)
+	{
+		LARGE_INTEGER frequency;
+		QueryPerformanceFrequency(&frequency);
+		return 1000.0 * static_cast<double>(To.QuadPart - From.QuadPart) / static_cast<double>(frequency.QuadPart);
+	}
+
+	double Median(std::vector<double> Values)
+	{
+		std::sort(Values.begin(), Values.end());
+		return Values[Values.size() / 2];
+	}
+
+	double TimePair(const Pair& Walk)
+	{
+		LARGE_INTEGER start, end;
+		QueryPerformanceCounter(&start);
+		Walk.Freeze();
+		Walk.Resume();
+		QueryPerformanceCounter(&end);
+		return Milliseconds(start, end);
+	}
+}
+
+int wmain(int argc, wchar_t** argv)
+{
+	if (argc == 3 && std::wcscmp(argv[1], L"--child") == 0)
+		return RunChild(reinterpret_cast<HANDLE>(static_cast<ULONG_PTR>(std::wcstoull(argv[2], nullptr, 10))));
+
+	g_StopEvent = CreateEventW(nullptr, TRUE, FALSE, nullptr);
+	g_IdleStarted = CreateEventW(nullptr, FALSE, FALSE, nullptr);
+	for (auto& worker : g_Workers)
+		worker.Thread = CreateThread(nullptr, 0, Spin, const_cast<LONG64*>(&worker.Counter), 0, nullptr);
+	// Every worker past its start-up before the first freeze.
+	for (auto& worker : g_Workers)
+		while (Read(&worker.Counter) == 0)
+			Sleep(1);
+
+	Child child;
+	std::string why;
+	if (!StartChild(child, why))
+	{
+		std::printf("FAIL setup: %s\n", why.c_str());
+		EndChild(child);
+		return 1;
+	}
+	std::printf("setup: %d workers; a child process holds %u idle threads; this process has %u threads\n",
+	            kWorkers, kChildThreads, OwnThreadCount());
+
+	const Pair baseline{ false };
+	const Pair target{ true };
+
+	// --- baseline: upstream's walk, as it behaves today ---
+	SuspendsOthers(baseline, "baseline-suspends-others");
+	{
+		unsigned visited = HsFreeze::FreezeSystemSnapshot();
+		HsFreeze::ResumeSystemSnapshot();
+		Check("baseline-scales-with-system", visited >= kChildThreads,
+		      Format("the snapshot walk visited %u entries; the child alone holds %u threads", visited, kChildThreads));
+	}
+	UnseenThread(baseline, "baseline-resumes-unseen", 0);
+	LateThread(baseline, "baseline-misses-late-thread", false, g_Late[0]);
+
+	// --- target: the per-process walk ---
+	SuspendsOthers(target, "target-suspends-others");
+	{
+		HsFreeze::Freeze();
+		// Nothing in this process can start or end a thread now except this one.
+		unsigned own = OwnThreadCount();
+		HsFreeze::Resume();
+		HsFreeze::Report report = HsFreeze::LastReport();
+		bool per_process = report.Route == HsFreeze::Walk::PerProcess;
+		Check("target-own-threads-only",
+		      per_process && report.VisitedLastPass == own && report.VisitedFirstPass < kChildThreads,
+		      Format("route %s; the last pass visited %u entries, this process has %u threads; the first "
+		             "pass visited %u (the child's %u threads must not count)",
+		             per_process ? "per-process" : "NOT per-process", report.VisitedLastPass, own,
+		             report.VisitedFirstPass, kChildThreads));
+	}
+	UnseenThread(target, "target-leaves-unseen", 1);
+	LateThread(target, "target-catches-late-thread", true, g_Late[1]);
+
+	{
+		std::vector<double> snapshot, per_process;
+		for (int run = 0; run < kCostRuns; run++)
+		{
+			snapshot.push_back(TimePair(baseline));
+			per_process.push_back(TimePair(target));
+		}
+		double snapshot_median = Median(snapshot);
+		double per_process_median = Median(per_process);
+		Check("target-cost", per_process_median * 5.0 < snapshot_median,
+		      Format("freeze+resume median over %d runs with the child running: per-process %.3f ms, "
+		             "system snapshot %.3f ms (want per-process under a fifth)",
+		             kCostRuns, per_process_median, snapshot_median));
+	}
+
+	{
+		// The first per-process freeze hands out one line, once; the snapshot pairs above are
+		// upstream's walk called directly and hand out none.
+		const char* first = HsFreeze::TakeNote();
+		const char* second = HsFreeze::TakeNote();
+		const char* prefix = "[hs] MmCreateHook freeze: per-process thread walk";
+		bool named = first && std::strncmp(first, prefix, std::strlen(prefix)) == 0;
+		Check("target-logs-once", named && !second,
+		      Format("first note: %s; second note: %s", first ? first : "(none)", second ? second : "(none)"));
+	}
+
+	// Ends every thread this test started, and the child.
+	InterlockedExchange(&g_Stop, 1);
+	SetEvent(g_StopEvent);
+	for (auto& worker : g_Workers)
+	{
+		WaitForSingleObject(worker.Thread, 10000);
+		CloseHandle(worker.Thread);
+	}
+	for (auto& late : g_Late)
+	{
+		if (!late.Thread)
+			continue;
+		WaitForSingleObject(late.Thread, 10000);
+		CloseHandle(late.Thread);
+	}
+	EndChild(child);
+
+	std::printf("%d of %d cases passed\n", g_Cases - g_Failures, g_Cases);
+	return g_Failures == 0 ? 0 : 1;
+}
