index 0000000..6773825
--- /dev/null
+++ b/Aurie/source/framework/Memory Manager/thread_freeze.cpp	
@@ -0,0 +1,477 @@
+// File: thread_freeze.cpp
+//
+// The thread freeze around a hook write (Hero Siege patch series, patch 0002). See
+// thread_freeze.hpp for what calls it and why it stands alone.
+//
+// Upstream suspends the process with one Toolhelp snapshot of every thread on the system, and
+// resumes it with a second one. Each snapshot costs tens of milliseconds on a desktop with a few
+// thousand threads, and a hook install pays for two. The freeze here lists this process's threads
+// only, through ntdll's NtGetNextThread, keeps a handle to each thread it suspended, and resumes
+// exactly those. Upstream's walk stays below, unchanged, as the fallback.
+//
+// Between the first SuspendThread and the last ResumeThread, nothing here allocates, logs, or
+// calls anything that takes the loader lock: a suspended thread may hold the heap lock or the
+// loader lock, and the calling thread would then wait on it forever. The handle storage is
+// reserved and NtGetNextThread resolved before the first thread is suspended, and the log lines
+// are handed out by TakeNote after the last one is resumed.
+
+#include "thread_freeze.hpp"
+#include <TlHelp32.h>
+#include <stdio.h>
+
+namespace Aurie
+{
+	namespace Internal
+	{
+		namespace HsFreeze
+		{
+#ifdef AURIE_HS_FREEZE_TEST_SEAM
+			// Host test only, never defined in the DLL build: called after every pass of either
+			// walk, while what that pass suspended stays suspended, so the test can start a thread
+			// between passes.
+			void (*g_AfterPass)(unsigned Pass) = nullptr;
+#define HS_FREEZE_AFTER_PASS(Pass) do { if (g_AfterPass) g_AfterPass(Pass); } while (0)
+#else
+#define HS_FREEZE_AFTER_PASS(Pass) ((void)0)
+#endif
+
+			namespace
+			{
+				// NtGetNextThread is exported by ntdll.dll since Windows Vista and is not in the SDK
+				// headers. It opens the thread after ThreadHandle in ProcessHandle's thread list (the
+				// first one when ThreadHandle is null), and fails when there is none left.
+				using FnNtGetNextThread = LONG(NTAPI*)(
+					HANDLE ProcessHandle,
+					HANDLE ThreadHandle,
+					ACCESS_MASK DesiredAccess,
+					ULONG HandleAttributes,
+					ULONG Flags,
+					PHANDLE NewThreadHandle
+				);
+
+				// Threads one freeze can hold. The game runs a few dozen; a process with more
+				// falls back to upstream's walk for that call.
+				constexpr unsigned kCapacity = 1024;
+
+				// Passes are repeated until one finds no thread it has not suspended yet. A
+				// thread suspended in pass n can no longer start one, so pass n + 1 normally ends
+				// it; the cap only bounds a process that keeps creating threads from outside.
+				constexpr unsigned kMaxPasses = 8;
+
+				constexpr ACCESS_MASK kThreadAccess =
+					THREAD_SUSPEND_RESUME | THREAD_GET_CONTEXT | THREAD_QUERY_LIMITED_INFORMATION;
+
+				struct Entry
+				{
+					// Held until the resume when Suspended; closed at once otherwise.
+					HANDLE Thread;
+					DWORD ThreadId;
+					BOOL Suspended;
+				};
+
+				// One per Freeze call, owned by the calling thread from Freeze to Resume.
+				struct FreezeSet
+				{
+					FreezeSet* Previous;
+					Report Stats;
+					unsigned Count;
+					Entry Entries[kCapacity];
+				};
+
+				INIT_ONCE g_InitOnce = INIT_ONCE_STATIC_INIT;
+				FnNtGetNextThread g_NtGetNextThread = nullptr;
+				DWORD g_TlsSlot = TLS_OUT_OF_INDEXES;
+
+				// The most recent report, published after a resume.
+				SRWLOCK g_ReportLock = SRWLOCK_INIT;
+				Report g_LastReport = {};
+
+				// The log lines: each is written once per process, by the thread that claims it.
+				// The first reason any call fell back, a string literal (const char*).
+				PVOID volatile g_FallbackReason = nullptr;
+				volatile LONG g_FallbackNoteTaken = 0;
+				volatile LONG g_PerProcessReady = 0;
+				volatile LONG g_PerProcessNoteTaken = 0;
+				Report g_FirstPerProcess = {};
+				char g_FallbackNote[192] = {};
+				char g_PerProcessNote[192] = {};
+
+				BOOL CALLBACK Initialise(PINIT_ONCE, PVOID, PVOID*)
+				{
+					HMODULE ntdll = GetModuleHandleW(L"ntdll.dll");
+					if (ntdll)
+					{
+						g_NtGetNextThread = reinterpret_cast<FnNtGetNextThread>(
+							reinterpret_cast<void*>(GetProcAddress(ntdll, "NtGetNextThread"))
+						);
+					}
+					g_TlsSlot = TlsAlloc();
+					return TRUE;
+				}
+
+				void NoteFallback(const char* Reason)
+				{
+					InterlockedCompareExchangePointer(
+						&g_FallbackReason,
+						const_cast<char*>(Reason),
+						nullptr
+					);
+				}
+
+				// Upstream's ElForEachThread loop: the process id handed to the snapshot is
+				// ignored for TH32CS_SNAPTHREAD, so it lists every thread on the system.
+				template <typename Callback>
+				unsigned ForEachSystemThread(Callback&& Visit)
+				{
+					unsigned visited = 0;
+					HANDLE thread_snapshot = CreateToolhelp32Snapshot(TH32CS_SNAPTHREAD, 0x1337);
+
+					if (thread_snapshot == INVALID_HANDLE_VALUE)
+						return visited;
+
+					THREADENTRY32 thread_entry = {}; thread_entry.dwSize = sizeof(thread_entry);
+
+					if (!Thread32First(thread_snapshot, &thread_entry))
+					{
+						CloseHandle(thread_snapshot);
+						return visited;
+					}
+
+					do
+					{
+						visited++;
+						Visit(thread_entry);
+					} while (Thread32Next(thread_snapshot, &thread_entry));
+
+					CloseHandle(thread_snapshot);
+					return visited;
+				}
+
+				bool Known(const FreezeSet* Set, DWORD ThreadId)
+				{
+					for (unsigned i = 0; i < Set->Count; i++)
+					{
+						if (Set->Entries[i].ThreadId == ThreadId)
+							return true;
+					}
+					return false;
+				}
+
+				// One pass over this process's threads. Suspends each thread it has not seen in
+				// an earlier pass, other than the caller. Returns how many it suspended. Sets
+				// Incomplete to the reason, and stops, when the pass cannot cover the whole list:
+				// a thread would not fit in the storage, or NtGetNextThread failed before the end
+				// (a thread it cannot open hides every thread after it, since it is the cursor).
+				unsigned WalkProcessOnce(FreezeSet* Set, DWORD Self, unsigned& Visited, const char*& Incomplete)
+				{
+					unsigned suspended = 0;
+					HANDLE current = nullptr;
+					bool keep = false;
+
+					for (;;)
+					{
+						HANDLE next = nullptr;
+						LONG status = g_NtGetNextThread(GetCurrentProcess(), current, kThreadAccess, 0, 0, &next);
+
+						// The previous handle was the cursor; it is closed now unless the set holds it.
+						if (current && !keep)
+							CloseHandle(current);
+						current = nullptr;
+						keep = false;
+
+						if (status < 0 || !next)
+						{
+							// The end of the list is STATUS_NO_MORE_ENTRIES, a warning-severity
+							// status (top two bits 10). An error-severity one (11), such as an
+							// access denial, means the list did not end here.
+							if ((static_cast<ULONG>(status) >> 30) == 3 || (status >= 0 && !next))
+								Incomplete = "NtGetNextThread failed before the end of this process's thread list";
+							break;
+						}
+
+						current = next;
+						Visited++;
+
+						DWORD thread_id = GetThreadId(next);
+
+						// The caller, by id, is never suspended. A thread whose id cannot be read
+						// cannot be told from the caller, so it is left alone too.
+						if (thread_id == 0 || thread_id == Self || Known(Set, thread_id))
+							continue;
+
+						if (Set->Count == kCapacity)
+						{
+							Incomplete = "the process has more threads than one freeze can hold";
+							CloseHandle(current);
+							current = nullptr;
+							break;
+						}
+
+						Entry& entry = Set->Entries[Set->Count++];
+						entry.ThreadId = thread_id;
+
+						if (SuspendThread(next) == static_cast<DWORD>(-1))
+						{
+							// Remembered, so the next pass does not count it as new, but never resumed.
+							entry.Thread = nullptr;
+							entry.Suspended = FALSE;
+							Set->Stats.NotSuspended++;
+							continue;
+						}
+
+						entry.Thread = next;
+						entry.Suspended = TRUE;
+						keep = true;
+						suspended++;
+						Set->Stats.Suspended++;
+					}
+
+					return suspended;
+				}
+
+				// SuspendThread only queues the suspension. GetThreadContext returns once the
+				// thread has actually stopped, so after this nothing suspended is still running.
+				void WaitUntilStopped(const FreezeSet* Set, unsigned From)
+				{
+					for (unsigned i = From; i < Set->Count; i++)
+					{
+						const Entry& entry = Set->Entries[i];
+						if (!entry.Suspended)
+							continue;
+
+						CONTEXT context = {};
+						context.ContextFlags = CONTEXT_INTEGER;
+						GetThreadContext(entry.Thread, &context);
+					}
+				}
+
+				void ResumeAndClose(FreezeSet* Set)
+				{
+					for (unsigned i = 0; i < Set->Count; i++)
+					{
+						if (Set->Entries[i].Suspended)
+							ResumeThread(Set->Entries[i].Thread);
+					}
+					for (unsigned i = 0; i < Set->Count; i++)
+					{
+						if (Set->Entries[i].Thread)
+							CloseHandle(Set->Entries[i].Thread);
+					}
+					Set->Count = 0;
+				}
+
+				// Only ever called once the threads run again, so no frozen thread can be the one
+				// holding g_ReportLock while this waits for it.
+				void Publish(const Report& Done)
+				{
+					AcquireSRWLockExclusive(&g_ReportLock);
+					g_LastReport = Done;
+					ReleaseSRWLockExclusive(&g_ReportLock);
+				}
+			}
+
+			unsigned FreezeSystemSnapshot()
+			{
+				unsigned visited = ForEachSystemThread(
+					[](const THREADENTRY32& Entry)
+					{
+						// Skip my thread
+						if (GetCurrentThreadId() == Entry.th32ThreadID)
+							return;
+
+						// Skip everything that's not my process
+						if (GetCurrentProcessId() != Entry.th32OwnerProcessID)
+							return;
+
+						HANDLE thread = OpenThread(THREAD_SUSPEND_RESUME, false, Entry.th32ThreadID);
+
+						if (!thread)
+							return;
+
+						SuspendThread(thread);
+						CloseHandle(thread);
+					}
+				);
+
+				HS_FREEZE_AFTER_PASS(1);
+				return visited;
+			}
+
+			unsigned ResumeSystemSnapshot()
+			{
+				return ForEachSystemThread(
+					[](const THREADENTRY32& Entry)
+					{
+						// Skip my thread
+						if (GetCurrentThreadId() == Entry.th32ThreadID)
+							return;
+
+						// Skip everything that's not my process
+						if (GetCurrentProcessId() != Entry.th32OwnerProcessID)
+							return;
+
+						HANDLE thread = OpenThread(THREAD_SUSPEND_RESUME, false, Entry.th32ThreadID);
+
+						if (!thread)
+							return;
+
+						ResumeThread(thread);
+						CloseHandle(thread);
+					}
+				);
+			}
+
+			void Freeze()
+			{
+				// Everything that may allocate or take the loader lock happens here, first.
+				InitOnceExecuteOnce(&g_InitOnce, Initialise, nullptr, nullptr);
+
+				FreezeSet* set = nullptr;
+				const char* reason = nullptr;
+
+				if (g_TlsSlot == TLS_OUT_OF_INDEXES)
+					reason = "no thread-local slot is free for the freeze's state";
+				else if (!g_NtGetNextThread)
+					reason = "ntdll.dll does not export NtGetNextThread";
+				else
+				{
+					set = static_cast<FreezeSet*>(HeapAlloc(GetProcessHeap(), HEAP_ZERO_MEMORY, sizeof(FreezeSet)));
+					if (!set)
+						reason = "the handle storage could not be reserved";
+				}
+
+				if (!set)
+				{
+					// Stateless: Resume finds no set and runs upstream's resume walk.
+					NoteFallback(reason);
+					FreezeSystemSnapshot();
+					return;
+				}
+
+				// Pushed before the first suspension: TlsSetValue may allocate the first time a
+				// thread uses a slot above the first 64.
+				set->Previous = static_cast<FreezeSet*>(TlsGetValue(g_TlsSlot));
+				if (!TlsSetValue(g_TlsSlot, set))
+				{
+					HeapFree(GetProcessHeap(), 0, set);
+					NoteFallback("the freeze's state could not be stored for the calling thread");
+					FreezeSystemSnapshot();
+					return;
+				}
+
+				set->Stats.Route = Walk::PerProcess;
+				const DWORD self = GetCurrentThreadId();
+				const char* incomplete = nullptr;
+
+				for (unsigned pass = 1; pass <= kMaxPasses; pass++)
+				{
+					unsigned visited = 0;
+					unsigned from = set->Count;
+					WalkProcessOnce(set, self, visited, incomplete);
+
+					WaitUntilStopped(set, from);
+
+					set->Stats.Passes = pass;
+					set->Stats.VisitedTotal += visited;
+					set->Stats.VisitedLastPass = visited;
+					if (pass == 1)
+						set->Stats.VisitedFirstPass = visited;
+
+					HS_FREEZE_AFTER_PASS(pass);
+
+					// Done when this pass met no thread an earlier pass had not already met.
+					if (incomplete || set->Count == from)
+						break;
+				}
+
+				if (incomplete)
+				{
+					// This call cannot see or hold every thread. Give back what it took, then
+					// freeze the way upstream does; Resume sees the route and resumes the same way.
+					ResumeAndClose(set);
+					set->Stats.Route = Walk::SystemSnapshot;
+					set->Stats.FallbackReason = incomplete;
+					set->Stats.VisitedFirstPass = set->Stats.VisitedLastPass = set->Stats.VisitedTotal =
+						FreezeSystemSnapshot();
+					set->Stats.Passes = 1;
+				}
+			}
+
+			void Resume()
+			{
+				FreezeSet* set = g_TlsSlot == TLS_OUT_OF_INDEXES
+					? nullptr
+					: static_cast<FreezeSet*>(TlsGetValue(g_TlsSlot));
+
+				if (!set)
+				{
+					// The freeze fell back before it had a set: it suspended the upstream way.
+					Report report = {};
+					report.Route = Walk::SystemSnapshot;
+					report.FallbackReason = static_cast<const char*>(g_FallbackReason);
+					report.Passes = 1;
+					report.VisitedFirstPass = report.VisitedLastPass = report.VisitedTotal = ResumeSystemSnapshot();
+					Publish(report);
+					return;
+				}
+
+				if (set->Stats.Route == Walk::PerProcess)
+					ResumeAndClose(set);
+				else
+					ResumeSystemSnapshot();
+
+				// Every thread runs again from here on.
+				TlsSetValue(g_TlsSlot, set->Previous);
+				Report report = set->Stats;
+				HeapFree(GetProcessHeap(), 0, set);
+
+				if (report.Route == Walk::PerProcess)
+				{
+					if (InterlockedCompareExchange(&g_PerProcessReady, 2, 0) == 0)
+					{
+						g_FirstPerProcess = report;
+						InterlockedExchange(&g_PerProcessReady, 1);
+					}
+				}
+				else
+				{
+					NoteFallback(report.FallbackReason);
+				}
+
+				Publish(report);
+			}
+
+			const char* TakeNote()
+			{
+				const char* reason = static_cast<const char*>(g_FallbackReason);
+				if (reason && InterlockedCompareExchange(&g_FallbackNoteTaken, 1, 0) == 0)
+				{
+					_snprintf_s(g_FallbackNote, sizeof(g_FallbackNote), _TRUNCATE,
+						"[hs] MmCreateHook freeze: FELL BACK to the system-wide thread snapshot: %s", reason);
+					return g_FallbackNote;
+				}
+
+				if (InterlockedCompareExchange(&g_PerProcessReady, 1, 1) == 1 &&
+					InterlockedCompareExchange(&g_PerProcessNoteTaken, 1, 0) == 0)
+				{
+					const Report& first = g_FirstPerProcess;
+					_snprintf_s(g_PerProcessNote, sizeof(g_PerProcessNote), _TRUNCATE,
+						"[hs] MmCreateHook freeze: per-process thread walk, first freeze suspended %u thread(s) "
+						"in %u pass(es), %u not suspendable",
+						first.Suspended, first.Passes, first.NotSuspended);
+					return g_PerProcessNote;
+				}
+
+				return nullptr;
+			}
+
+			Report LastReport()
+			{
+				AcquireSRWLockShared(&g_ReportLock);
+				Report report = g_LastReport;
+				ReleaseSRWLockShared(&g_ReportLock);
+				return report;
+			}
+		}
+	}
+}
