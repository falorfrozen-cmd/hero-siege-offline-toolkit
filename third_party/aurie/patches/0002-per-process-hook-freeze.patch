+++ b/Aurie/source/framework/Memory Manager/thread_freeze.hpp	
@@ -0,0 +1,73 @@
+// File: thread_freeze.hpp
+//
+// The thread freeze around a hook write (Hero Siege patch series, patch 0002).
+//
+// MmCreateHook, MmCreateUnsafeHook, MmCreateMidfunctionHook and the three hook removals suspend
+// every other thread of this process while SafetyHook rewrites the target's first bytes, and
+// resume them afterwards. MmpFreezeCurrentProcess and MmpResumeCurrentProcess in memory.cpp keep
+// their names, signatures and call sites; their bodies call this unit.
+//
+// Plain logic over Win32 calls: nothing here knows an Aurie type, and only Windows SDK headers
+// are included, on purpose - keep it that way, or the host test stops compiling. The host test
+// (thread_freeze_test.cpp in the project's hs-tests directory) includes thread_freeze.cpp itself,
+// so it runs the very code the DLL does.
+
+#ifndef AURIE_HS_THREAD_FREEZE_H_
+#define AURIE_HS_THREAD_FREEZE_H_
+
+#include <Windows.h>
+
+namespace Aurie
+{
+	namespace Internal
+	{
+		namespace HsFreeze
+		{
+			enum class Walk : unsigned
+			{
+				None = 0,
+				PerProcess = 1,
+				SystemSnapshot = 2
+			};
+
+			// What one freeze did. Filled while the threads are frozen, published when they run
+			// again. For the log line and the host test; nothing decides anything from it.
+			struct Report
+			{
+				Walk Route;
+				// nullptr, or why this call ran the system-wide snapshot walk instead.
+				const char* FallbackReason;
+				unsigned Passes;
+				unsigned VisitedFirstPass;
+				unsigned VisitedLastPass;
+				unsigned VisitedTotal;
+				// SuspendThread succeeded: these, and only these, are resumed.
+				unsigned Suspended;
+				// Opened, but SuspendThread failed: left alone, never resumed.
+				unsigned NotSuspended;
+			};
+
+			// The body of MmpFreezeCurrentProcess. Every other thread of the process is
+			// suspended, and each suspension has taken effect, when it returns.
+			void Freeze();
+
+			// The body of MmpResumeCurrentProcess: undoes the calling thread's last Freeze.
+			void Resume();
+
+			// A line to log, or nullptr. Call it after Resume, until it returns nullptr: each
+			// line is handed out once per process, and never while threads are frozen.
+			const char* TakeNote();
+
+			// Upstream's walk, moved here unchanged: one Toolhelp snapshot of every thread on the
+			// system, filtered to this process. The fallback runs it, and the host test pins it.
+			// Both return the number of snapshot entries they visited.
+			unsigned FreezeSystemSnapshot();
+			unsigned ResumeSystemSnapshot();
+
+			// The report of the most recent Freeze/Resume pair to finish, in any thread.
+			Report LastReport();
+		}
+	}
+}
+
+#endif // AURIE_HS_THREAD_FREEZE_H_
