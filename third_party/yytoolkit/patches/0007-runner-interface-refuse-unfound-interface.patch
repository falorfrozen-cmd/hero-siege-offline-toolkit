 			current_rip += current_instruction.info.length;
 		}
 
-		// Copy out everything
-		memcpy(&g_ModuleInterface.m_RunnerInterface, new_rsp + rsp_offset_to_runner_interface, sizeof(YYRunnerInterface));
+		// Copy out everything - but only what the walk actually found. Without the closing
+		// rsp-relative lea the offset is still 0 and the bytes there are not an interface; stage 2
+		// would then call through them. Left zeroed, both functions-array finders see a null
+		// Code_Function_Find and stage 2 ends in a status instead.
+		const int64_t interface_offset = new_rsp_offset + rsp_offset_to_runner_interface;
+		const bool is_interface_inside = RiScan::IsInsideBuffer(interface_offset, sizeof(YYRunnerInterface), KERNEL_STACK_SIZE);
+		const bool is_interface_published = is_chain_end_found && is_interface_inside && !stores_refused;
+
+		if (is_interface_published)
+		{
+			memcpy(&g_ModuleInterface.m_RunnerInterface, new_stack + interface_offset, sizeof(YYRunnerInterface));
+		}
+		else
+		{
+			CmWriteLogOutput(
+				"[%s:%d] GmpRunnerInterfaceHook() => REFUSED to publish the runner interface: %s (%zu stores refused as outside the private stack). Stage 2 will fail with a status.",
+				__FILE__, __LINE__,
+				!is_chain_end_found ? "the walk did not end on the rsp-relative lea" :
+				!is_interface_inside ? "the interface would lie outside the private stack" :
