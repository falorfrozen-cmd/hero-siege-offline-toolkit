+			);
+		}
 
 		GmpWriteInterfaceDump(is_dump_requested, "[%s:%d] New RSP: %llx", __FILE__, __LINE__, new_rsp);
 		GmpWriteInterfaceDump(is_dump_requested, "[%s:%d] New RBP: %llx", __FILE__, __LINE__, new_rbp);
@@ -327,12 +373,13 @@ namespace YYTK
 			dump_request_text = "set, but to something other than 1 - the dump stays off";
 
 		CmWriteLogOutput(
-			"[%s:%d] GmpRunnerInterfaceHook() => RI init summary: %zu instructions walked from 0x%llX, %zu stores emulated, %zu stack rows of which %zu are non-zero, interface at rsp%c0x%llX, the chain %s. YYTK_RI_VERBOSE is %s (its value has %zu characters).",
+			"[%s:%d] GmpRunnerInterfaceHook() => RI init summary: %zu instructions walked from 0x%llX, %zu stores emulated, %zu refused, %zu stack rows of which %zu are non-zero, interface at rsp%c0x%llX, the chain %s. YYTK_RI_VERBOSE is %s (its value has %zu characters).",
 			__FILE__,
 			__LINE__,
 			instructions_walked,
 			g_ModuleInterface.m_RunnerInterfaceBase,
 			stores_emulated,
+			stores_refused,
 			static_cast<size_t>(KERNEL_STACK_SIZE / stack_row_size),
 			RiScan::CountNonZeroRows(new_stack, KERNEL_STACK_SIZE, stack_row_size),
 			is_offset_negative ? '-' : '+',
diff --git a/YYToolkit/source/YYTK/Module Internals/GameMaker/Generic/Generic-RunnerInterfaceScan.hpp b/YYToolkit/source/YYTK/Module Internals/GameMaker/Generic/Generic-RunnerInterfaceScan.hpp
index e146244..12fd9be 100644
--- a/YYToolkit/source/YYTK/Module Internals/GameMaker/Generic/Generic-RunnerInterfaceScan.hpp	
+++ b/YYToolkit/source/YYTK/Module Internals/GameMaker/Generic/Generic-RunnerInterfaceScan.hpp	
@@ -690,6 +690,26 @@ namespace YYTK
 
 			return non_zero_rows;
 		}
+
+		// True if [Offset, Offset + AccessSize) lies inside a buffer of BufferSize bytes.
+		// The hook walks game code it did not write and replays each store into a private
+		// copy of the stack; a displacement it did not expect must be skipped, not written.
+		// Offset is signed because it is a base inside the buffer plus a displacement read
+		// from an instruction, and either may be negative.
+		inline bool IsInsideBuffer(
+			IN int64_t Offset,
+			IN size_t AccessSize,
+			IN size_t BufferSize
+		)
+		{
+			if (Offset < 0 || !AccessSize)
+				return false;
+
+			if (AccessSize > BufferSize)
+				return false;
+
+			return static_cast<uint64_t>(Offset) <= (BufferSize - AccessSize);
+		}
 	}
 }
 
