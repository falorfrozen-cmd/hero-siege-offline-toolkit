+		const int64_t new_rbp_offset = 2 * PAGE_SIZE;
+		const int64_t new_rsp_offset = new_rbp_offset + delta_rsp_rbp;
+
 		int64_t rsp_offset_to_runner_interface = 0;
 
 		// What the summary line reports in place of the dump
 		size_t instructions_walked = 0;
 		size_t stores_emulated = 0;
+		size_t stores_refused = 0;
 		bool is_chain_end_found = false;
 
 		// Loop disassemble
@@ -275,24 +283,62 @@ namespace YYTK
 					continue;
 				}
 
+				int64_t store_offset = 0;
+				bool is_stack_store = true;
+
 				switch (current_instruction.operands[0].mem.base)
 				{
 				case ZYDIS_REGISTER_RSP:
-					*reinterpret_cast<uint64_t*>(new_rsp + current_instruction.operands[0].mem.disp.value) = last_saved_value;
-					stores_emulated++;
