 				case ZYDIS_REGISTER_RBP:
-					*reinterpret_cast<uint64_t*>(new_rbp + current_instruction.operands[0].mem.disp.value) = last_saved_value;
-					stores_emulated++;
+					store_offset = new_rbp_offset + current_instruction.operands[0].mem.disp.value;
+					break;
+				default:
+					is_stack_store = false;
 					break;
 				}
+
+				if (is_stack_store)
