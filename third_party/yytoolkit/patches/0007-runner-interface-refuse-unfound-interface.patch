--- a/YYToolkit/source/YYTK/Module Internals/GameMaker/Generic/Generic-RunnerInterfaceNew.cpp	
+++ b/YYToolkit/source/YYTK/Module Internals/GameMaker/Generic/Generic-RunnerInterfaceNew.cpp	
@@ -186,11 +186,19 @@ namespace YYTK
 		BYTE* new_rbp = reinterpret_cast<BYTE*>(new_stack + (2 * PAGE_SIZE));
 		BYTE* new_rsp = reinterpret_cast<BYTE*>(new_stack + (2 * PAGE_SIZE) + delta_rsp_rbp);
 
