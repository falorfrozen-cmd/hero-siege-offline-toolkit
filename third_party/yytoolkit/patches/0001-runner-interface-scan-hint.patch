+static void TestHintLines()
+{
+	HintLine line;
+
+	// The line the documented build left behind on the 281751552 byte executable
+	Check(Parse("281751552 190141265 190142434\n", line), "hint: a legacy 3 number line is read");
+	Check(line.ExeSize == 281751552 && line.HookRva == 190141265 && line.ChainRva == 190142434, "hint: the legacy numbers come back as written");
+	Check(!line.HasImageIdentity, "hint: a legacy line has no image identity");
+
+	// What ForgePact's ensure_ri_cache pre-seeds (Python writes it with CRLF on Windows)
+	Check(Parse("282105856 190392081 190393250\r\n", line) && line.ChainRva == 190393250 && !line.HasImageIdentity, "hint: a pre-seeded CRLF line is read as a legacy line");
+
+	Check(Parse("281751552 190141265 190142434 1755000000 303000000 0\n", line), "hint: a 6 number line is read");
+	Check(line.HasImageIdentity && line.TimeDateStamp == 1755000000 && line.SizeOfImage == 303000000 && line.CheckSum == 0, "hint: the image identity comes back as written");
+
+	Check(Parse("1 2 3 4\n", line) && !line.HasImageIdentity, "hint: 4 numbers are a legacy line");
+	Check(Parse("1 2 3 4 5\n", line) && !line.HasImageIdentity, "hint: 5 numbers are a legacy line");
+	Check(Parse("1 2 3 4 5 6 7\n", line) && line.HasImageIdentity && line.CheckSum == 6, "hint: numbers after the sixth are ignored");
+	Check(Parse("1 2 3 4 x 6\n", line) && !line.HasImageIdentity && line.ChainRva == 3, "hint: a malformed identity leaves a legacy line");
+	Check(Parse("1 2 3 4294967296 5 6\n", line) && !line.HasImageIdentity, "hint: an identity field over 32 bits leaves a legacy line");
+	Check(Parse("1 2 3 4 4294967296 6\n", line) && !line.HasImageIdentity && line.ChainRva == 3, "hint: a SizeOfImage over 32 bits leaves a legacy line");
+	Check(Parse("1 2 3 4 5 4294967296\n", line) && !line.HasImageIdentity && line.ChainRva == 3, "hint: a CheckSum over 32 bits leaves a legacy line");
+	Check(Parse("1 2 3 4294967295 4294967295 4294967295\n", line) && line.HasImageIdentity && line.SizeOfImage == UINT32_MAX && line.CheckSum == UINT32_MAX, "hint: all three identity fields may be exactly 32 bits");
+	Check(Parse("1 2 3 4294967295 5 6\n", line) && line.HasImageIdentity, "hint: an identity field of exactly 32 bits is fine");
+	Check(Parse("  1\t2   3  \n", line) && line.ExeSize == 1 && line.HookRva == 2 && line.ChainRva == 3, "hint: blanks and tabs separate numbers");
+	Check(Parse("1 2 3", line) && line.ChainRva == 3, "hint: a line without a newline is read");
+	Check(Parse("1 2 3\n4 5 6\n", line) && !line.HasImageIdentity, "hint: only the first line is read");
+	Check(Parse("18446744073709551615 2 3\n", line) && line.ExeSize == UINT64_MAX, "hint: the largest 64-bit number is read");
+
+	// A file cut off while it was written still parses - and is then refused for being outside .text
+	size_t page = 0;
+	Check(Parse("281751552 190141265 1901", line) && line.ChainRva == 1901, "hint: a cut off third number still parses");
+	Check(!GetPageOfRva(line.ChainRva, 0x1000, 0xC000000, 0x1000, page), "hint: ...and its rva is refused for lying outside .text");
+
+	Check(!Parse("", line), "hint: an empty file is refused");
+	Check(!Parse("\n281751552 190141265 190142434\n", line), "hint: an empty first line is refused");
+	Check(!Parse("hello world foo\n", line), "hint: words are refused");
+	Check(!Parse("1 2\n", line), "hint: 2 numbers are refused");
+	Check(!Parse("-1 2 3\n", line), "hint: a negative number is refused");
+	Check(!Parse("+1 2 3\n", line), "hint: a signed number is refused");
+	Check(!Parse("0x10 2 3\n", line), "hint: a hexadecimal number is refused");
+	Check(!Parse("12abc 2 3\n", line), "hint: a number with a tail is refused");
+	Check(!Parse("1.5 2 3\n", line), "hint: a fraction is refused");
+	Check(!Parse("18446744073709551616 2 3\n", line), "hint: 2^64 is refused");
+	Check(!Parse("111111111111111111111 2 3\n", line), "hint: a 21 digit number is refused");
+	Check(!Parse("1 2 \x01\x02\x03\n", line), "hint: binary garbage is refused");
+	Check(line.ExeSize == 0 && line.HookRva == 0 && line.ChainRva == 0, "hint: a refused line leaves nothing behind");
+
+	const std::string long_line = std::string(300, '1') + " 2 3\n";
+	Check(!Parse(long_line.c_str(), line), "hint: an overlong line is refused");
+	const std::string padded_line = "1 2 3" + std::string(300, ' ') + "\n";
+	Check(!Parse(padded_line.c_str(), line), "hint: a line padded past the limit is refused");
+
+	// Writing
+	HintLine fresh;
+	fresh.ExeSize = 281751552;
+	fresh.HookRva = 190141265;
+	fresh.ChainRva = 190142434;
+	fresh.HasImageIdentity = true;
+	fresh.TimeDateStamp = 1755000000;
+	fresh.SizeOfImage = 303000000;
+	fresh.CheckSum = 0;
+
+	Check(FormatHintLine(fresh) == "281751552 190141265 190142434 1755000000 303000000 0\n", "format: 6 numbers, single blanks, one newline");
+
+	HintLine read_back;
+	Check(Parse(FormatHintLine(fresh).c_str(), read_back) && IsSameHintLine(fresh, read_back), "format: what is written is read back as the same line");
+
+	HintLine legacy = fresh;
+	legacy.HasImageIdentity = false;
+	Check(FormatHintLine(legacy) == "281751552 190141265 190142434\n", "format: a line without identity is the legacy form");
+
+	HintLine largest;
+	largest.ExeSize = UINT64_MAX;
+	Check(FormatHintLine(largest) == "18446744073709551615 0 0\n", "format: the largest number and 0 are written in full");
+
+	// "Does the file already say this?" - decides whether the file is rewritten
+	HintLine other = fresh;
+	Check(IsSameHintLine(fresh, other), "same: identical lines are the same");
+	other = fresh; other.ExeSize++;
+	Check(!IsSameHintLine(fresh, other), "same: another size is another line");
+	other = fresh; other.HookRva++;
+	Check(!IsSameHintLine(fresh, other), "same: another hook rva is another line");
+	other = fresh; other.ChainRva++;
+	Check(!IsSameHintLine(fresh, other), "same: another chain rva is another line");
+	other = fresh; other.TimeDateStamp++;
+	Check(!IsSameHintLine(fresh, other), "same: another timestamp is another line");
+	other = fresh; other.SizeOfImage++;
+	Check(!IsSameHintLine(fresh, other), "same: another image size is another line");
+	other = fresh; other.CheckSum++;
+	Check(!IsSameHintLine(fresh, other), "same: another checksum is another line");
+	Check(!IsSameHintLine(fresh, legacy), "same: a legacy line is not the 6 number line (it gets upgraded)");
+	other = legacy; other.TimeDateStamp = 77;
+	Check(IsSameHintLine(legacy, other), "same: identity fields of legacy lines are not compared");
+
+	// The key - for the log only
+	other = fresh; other.HookRva = 1; other.ChainRva = 2;
+	Check(DoesHintKeyMatch(other, fresh), "key: matches no matter what the rvas are");
+	Check(DoesHintKeyMatch(legacy, fresh), "key: a legacy line matches on the size alone");
+	other = fresh; other.ExeSize++;
+	Check(!DoesHintKeyMatch(other, fresh), "key: another size is a mismatch");
+	other = legacy; other.ExeSize++;
+	Check(!DoesHintKeyMatch(other, fresh), "key: a legacy line with another size is a mismatch");
+	other = fresh; other.TimeDateStamp++;
+	Check(!DoesHintKeyMatch(other, fresh), "key: another timestamp is a mismatch");
+	other = fresh; other.SizeOfImage++;
+	Check(!DoesHintKeyMatch(other, fresh), "key: another image size is a mismatch");
+	other = fresh; other.CheckSum++;
+	Check(!DoesHintKeyMatch(other, fresh), "key: another checksum is a mismatch");
+	Check(!DoesHintKeyMatch(fresh, legacy), "key: a stored identity cannot match an unknown one");
+
+	// A mismatched key must not cost the hint its page: the page only depends on the rva and .text
+	other = fresh; other.ExeSize = 1; other.TimeDateStamp = 2;
+	Check(!DoesHintKeyMatch(other, fresh) && GetPageOfRva(other.ChainRva, 0x1000, 0xC000000, 0x1000, page) && page == 0xB554, "key: a mismatched line still names its page");
+}
+
+int main()
+{
+	TestInstructionMatchers();
+	TestPairRuns();
+	TestPageRanking();
+	TestVisitOrder();
+	TestBounds();
+	TestHintLines();
+
+	std::printf("%d checks, %d failed\n", g_ChecksRun, g_ChecksFailed);
+	return g_ChecksFailed ? 1 : 0;
+}
