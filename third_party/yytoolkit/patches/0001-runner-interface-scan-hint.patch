+static void TestBounds()
+{
+	Check(IsSectionInsideImage(0x1000, 0x5000, 0x10000), "bounds: a section in the middle of the image is inside");
+	Check(IsSectionInsideImage(0x1000, 0xF000, 0x10000), "bounds: a section ending with the image is inside");
+	Check(!IsSectionInsideImage(0x1000, 0xF001, 0x10000), "bounds: a section one byte too long is outside");
+	Check(!IsSectionInsideImage(0x10001, 0x10, 0x10000), "bounds: a section starting past the image is outside");
+	Check(!IsSectionInsideImage(UINT64_MAX - 1, 0x10, 0x10000), "bounds: an offset + size that wraps around is outside");
+	Check(!IsSectionInsideImage(0x1000, UINT64_MAX, 0x10000), "bounds: a size that wraps around is outside");
+	Check(!IsSectionInsideImage(0x1000, 0, 0x10000), "bounds: an empty section is refused");
+
+	size_t page = 0;
+	Check(GetPageOfRva(0x1000, 0x1000, 0x5000, 0x1000, page) && page == 0, "page: the first byte of the section is page 0");
+	Check(GetPageOfRva(0x5FFF, 0x1000, 0x5000, 0x1000, page) && page == 4, "page: the last byte of the section is the last page");
+	Check(GetPageOfRva(0xB5557E2, 0x1000, 0xC000000, 0x1000, page) && page == 0xB554, "page: rva 0xB5557E2 of a section at 0x1000 is page 0xB554");
+	Check(!GetPageOfRva(0xFFF, 0x1000, 0x5000, 0x1000, page), "page: an rva below the section is refused");
+	Check(!GetPageOfRva(0x6000, 0x1000, 0x5000, 0x1000, page), "page: the first rva past the section is refused");
+	Check(!GetPageOfRva(UINT64_MAX, 0x1000, 0x5000, 0x1000, page), "page: a huge rva is refused");
+	Check(!GetPageOfRva(0, 0x1000, 0x5000, 0x1000, page), "page: rva 0 is refused");
+	Check(!GetPageOfRva(0x2000, 0x1000, 0x5000, 0, page), "page: a page size of 0 is refused");
+}
