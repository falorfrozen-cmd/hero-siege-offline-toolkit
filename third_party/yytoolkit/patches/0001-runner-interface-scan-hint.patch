+#ifndef YYTK_GENERIC_RUNNERINTERFACEMEMORY_H_
+#define YYTK_GENERIC_RUNNERINTERFACEMEMORY_H_
+
+// The one helper of the runner interface scan that asks Windows about memory.
+//
+// Only standard and Windows headers are included - no Aurie, no Zydis - so that
+// YYToolkit/hs-tests/ri_memory_test.cpp can run it against real VirtualAlloc regions on a build host,
+// without the game. It is kept out of Generic-RunnerInterfaceScan.hpp, which stays free of Windows.
+
+#include <cstddef>
+#include <cstdint>
+#include <Windows.h>
+
+#ifndef IN
+#define IN
+#endif
+
+#ifndef OUT
+#define OUT
+#endif
+
+namespace YYTK
+{
+	namespace RiScan
+	{
+		// True if Protect (as VirtualQuery reports it) is one of the protections that grant read access.
+		//
+		// An allow-list on purpose. "Not PAGE_NOACCESS and not PAGE_GUARD" is NOT the same as readable:
+		// PAGE_EXECUTE passes that test, and so would any protection this code has never heard of.
+		// MEASURED on one x64 host: a PAGE_EXECUTE page can in fact be read. That is a property of the
+		// processor, not a promise of the API, so it is refused here - which only costs the shortcut.
+		inline bool IsReadableProtection(
+			IN DWORD Protect
+		)
+		{
+			// Touching a guard page raises an exception, whatever the protection below it is
+			if (Protect & PAGE_GUARD)
+				return false;
+
+			// The low byte is the protection itself, PAGE_NOCACHE and PAGE_WRITECOMBINE are modifiers
+			switch (Protect & 0xFF)
+			{
+			case PAGE_READONLY:
+			case PAGE_READWRITE:
+			case PAGE_WRITECOPY:
+			case PAGE_EXECUTE_READ:
+			case PAGE_EXECUTE_READWRITE:
+			case PAGE_EXECUTE_WRITECOPY:
+				return true;
+			}
+
+			return false;
+		}
+
+		// True if every byte of [Base, Base + Size) lies in committed memory whose protection grants
+		// read access. The answer is a snapshot: nothing keeps another thread from changing it afterwards.
+		inline bool IsRangeReadable(
+			IN uint64_t Base,
+			IN size_t Size
+		)
+		{
+			const uint64_t range_end = Base + Size;
+			if (!Size || range_end < Base)
+				return false;
+
+			// A section is a handful of regions. The bound only exists so that this loop provably ends.
+			size_t regions_left = 0x10000;
+			uint64_t cursor = Base;
+
+			while (cursor < range_end)
+			{
+				if (!regions_left--)
+					return false;
+
+				MEMORY_BASIC_INFORMATION region = {};
+				if (!VirtualQuery(reinterpret_cast<LPCVOID>(static_cast<uintptr_t>(cursor)), &region, sizeof(region)))
+					return false;
+
+				if (region.State != MEM_COMMIT)
+					return false;
+
+				if (!IsReadableProtection(region.Protect))
+					return false;
+
+				// The region is walked to its end, which is not where the range ends: a region that is
+				// big enough by its size alone may still start before the range and stop inside it.
+				const uint64_t region_end = static_cast<uint64_t>(reinterpret_cast<uintptr_t>(region.BaseAddress)) + region.RegionSize;
+				if (region_end <= cursor)
+					return false;
+
+				cursor = region_end;
+			}
+
+			return true;
+		}
+	}
+}
+
+#endif // YYTK_GENERIC_RUNNERINTERFACEMEMORY_H_
