+		RiScan::HintLine current_line = {};
+		const char* refusal_reason = GmpQueryScanShortcutRefusal(
+			text_base,
+			text_section_offset,
+			text_section_size,
+			current_line
+		);
+
+		if (refusal_reason)
+		{
+			CmWriteLogOutput(
+				"[%s:%d] GmpCreateHookOnInterfaceCreation() => RI scan hint refused, pre-filter refused: %s. Scanning every page in order.",
+				__FILE__,
+				__LINE__,
+				refusal_reason
+			);
+		}
+
+		const bool is_shortcut_allowed = (refusal_reason == nullptr);
+
+		// Pass 1 - the page a hint file names, if there is one.
+		fs::path hint_path = {};
+		RiScan::HintLine stored_line = {};
+		bool has_stored_line = false;
+		bool has_hinted_page = false;
+		size_t hinted_page = 0;
+
+		if (is_shortcut_allowed)
+		{
+			GmpLocateRunnerInterfaceHint(hint_path, current_line.ExeSize);
+
+			has_hinted_page = GmpReadRunnerInterfaceHint(
+				hint_path,
+				current_line,
+				text_section_offset,
+				text_section_size,
+				has_stored_line,
+				stored_line,
+				hinted_page
+			);
+		}
+
+		PVOID hook_address = nullptr;
+		bool is_chain_found = false;
+		bool was_chain_accepted = false;
+		size_t accepted_visit_index = 0;
+
+		// The pages pass 1 scans, which pass 2 then leaves out
+		std::vector<size_t> hint_visit_order = {};
+
+		if (has_hinted_page)
+		{
+			// The page before the hinted one is scanned as well, and first - a hint must not get the
+			// page a chain continues on scanned without the page it starts on, as the pairs left on
+			// that page can still pass upstream's test and the middle of the chain would become its
+			// start. REASONED from that test, NOT reproduced: the one build whose chain was located
+			// (rva 0xB5557E2) has it inside a single page, which says nothing about the next build.
+			hint_visit_order = RiScan::BuildHintVisitOrder(hinted_page, code_pages);
+
+			last_status = GmpScanPagesForRunnerInterfaceX64(
+				text_base,
+				hint_visit_order,
+				&hook_address,
+				Handler,
+				was_chain_accepted,
+				accepted_visit_index
+			);
+
+			if (AurieSuccess(last_status))
+			{
+				is_chain_found = true;
+
+				CmWriteLogOutput(
+					"[%s:%d] GmpCreateHookOnInterfaceCreation() => RI scan hint hit: the scan of page %zu found the chain at rva 0x%llX (the hint said 0x%llX, page %zu), %zu of %zu pages scanned",
+					__FILE__,
+					__LINE__,
+					hint_visit_order[accepted_visit_index],
+					g_ModuleInterface.m_RunnerInterfaceBase - game_base,
+					stored_line.ChainRva,
+					hinted_page,
+					accepted_visit_index + 1,
+					code_pages
+				);
+			}
+			else if (was_chain_accepted)
+			{
+				// The chain IS on these pages, so this is not a miss and scanning the rest of .text
+				// could not help: the hook would be attempted at the same place again.
+				CmWriteLogOutput(
+					"[%s:%d] GmpCreateHookOnInterfaceCreation() => RI scan hint hook failed: the chain is on page %zu but the hook could not be created there (%s), the other pages are not scanned",
+					__FILE__,
+					__LINE__,
+					hint_visit_order[accepted_visit_index],
+					AurieStatusToString(last_status)
+				);
+
+				return last_status;
+			}
+			else
+			{
+				CmWriteLogOutput(
+					"[%s:%d] GmpCreateHookOnInterfaceCreation() => RI scan hint miss: no chain on hinted page %zu or the page before it (%zu scanned), scanning the other pages",
+					__FILE__,
+					__LINE__,
+					hinted_page,
+					hint_visit_order.size()
+				);
+			}
+		}
+
+		// Pass 2 - every page not scanned yet, exactly once: the ranked ones first, then the rest in order.
+		if (!is_chain_found)
+		{
+			CmWriteOutput(
+				CM_LIGHTAQUA,
+				"Please wait while the game is being disassembled. This can take up to a minute on slower hardware."
+			);
+
+			std::vector<size_t> ranked_pages = {};
+
+			if (is_shortcut_allowed)
+			{
+				// ASSUMED to be much cheaper than disassembling the same bytes, as it is one forward pass
+				// that mostly compares a single byte. NOT measured: on a cold launch it still has to page
+				// all of .text in from disk, which no log of this game has timed yet.
+				ranked_pages = RiScan::RankPages(
+					reinterpret_cast<const uint8_t*>(static_cast<uintptr_t>(text_base)),
+					text_section_size,
+					code_pages,
+					PAGE_SIZE
+				);
+
+				CmWriteLogOutput(
+					"[%s:%d] GmpCreateHookOnInterfaceCreation() => RI pre-filter ranked %zu of %zu pages to be scanned first",
+					__FILE__,
+					__LINE__,
+					ranked_pages.size(),
+					code_pages
+				);
+			}
+
+			// How many of the ranked pages really lead the order (pass 1 may have scanned some already)
+			size_t ranked_visit_count = 0;
+
+			const std::vector<size_t> page_visit_order = RiScan::BuildPageVisitOrder(
+				ranked_pages,
+				code_pages,
+				hint_visit_order,
+				ranked_visit_count
+			);
+
+			last_status = GmpScanPagesForRunnerInterfaceX64(
+				text_base,
+				page_visit_order,
+				&hook_address,
+				Handler,
+				was_chain_accepted,
+				accepted_visit_index
+			);
+
+			// Whether the ranking did anything is said here, in so many words, on every launch that gets
+			// this far. "ranked N pages" followed by success looks the same whether the chain was on the
+			// first ranked page or on the last page of the address-order remainder.
+			if (is_shortcut_allowed && was_chain_accepted)
+			{
+				const bool is_ranked_hit = RiScan::IsVisitIndexRanked(accepted_visit_index, ranked_visit_count);
+
+				CmWriteLogOutput(
+					is_ranked_hit ?
+						"[%s:%d] GmpCreateHookOnInterfaceCreation() => RI pre-filter hit: chain on page %zu, which was visit %zu of %zu (%zu ranked pages led the order)" :
+						"[%s:%d] GmpCreateHookOnInterfaceCreation() => RI pre-filter miss: chain on page %zu was not among the ranked pages, found in address order at visit %zu of %zu (%zu ranked pages led the order)",
+					__FILE__,
+					__LINE__,
+					page_visit_order[accepted_visit_index],
+					accepted_visit_index + 1,
+					page_visit_order.size(),
+					ranked_visit_count
+				);
+			}
+
+			if (!AurieSuccess(last_status))
+			{
+				if (!was_chain_accepted)
+				{
+					CmWriteLogOutput(
+						"[%s:%d] GmpCreateHookOnInterfaceCreation() => RI scan found no chain: %zu pages scanned in this pass, %zu for the hint before it",
+						__FILE__,
+						__LINE__,
+						page_visit_order.size(),
+						hint_visit_order.size()
+					);
+				}
+
+				return last_status;
+			}
+		}
+
+		if (Rip)
+			*Rip = hook_address;
+
+		if (is_shortcut_allowed)
+		{
+			// Both come from the page scan that just ran - neither was read from the file
+			current_line.HookRva = reinterpret_cast<uint64_t>(hook_address) - game_base;
+			current_line.ChainRva = g_ModuleInterface.m_RunnerInterfaceBase - game_base;
+
+			GmpUpdateRunnerInterfaceHint(
+				hint_path,
+				has_stored_line,
+				stored_line,
+				current_line
+			);
+		}
+
+		return AURIE_SUCCESS;
+	}
 }
