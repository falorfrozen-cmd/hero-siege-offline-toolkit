+#ifndef YYTK_GENERIC_RUNNERINTERFACESCAN_H_
+#define YYTK_GENERIC_RUNNERINTERFACESCAN_H_
+
+// Pure helpers for the runner interface scan in Generic-RunnerInterfaceNew.cpp.
+//
+// Only standard headers are included - no Aurie, no Zydis, no Windows - so that
+// YYToolkit/hs-tests/ri_scan_test.cpp can compile and exercise every function in here on a build
+// host, without the game. Nothing in this file touches memory it was not handed, a file, or a global.
+
+#include <cstddef>
+#include <cstdint>
+#include <algorithm>
+#include <istream>
+#include <string>
+#include <vector>
+
+#ifndef IN
+#define IN
+#endif
+
+#ifndef OUT
+#define OUT
+#endif
+
+namespace YYTK
+{
+	namespace RiScan
+	{
+		// ===== Page ranking =====
+		// The runner interface is built by a long run of
+		//     lea r64, [rip+disp32]
+		//     mov [rbp|rsp+disp], r64
+		// pairs (see the comment block in GmpScanPagesForRunnerInterfaceX64). The functions below find
+		// such runs by looking at raw bytes. They decide NOTHING about which site gets hooked: they only
+		// pick the order in which the unchanged page scan visits pages, and every page stays in that order.
+
+		// The encoded length of "lea r64, [rip+disp32]": REX.W, 8D, ModRM, disp32.
+		constexpr size_t g_RipRelativeLeaLength = 7;
+
+		// True if Code[Offset] starts a "lea r64, [rip+disp32]".
+		inline bool IsRipRelativeLea(
+			IN const uint8_t* Code,
+			IN size_t CodeSize,
+			IN size_t Offset
+		)
+		{
+			if (Offset >= CodeSize || (CodeSize - Offset) < g_RipRelativeLeaLength)
+				return false;
+
+			// REX.W, optionally with REX.R for r8-r15 as the destination
+			if (Code[Offset] != 0x48 && Code[Offset] != 0x4C)
+				return false;
+
+			if (Code[Offset + 1] != 0x8D)
+				return false;
+
+			// ModRM: mod=00 rm=101 is [rip+disp32], the reg field is free
+			return (Code[Offset + 2] & 0xC7) == 0x05;
+		}
+
+		// The length of a "mov [rbp|rsp+disp8|disp32], r64" starting at Code[Offset], or 0 if there is none.
+		inline size_t GetStackStoreLength(
+			IN const uint8_t* Code,
+			IN size_t CodeSize,
+			IN size_t Offset
+		)
+		{
+			// The shortest form (REX.W, 89, ModRM, disp8) is 4 bytes, and byte 4 is read for the SIB check
+			if (Offset >= CodeSize || (CodeSize - Offset) < 4)
+				return 0;
+
+			// REX.W, optionally with REX.R. REX.B or REX.X would turn the base into r13/r12 or add an index.
+			if (Code[Offset] != 0x48 && Code[Offset] != 0x4C)
+				return 0;
+
+			if (Code[Offset + 1] != 0x89)
+				return 0;
+
+			const uint8_t mod_field = static_cast<uint8_t>(Code[Offset + 2] >> 6);
+			const uint8_t rm_field = static_cast<uint8_t>(Code[Offset + 2] & 0x07);
+
+			// mod=01 carries a disp8, mod=10 a disp32.
+			// mod=00 is either no displacement or rip-relative, mod=11 is register to register.
+			size_t length = 0;
+			if (mod_field == 1)
+				length = 4;
+			else if (mod_field == 2)
+				length = 7;
+			else
+				return 0;
+
+			if (rm_field == 4)
+			{
+				// rm=100 means a SIB byte follows. 0x24 is "base=rsp, no index" - the only form wanted.
+				if (Code[Offset + 3] != 0x24)
+					return 0;
+
+				length++;
+			}
+			else if (rm_field != 5)
+			{
+				// rm=101 with mod=01|10 is rbp. Anything else is some other register.
+				return 0;
+			}
+
+			if ((CodeSize - Offset) < length)
+				return 0;
+
+			return length;
+		}
+
+		// Up to this many bytes of something else may sit next to a pair without ending the run.
+		// The comment block in the .cpp shows a 5 byte "mov edx, 320h" between a lea and its store.
+		constexpr size_t g_MaximumPairGap = 7;
+
+		// Counts the lea/store pairs of the run starting at Code[Offset], which has to be a lea.
+		// RunEnd receives the offset just past the last store that was counted.
+		inline uint32_t MeasurePairRun(
+			IN const uint8_t* Code,
+			IN size_t CodeSize,
+			IN size_t Offset,
+			OUT size_t& RunEnd
+		)
+		{
+			uint32_t pair_count = 0;
+			size_t cursor = Offset;
+			RunEnd = Offset;
+
+			while (true)
+			{
+				// Find the lea - right at the cursor for the first pair, within the gap for the ones after it
+				const size_t maximum_lea_gap = pair_count ? g_MaximumPairGap : 0;
+				size_t lea_offset = cursor;
+				bool is_lea_found = false;
+
+				for (size_t gap = 0; gap <= maximum_lea_gap; gap++)
+				{
+					if (IsRipRelativeLea(Code, CodeSize, cursor + gap))
+					{
+						lea_offset = cursor + gap;
+						is_lea_found = true;
+						break;
+					}
+				}
+
+				if (!is_lea_found)
+					break;
+
+				// Find the store of that lea
+				const size_t store_search_start = lea_offset + g_RipRelativeLeaLength;
+				size_t store_offset = 0;
+				size_t store_length = 0;
+
+				for (size_t gap = 0; gap <= g_MaximumPairGap; gap++)
+				{
+					store_length = GetStackStoreLength(Code, CodeSize, store_search_start + gap);
+					if (store_length)
+					{
+						store_offset = store_search_start + gap;
+						break;
+					}
+				}
+
+				if (!store_length)
+					break;
+
+				pair_count++;
+				cursor = store_offset + store_length;
+				RunEnd = cursor;
+			}
+
+			return pair_count;
+		}
+
+		// The page scan looks for four lea/mov pairs in a row, so a shorter run can never be accepted by it.
+		constexpr uint32_t g_MinimumRankedPairs = 4;
+
+		// One linear pass over the bytes, no disassembly. Returns the pages that hold the longest lea/store
+		// runs, longest run first; equal runs keep address order, which is the order upstream scans in.
+		//
+		// A run that crosses a page boundary links its pages: whenever a later page of such a run is
+		// returned, the earlier pages of that run are returned right before it. Upstream always sees the
+		// page a run starts on before the pages it continues on, and the ranking must not change that.
+		//
+		// Roughly MaximumRankedPages pages are returned (a linked group is never cut in half).
+		inline std::vector<size_t> RankPages(
+			IN const uint8_t* Text,
+			IN size_t TextSize,
+			IN size_t PageCount,
+			IN size_t PageSize,
+			IN size_t MaximumRankedPages = 64
+		)
+		{
+			std::vector<size_t> ranked_pages = {};
+
+			if (!Text || !TextSize || !PageCount || !PageSize)
+				return ranked_pages;
+
+			// The longest run touching each page, and whether a run reaches the page from the one before it
+			std::vector<uint32_t> longest_run(PageCount, 0);
+			std::vector<bool> continues_previous_page(PageCount, false);
+
+			size_t offset = 0;
+			while (offset < TextSize)
+			{
+				if (!IsRipRelativeLea(Text, TextSize, offset))
+				{
+					offset++;
+					continue;
+				}
+
+				size_t run_end = offset;
+				const uint32_t pair_count = MeasurePairRun(Text, TextSize, offset, run_end);
+
+				if (pair_count < g_MinimumRankedPairs)
+				{
+					offset++;
+					continue;
+				}
+
+				const size_t first_page = offset / PageSize;
+				const size_t last_page = (run_end - 1) / PageSize;
+
+				for (size_t page = first_page; page <= last_page && page < PageCount; page++)
+				{
+					longest_run[page] = (std::max)(longest_run[page], pair_count);
+
+					if (page != first_page)
+						continues_previous_page[page] = true;
+				}
+
+				// run_end is past offset, as at least four pairs were counted
+				offset = run_end;
+			}
+
+			std::vector<size_t> candidate_pages = {};
+			for (size_t page = 0; page < PageCount; page++)
+			{
+				if (longest_run[page])
+					candidate_pages.push_back(page);
+			}
+
+			std::stable_sort(
+				candidate_pages.begin(),
+				candidate_pages.end(),
+				[&longest_run](size_t First, size_t Second) -> bool
+				{
+					return longest_run[First] > longest_run[Second];
+				}
+			);
+
+			std::vector<bool> is_page_returned(PageCount, false);
+
+			for (const size_t candidate : candidate_pages)
+			{
+				if (ranked_pages.size() >= MaximumRankedPages)
+					break;
+
+				// Walk back to the page the linked group starts on
+				size_t group_start = candidate;
+				while (group_start > 0 && continues_previous_page[group_start])
+					group_start--;
+
+				for (size_t page = group_start; page <= candidate; page++)
+				{
+					if (is_page_returned[page])
+						continue;
+
+					is_page_returned[page] = true;
+					ranked_pages.push_back(page);
+				}
+			}
+
+			return ranked_pages;
+		}
+
+		// The full visit order: the preferred pages first, then every other page in address order.
+		// Each page below PageCount appears exactly once, except the SkippedPages, which do not appear
+		// at all. Preferred pages that are out of range, skipped or repeated are dropped.
+		// PreferredVisitCount receives how many entries at the front of the order are preferred pages,
+		// which can be fewer than PreferredPages holds.
+		inline std::vector<size_t> BuildPageVisitOrder(
+			IN const std::vector<size_t>& PreferredPages,
+			IN size_t PageCount,
+			IN const std::vector<size_t>& SkippedPages,
+			OUT size_t& PreferredVisitCount
+		)
+		{
+			std::vector<size_t> visit_order = {};
+			std::vector<bool> is_page_handled(PageCount, false);
+			PreferredVisitCount = 0;
+
+			for (const size_t page : SkippedPages)
+			{
+				if (page < PageCount)
+					is_page_handled[page] = true;
+			}
+
+			for (const size_t page : PreferredPages)
+			{
+				if (page >= PageCount || is_page_handled[page])
+					continue;
+
+				is_page_handled[page] = true;
+				visit_order.push_back(page);
+			}
+
+			PreferredVisitCount = visit_order.size();
+
+			for (size_t page = 0; page < PageCount; page++)
+			{
+				if (!is_page_handled[page])
+					visit_order.push_back(page);
+			}
+
+			return visit_order;
+		}
+
+		// True if the page visited at VisitIndex of a BuildPageVisitOrder order is one of its preferred
+		// pages, ie. the ranking is what brought it to the front. False means the page was only reached
+		// in the address-order remainder, where the ranking saved nothing.
+		inline bool IsVisitIndexRanked(
+			IN size_t VisitIndex,
+			IN size_t PreferredVisitCount
+		)
+		{
+			return VisitIndex < PreferredVisitCount;
+		}
+
+		// The pages scanned for a hint that names HintedPage: the page before it, then the page itself.
+		//
+		// A chain can start near the end of one page and continue on the next. Upstream always sees the
+		// page a chain starts on first, and accepts the true start there. A scan of only the page it
+		// continues on could accept the middle of the chain as its start (the pairs left over can still
+		// pass upstream's 88..103 test), so a hint never gets to show the scan a page without the page
+		// before it. Empty if HintedPage is not below PageCount.
+		inline std::vector<size_t> BuildHintVisitOrder(
+			IN size_t HintedPage,
+			IN size_t PageCount
+		)
+		{
+			std::vector<size_t> visit_order = {};
+
+			if (HintedPage >= PageCount)
+				return visit_order;
+
+			if (HintedPage > 0)
+				visit_order.push_back(HintedPage - 1);
+
+			visit_order.push_back(HintedPage);
+			return visit_order;
+		}
+
+		// True if [SectionOffset, SectionOffset + SectionSize) is not empty and lies inside an image
+		// that is ImageSize bytes big. Written so that no addition can wrap around.
+		inline bool IsSectionInsideImage(
+			IN uint64_t SectionOffset,
+			IN uint64_t SectionSize,
+			IN uint64_t ImageSize
+		)
+		{
+			if (!SectionSize)
+				return false;
+
+			if (SectionOffset > ImageSize)
+				return false;
+
+			return SectionSize <= (ImageSize - SectionOffset);
+		}
+
+		// Turns an rva into the index of the section page it lies on. False if it is outside the section.
+		inline bool GetPageOfRva(
+			IN uint64_t Rva,
+			IN uint64_t SectionOffset,
+			IN uint64_t SectionSize,
+			IN size_t PageSize,
+			OUT size_t& Page
+		)
+		{
+			Page = 0;
+
+			if (!PageSize)
+				return false;
+
+			if (Rva < SectionOffset || (Rva - SectionOffset) >= SectionSize)
+				return false;
+
+			Page = static_cast<size_t>((Rva - SectionOffset) / PageSize);
+			return true;
+		}
+
+		// ===== The scan hint line =====
+		// One line of decimal numbers separated by blanks:
+		//     <exe file size> <hook rva> <chain rva>[ <TimeDateStamp> <SizeOfImage> <CheckSum>]
+		// The first three are the legacy form, which older modified builds wrote and which
+		// ForgePact's control panel pre-seeds. The last three come from the mapped PE headers.
+		struct HintLine
+		{
+			uint64_t ExeSize = 0;
+			// Kept ONLY so that a stored line can be compared with a fresh one.
+			// It must never be turned into an address - the page scan finds the hook address.
+			uint64_t HookRva = 0;
+			// Picks the page that is scanned first, nothing else.
+			uint64_t ChainRva = 0;
+			bool HasImageIdentity = false;
+			uint64_t TimeDateStamp = 0;
+			uint64_t SizeOfImage = 0;
+			uint64_t CheckSum = 0;
+		};
+
+		// Strict unsigned decimal: digits only, no sign, no prefix, no overflow.
+		inline bool ParseDecimal(
+			IN const std::string& Token,
+			OUT uint64_t& Value
+		)
+		{
+			Value = 0;
+
+			// 18446744073709551615 has 20 digits
+			if (Token.empty() || Token.size() > 20)
+				return false;
+
+			uint64_t value = 0;
+			for (const char character : Token)
+			{
+				if (character < '0' || character > '9')
+					return false;
+
+				const uint64_t digit = static_cast<uint64_t>(character - '0');
+
+				if (value > (UINT64_MAX - digit) / 10)
+					return false;
+
+				value = (value * 10) + digit;
+			}
+
+			Value = value;
+			return true;
+		}
+
+		// Reads the first line of Stream. False unless it starts with three decimal numbers.
+		// Anything that is not a complete, well-formed image identity leaves the line a legacy one.
+		inline bool ParseHintLine(
+			IN std::istream& Stream,
+			OUT HintLine& Line
+		)
+		{
+			Line = {};
+
+			// Six 20-digit numbers and their separators fit with room to spare. A longer line is not ours.
+			constexpr size_t maximum_line_length = 192;
+
+			std::vector<std::string> tokens = {};
+			std::string current_token = {};
+			size_t characters_read = 0;
+
+			while (true)
+			{
+				const int character = Stream.get();
+				const bool is_end_of_line = (character == std::char_traits<char>::eof()) || (character == '\n');
+
+				if (!is_end_of_line)
+				{
+					characters_read++;
+					if (characters_read > maximum_line_length)
+						return false;
+				}
+
+				if (is_end_of_line || character == ' ' || character == '\t' || character == '\r')
+				{
+					if (!current_token.empty())
+					{
+						tokens.push_back(current_token);
+						current_token.clear();
+					}
+
+					if (is_end_of_line)
+						break;
+
+					continue;
+				}
+
+				current_token.push_back(static_cast<char>(character));
+			}
+
+			if (tokens.size() < 3)
+				return false;
+
+			if (!ParseDecimal(tokens[0], Line.ExeSize) ||
+				!ParseDecimal(tokens[1], Line.HookRva) ||
+				!ParseDecimal(tokens[2], Line.ChainRva))
+			{
+				Line = {};
+				return false;
+			}
+
+			if (tokens.size() < 6)
+				return true;
+
+			uint64_t timestamp = 0, image_size = 0, checksum = 0;
+			if (!ParseDecimal(tokens[3], timestamp) ||
+				!ParseDecimal(tokens[4], image_size) ||
+				!ParseDecimal(tokens[5], checksum))
+			{
+				return true;
+			}
+
+			// All three are 32-bit fields in the PE headers
+			if (timestamp > UINT32_MAX || image_size > UINT32_MAX || checksum > UINT32_MAX)
+				return true;
+
+			Line.HasImageIdentity = true;
+			Line.TimeDateStamp = timestamp;
+			Line.SizeOfImage = image_size;
+			Line.CheckSum = checksum;
+
+			return true;
+		}
+
+		// The text ParseHintLine reads back, newline included. Digits are produced by hand,
+		// so that no stream locale can put a thousands separator into a number.
+		inline std::string FormatHintLine(
+			IN const HintLine& Line
+		)
+		{
+			const auto append_decimal = [](std::string& Text, uint64_t Value) -> void
+				{
+					char digits[20] = {};
+					size_t digit_count = 0;
+
+					do
+					{
+						digits[digit_count++] = static_cast<char>('0' + (Value % 10));
+						Value /= 10;
+					} while (Value);
+
+					while (digit_count)
+						Text.push_back(digits[--digit_count]);
+				};
+
+			std::string text = {};
+			append_decimal(text, Line.ExeSize);
+			text.push_back(' ');
+			append_decimal(text, Line.HookRva);
+			text.push_back(' ');
+			append_decimal(text, Line.ChainRva);
+
+			if (Line.HasImageIdentity)
+			{
+				text.push_back(' ');
+				append_decimal(text, Line.TimeDateStamp);
+				text.push_back(' ');
+				append_decimal(text, Line.SizeOfImage);
+				text.push_back(' ');
+				append_decimal(text, Line.CheckSum);
+			}
+
+			text.push_back('\n');
+			return text;
+		}
+
+		// True if both lines would be written as the same text.
+		inline bool IsSameHintLine(
+			IN const HintLine& First,
+			IN const HintLine& Second
+		)
+		{
+			if (First.ExeSize != Second.ExeSize ||
+				First.HookRva != Second.HookRva ||
+				First.ChainRva != Second.ChainRva ||
+				First.HasImageIdentity != Second.HasImageIdentity)
+			{
+				return false;
+			}
+
+			if (!First.HasImageIdentity)
+				return true;
+
+			return First.TimeDateStamp == Second.TimeDateStamp &&
+				First.SizeOfImage == Second.SizeOfImage &&
+				First.CheckSum == Second.CheckSum;
+		}
+
+		// True if Stored was written for the executable Current describes, as far as Stored can tell:
+		// a legacy line only knows the file size. The answer is for the log - it must NOT be used to
+		// throw a hint away, because the page scan validates the hinted page no matter who wrote the line.
+		inline bool DoesHintKeyMatch(
+			IN const HintLine& Stored,
+			IN const HintLine& Current
+		)
+		{
+			if (Stored.ExeSize != Current.ExeSize)
+				return false;
+
+			if (!Stored.HasImageIdentity)
+				return true;
+
+			if (!Current.HasImageIdentity)
+				return false;
+
+			return Stored.TimeDateStamp == Current.TimeDateStamp &&
+				Stored.SizeOfImage == Current.SizeOfImage &&
+				Stored.CheckSum == Current.CheckSum;
+		}
+	}
+}
+
+#endif // YYTK_GENERIC_RUNNERINTERFACESCAN_H_
