+			every_repeat_was_cheap = false;
+	}
+
+	Check(every_repeat_was_cheap,
+		"target: 1000 repeats all take the count-only path (YYERROR_REPEAT, no report number)");
+	Check(ledger.m_Counters.m_ReportAttempts == 1 && ledger.m_Counters.m_ReportsWritten == 1 && ledger.m_RecordCount == 1,
+		"target: those repeats asked for no further report and took no further record");
+	Check(ledger.m_Counters.m_TotalErrors == 1001 && ledger.m_Counters.m_Repeats == 1000 && ledger.m_Records[0].m_Count == 1001,
+		"target: ...but every one of them was counted");
+	Check(ledger.m_Counters.m_TextVariants == 0,
+		"control: byte-identical repeats are not counted as variants");
+
+	Check(Feed(ledger, "alpha failed", 2000, report_number) == YYERROR_REPEAT,
+		"repeat again (setup for the next two checks)");
+
+	uint64_t other_number = 0;
+	Check(Feed(ledger, "beta failed", 2001, other_number) == YYERROR_WRITE_REPORT && other_number == 2,
+		"control: a different message is NOT a repeat - it earns report #2");
+	ledger.FinishReport(other_number, true, 100);
+
+	YYErrorLedger numbered = {};
+	Feed(numbered, "object index '100001' missing", 0, report_number);
+	numbered.FinishReport(report_number, true, 1);
+	Check(Feed(numbered, "object index '100002' missing", 1, report_number) == YYERROR_REPEAT && numbered.m_Counters.m_TextVariants == 1,
+		"a repeat that differs only in its number is a repeat, and is counted as a variant");
