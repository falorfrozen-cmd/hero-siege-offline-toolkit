+static void TestOverflowSlotRemembersItsLastReport()
+{
+	YYErrorLedger ledger = {};
+	uint64_t report_number = 0;
+	FillTable(ledger, 0);
+
+	Feed(ledger, "late arrival one", 0, report_number);
+	ledger.FinishReport(report_number, true, 1);
+
+	// Every check below is made AFTER the interval, so the time limit is not what suppresses.
+	const uint64_t after_interval = YYERROR_OVERFLOW_REPORT_INTERVAL_MS;
+	Check(Feed(ledger, "late arrival one", after_interval, report_number) == YYERROR_OVERFLOW_SUPPRESSED && report_number == 0,
+		"overflow: the message the slot reported last is NOT reported again once the interval has passed");
+	Check(Feed(ledger, "late arrival one", after_interval * 100, report_number) == YYERROR_OVERFLOW_SUPPRESSED,
+		"overflow: ...however long after - one repeating late message costs one report, not one per interval");
+	Check(Feed(ledger, "late arrival two", after_interval, report_number) == YYERROR_WRITE_OVERFLOW_REPORT,
+		"overflow control: at that same time a DIFFERENT late message does earn a report");
+
+	// "Reported" belongs to the message, not to the slot: this report fails...
+	ledger.FinishReport(report_number, false, 1);
+	Check(!ledger.m_Records[YYERROR_OVERFLOW_SLOT].m_Reported,
+		"overflow: the slot does not stay 'reported' on the strength of the PREVIOUS message's report");
+	Check(Feed(ledger, "late arrival two", after_interval * 2, report_number) == YYERROR_WRITE_OVERFLOW_REPORT,
+		"overflow: ...so the message whose report failed is retried after the interval");
+	ledger.FinishReport(report_number, true, 1);
+	Check(Feed(ledger, "late arrival two", after_interval * 3, report_number) == YYERROR_OVERFLOW_SUPPRESSED,
+		"overflow control: once that retry was written, the message is suppressed like any reported one");
+}
