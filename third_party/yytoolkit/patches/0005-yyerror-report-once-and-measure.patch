+static void TestSignature()
+{
+	const YYErrorSignature first = SignatureOf("Unable to find any instance for object index '257087'");
+	const YYErrorSignature other_number = SignatureOf("Unable to find any instance for object index '12'");
+	const YYErrorSignature other_word = SignatureOf("Unable to find any instance for object indey '257087'");
+
+	Check(first.m_Folded == other_number.m_Folded && first.m_FoldedLength == other_number.m_FoldedLength,
+		"signature: messages differing only in a number fold to one signature");
+	Check(first.m_Exact != other_number.m_Exact,
+		"signature: ...while their exact hashes still differ (that is what 'variants' counts)");
+	Check(first.m_Folded != other_word.m_Folded,
+		"signature control: a differing letter keeps the signatures apart");
+	Check(SignatureOf("value 0x1A").m_Folded != SignatureOf("value 0x1B").m_Folded,
+		"signature control: hexadecimal letters are not folded");
+	Check(SignatureOf("a1b").m_Folded != SignatureOf("ab").m_Folded,
+		"signature control: a digit run folds to '#', it does not vanish");
+	Check(SignatureOf("").m_FoldedLength == 0 && SignatureOf("77777").m_FoldedLength == 1,
+		"signature: folded length counts a digit run once");
+}
