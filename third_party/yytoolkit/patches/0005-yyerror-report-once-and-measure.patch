+static void TestLostReportExpires()
+{
+	YYErrorLedger ledger = {};
+	uint64_t lost_number = 0;
+	uint64_t report_number = 0;
+
+	Feed(ledger, "alpha failed", 5000, lost_number);
+	// ...and FinishReport is never called: the builder's thread is gone.
+
+	Check(Feed(ledger, "beta failed", 5000 + YYERROR_REPORT_EXPIRY_MS - 1, report_number) == YYERROR_DEFERRED,
+		"expiry control: just before the expiry time, the in-flight report still defers others");
+	Check(Feed(ledger, "beta failed", 4000, report_number) == YYERROR_DEFERRED,
+		"expiry control: a clock reading older than the in-flight stamp does not read as expired");
+	Check(Feed(ledger, "beta failed", 5000 + YYERROR_REPORT_EXPIRY_MS, report_number) == YYERROR_WRITE_REPORT,
+		"expiry: a report whose builder never came back stops blocking the others");
+	Check(ledger.m_Counters.m_ExpiredReports == 1 && ledger.m_Counters.m_ReportFailures == 1,
+		"expiry: the lost report is counted as expired and as a failure");
+	Check(!ledger.FinishReport(lost_number, true, 7000) && ledger.m_ReportInFlight && ledger.m_InFlightReportNumber == report_number
+		&& ledger.m_Counters.m_StaleFinishes == 1,
+		"stale finish: a late finish for the expired report does not finish the one in flight, and is counted");
+	Check(ledger.m_Counters.m_StaleWritten == 1 && ledger.m_Records[0].m_Reported && !ledger.m_Records[1].m_Reported,
+		"stale finish: it WAS written, so its own record is marked reported - and only its own");
+	Check(ledger.m_Counters.m_ReportsWritten == 0 && ledger.m_Counters.m_ReportFailures == 1,
+		"stale finish: the failure counted at expiry stands; stale_written is what says the report exists");
+	Check(ledger.FinishReport(report_number, true, 1) && !ledger.m_ReportInFlight,
+		"expiry control: the finish that matches the report in flight is accepted");
+	Check(ledger.m_Counters.m_ReportTicksTotal == 7001 && ledger.m_Counters.m_ReportTicksMax == 7000,
+		"stale finish: the slowest report's time is in the totals, not left out of them");
+	Check(Feed(ledger, "alpha failed", 5000 + YYERROR_REPORT_EXPIRY_MS + 1, report_number) == YYERROR_REPEAT,
+		"stale finish: the message whose report turned up late is a plain repeat from then on");
+
+	// Control: a late finish that says NOT written marks nothing.
+	YYErrorLedger unwritten = {};
+	Feed(unwritten, "alpha failed", 0, lost_number);
+	Feed(unwritten, "beta failed", YYERROR_REPORT_EXPIRY_MS, report_number);
+	unwritten.FinishReport(lost_number, false, 1);
+	unwritten.FinishReport(report_number, true, 1);
+	Check(unwritten.m_Counters.m_StaleFinishes == 1 && unwritten.m_Counters.m_StaleWritten == 0 && !unwritten.m_Records[0].m_Reported,
+		"stale finish control: a late finish that was NOT written marks no record reported");
+	Check(Feed(unwritten, "alpha failed", YYERROR_REPORT_EXPIRY_MS + 1, report_number) == YYERROR_WRITE_REPORT,
+		"stale finish control: ...so that message is retried");
+
+	// Control: the record was given a new attempt in the meantime; the old number no longer speaks for it.
+	YYErrorLedger retried = {};
+	uint64_t second_attempt = 0;
+	Feed(retried, "alpha failed", 0, lost_number);
+	Check(Feed(retried, "alpha failed", YYERROR_REPORT_EXPIRY_MS, second_attempt) == YYERROR_WRITE_REPORT && second_attempt == 2,
+		"stale finish (setup): the expired message gets its second attempt");
+	Check(!retried.FinishReport(lost_number, true, 1) && !retried.m_Records[0].m_Reported && retried.m_InFlightReportNumber == second_attempt,
+		"stale finish control: a late finish for attempt 1 does not speak for the record while attempt 2 is in flight");
+}
