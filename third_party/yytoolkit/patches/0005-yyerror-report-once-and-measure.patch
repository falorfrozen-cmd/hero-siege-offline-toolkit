+static void TestOverflowDefersToReportInFlight()
+{
+	// The table is full, and its last message's first report failed - so that message still earns one.
+	YYErrorLedger ledger = {};
+	uint64_t report_number = 0;
+	for (size_t i = 0; i < YYERROR_MAX_DISTINCT; i++)
+	{
+		Feed(ledger, DistinctMessage(i), 0, report_number);
+		ledger.FinishReport(report_number, i + 1 < YYERROR_MAX_DISTINCT, 1);
+	}
+
+	const uint64_t later = YYERROR_OVERFLOW_REPORT_INTERVAL_MS * 10;
+	uint64_t in_flight_number = 0;
+	Check(Feed(ledger, DistinctMessage(YYERROR_MAX_DISTINCT - 1), later, in_flight_number) == YYERROR_WRITE_REPORT,
+		"overflow deferral (setup): a table message's retry is now in flight");
+
+	const size_t in_flight_record = ledger.m_InFlightRecord;
+	Check(Feed(ledger, "late arrival one", later + 1, report_number) == YYERROR_DEFERRED && report_number == 0,
+		"overflow deferral: a new late message, with the interval long past, is deferred while a report is in flight");
+	Check(ledger.m_ReportInFlight && ledger.m_InFlightReportNumber == in_flight_number && ledger.m_InFlightRecord == in_flight_record,
+		"overflow deferral: ...and the report in flight was left exactly as it was");
+	Check(ledger.FinishReport(in_flight_number, true, 1) && ledger.m_Records[in_flight_record].m_Reported,
+		"overflow deferral: the in-flight report's own finish is still accepted, for its own record");
+	Check(Feed(ledger, "late arrival one", later + 2, report_number) == YYERROR_WRITE_OVERFLOW_REPORT,
+		"overflow deferral control: with nothing in flight, the same late message earns its report");
+}
