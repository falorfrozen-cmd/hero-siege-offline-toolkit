+static void TestTableFillsThenOverflowSlot()
+{
+	YYErrorLedger ledger = {};
+	uint64_t report_number = 0;
+
+	bool every_distinct_message_reported = true;
+	for (size_t i = 0; i < YYERROR_MAX_DISTINCT; i++)
+	{
+		if (Feed(ledger, DistinctMessage(i), 1000, report_number) != YYERROR_WRITE_REPORT)
+			every_distinct_message_reported = false;
+
+		ledger.FinishReport(report_number, true, 1);
+	}
+
+	Check(every_distinct_message_reported && ledger.m_RecordCount == YYERROR_MAX_DISTINCT,
+		"table: each of the first YYERROR_MAX_DISTINCT distinct messages earns a report");
+
+	Check(Feed(ledger, "late arrival one", 1000, report_number) == YYERROR_WRITE_OVERFLOW_REPORT && report_number == YYERROR_MAX_DISTINCT + 1,
+		"overflow: with the table full, a brand new message STILL earns a full report");
+	ledger.FinishReport(report_number, true, 1);
+
+	Check(ledger.m_RecordCount == YYERROR_MAX_DISTINCT && ledger.m_Counters.m_Distinct == YYERROR_MAX_DISTINCT,
+		"overflow: the table did not grow");
+	Check(Feed(ledger, "late arrival one", 1001, report_number) == YYERROR_OVERFLOW_SUPPRESSED && report_number == 0,
+		"overflow: the same late message again is only counted");
+	Check(Feed(ledger, "late arrival two", 1002, report_number) == YYERROR_OVERFLOW_SUPPRESSED,
+		"overflow control: a second new message inside the interval is only counted (output stays bounded)");
+	Check(Feed(ledger, "late arrival two", 1000 + YYERROR_OVERFLOW_REPORT_INTERVAL_MS - 1, report_number) == YYERROR_OVERFLOW_SUPPRESSED,
+		"overflow control: ...right up to the last millisecond of the interval");
+	Check(Feed(ledger, "late arrival two", 1000 + YYERROR_OVERFLOW_REPORT_INTERVAL_MS, report_number) == YYERROR_WRITE_OVERFLOW_REPORT,
+		"overflow: once the interval has passed, a new late message earns a report again");
+	ledger.FinishReport(report_number, true, 1);
+
+	Check(Feed(ledger, DistinctMessage(3), 1003, report_number) == YYERROR_REPEAT,
+		"control: a message that is in the table is still a plain repeat when the table is full");
+	Check(ledger.m_Counters.m_OverflowHits == 5 && ledger.m_Counters.m_OverflowSuppressed == 3,
+		"overflow: hits and suppressed hits are counted");
+
+	Check(YYErrorWantsReport(YYERROR_WRITE_REPORT) && YYErrorWantsReport(YYERROR_WRITE_OVERFLOW_REPORT),
+		"dispositions: both kinds of report request take the report path");
+	Check(!YYErrorWantsReport(YYERROR_REPEAT) && !YYErrorWantsReport(YYERROR_DEFERRED)
+		&& !YYErrorWantsReport(YYERROR_OVERFLOW_SUPPRESSED) && !YYErrorWantsReport(YYERROR_BUSY),
+		"dispositions control: everything else takes the count-only path");
+
+	// A log that refuses every write must not turn each overflow error into a report attempt.
+	YYErrorLedger refusing = {};
+	for (size_t i = 0; i < YYERROR_MAX_DISTINCT; i++)
+	{
+		Feed(refusing, DistinctMessage(i), 0, report_number);
+		refusing.FinishReport(report_number, true, 1);
+	}
+
+	Feed(refusing, "late arrival one", 0, report_number);
+	refusing.FinishReport(report_number, false, 1);
+	Check(Feed(refusing, "late arrival one", 1, report_number) == YYERROR_OVERFLOW_SUPPRESSED,
+		"overflow: a FAILED overflow report is not retried before the interval has passed");
+	Check(Feed(refusing, "late arrival one", YYERROR_OVERFLOW_REPORT_INTERVAL_MS, report_number) == YYERROR_WRITE_OVERFLOW_REPORT,
+		"overflow control: ...and is retried after it, because it was never really reported");
+}
