+				// A gate that never opens again means its holder is gone for good. Nothing is
+				// classified or summarised from then on, so say so - once - rather than go quiet.
+				if (InterlockedIncrement(&g_YYErrorSummaryGateMisses) >= YYERROR_SUMMARY_GATE_MISS_LIMIT &&
+					!InterlockedExchange(&g_YYErrorGateStuckLogged, 1))
+				{
+					try
+					{
+						CmWriteLogOutput(
+							"[hs] YYError summary unavailable: the ledger gate stayed shut for %d checks in a row, so its holder is presumed gone."
+							" Errors are still forwarded to the runner, but no longer reported or counted per message. total=%lld busy=%llu",
+							static_cast<int>(YYERROR_SUMMARY_GATE_MISS_LIMIT),
+							static_cast<long long>(g_YYErrorCalls),
+							static_cast<unsigned long long>(g_YYErrorGate.m_Misses.load())
+						);
+					}
+					catch (...)
+					{
+					}
+				}
+
+				return;
+			}
+
+			InterlockedExchange(&g_YYErrorSummaryGateMisses, 0);
+
+			// Somebody else may have written the line while we were getting in.
+			const bool still_due = YYErrorSummaryIsDue(
+				activity,
+				static_cast<uint64_t>(g_YYErrorSummarisedActivity),
+				now_ms,
+				static_cast<uint64_t>(g_YYErrorNextSummaryMs)
+			);
+
+			YYErrorCounters counters = {};
+			uint64_t top_report_number = 0;
+			uint64_t top_count = 0;
+			if (still_due)
+			{
+				counters = g_YYErrorLedger.m_Counters;
+
+				const YYErrorRecord* most_frequent = g_YYErrorLedger.MostFrequent();
+				if (most_frequent)
+				{
+					top_report_number = most_frequent->m_ReportNumber;
+					top_count = most_frequent->m_Count;
+				}
+
+				// Whatever arrives from here on is not in the copy. "activity" was read before the
+				// copy was taken, so it will differ from it again: that is owed the next line.
+				InterlockedExchange64(&g_YYErrorSummarisedActivity, static_cast<LONG64>(activity));
+				InterlockedExchange64(&g_YYErrorNextSummaryMs, static_cast<LONG64>(YYErrorNextSummaryMs(now_ms, YYERROR_SUMMARY_INTERVAL_MS)));
+			}
+
+			g_YYErrorGate.Leave();
+
+			if (!still_due)
+				return;
+
+			try
+			{
+				HkpWriteYYErrorSummary(counters, top_report_number, top_count);
+			}
+			catch (...)
+			{
+				// A summary line is never worth taking the game down for. The counters are
+				// cumulative, so the next line carries everything this one would have.
+			}
+		}
