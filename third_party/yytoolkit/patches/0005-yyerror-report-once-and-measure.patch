+static void TestExpansion()
+{
+	char stack_buffer[64];
+	std::string heap_buffer;
+
+	YYErrorText text = Expand(stack_buffer, sizeof(stack_buffer), heap_buffer, "object index '%d' in %s", 257087, "room");
+	Check(std::string(text.m_Text, text.m_Length) == "object index '257087' in room" && text.m_Text == stack_buffer,
+		"expand: a short message is expanded in the stack buffer (no heap)");
+
+	const std::string long_argument(300, 'x');
+	text = Expand(stack_buffer, sizeof(stack_buffer), heap_buffer, "<%s>", long_argument.c_str());
+	Check(text.m_Length == 302 && text.m_Text != stack_buffer && text.m_Fallback == YYERROR_TEXT_COMPLETE && std::string(text.m_Text) == "<" + long_argument + ">",
+		"expand control: a message too long for the stack buffer is expanded in full on the heap");
+
+	text = Expand(stack_buffer, sizeof(stack_buffer), heap_buffer, nullptr);
+	Check(text.m_Length == 0 && text.m_Text[0] == '\0',
+		"expand: a null format yields an empty, terminated message");
+
+	const std::string exactly_fits(sizeof(stack_buffer) - 1, 'y');
+	text = Expand(stack_buffer, sizeof(stack_buffer), heap_buffer, "%s", exactly_fits.c_str());
+	Check(text.m_Text == stack_buffer && text.m_Length == sizeof(stack_buffer) - 1 && text.m_Fallback == YYERROR_TEXT_COMPLETE,
+		"expand: a message that exactly fills the stack buffer stays there, complete");
+}
+
+static void TestExpansionFallbacks()
+{
+	char small_buffer[8];
+
+	// Too long for the stack, and the heap refuses: the caller must be told the text is cut.
+	TestHeapBuffer refusing_heap;
+	refusing_heap.m_RefuseToGrow = true;
+	YYErrorText text = Expand(small_buffer, sizeof(small_buffer), refusing_heap, "%s", "0123456789");
+	Check(text.m_Fallback == YYERROR_TEXT_TRUNCATED && text.m_Text == small_buffer && text.m_Length == sizeof(small_buffer) - 1
+		&& std::string(text.m_Text) == "0123456",
+		"fallback: heap refused - the text is the terminated, cut stack copy, and is flagged TRUNCATED");
+
+	TestHeapBuffer willing_heap;
+	text = Expand(small_buffer, sizeof(small_buffer), willing_heap, "%s", "0123456789");
+	Check(text.m_Fallback == YYERROR_TEXT_COMPLETE && text.m_Text != small_buffer && std::string(text.m_Text, text.m_Length) == "0123456789",
+		"fallback control: the same message with a willing heap is complete and NOT flagged");
+
+	// A wide string the C locale cannot convert makes vsnprintf give up (MEASURED on the build host's
+	// UCRT: it returns -1). The format's own text is handed on, and the caller must be told that too.
+	char stack_buffer[64];
+	std::string heap_buffer;
+	const wchar_t unconvertible[] = { static_cast<wchar_t>(0x4E2D), 0 };
+	text = Expand(stack_buffer, sizeof(stack_buffer), heap_buffer, "bad %ls here", unconvertible);
+	Check(text.m_Fallback == YYERROR_TEXT_FORMAT_UNEXPANDABLE && std::string(text.m_Text, text.m_Length) == "bad %ls here",
+		"fallback: a format vsnprintf cannot expand is handed on as it stands, and is flagged UNEXPANDABLE");
+
+	text = Expand(stack_buffer, sizeof(stack_buffer), heap_buffer, "bad %ls here", L"ok");
+	Check(text.m_Fallback == YYERROR_TEXT_COMPLETE && std::string(text.m_Text, text.m_Length) == "bad ok here",
+		"fallback control: the same format with a convertible argument expands and is NOT flagged");
+}
+
+static void TestGate()
+{
+	YYErrorGate gate = {};
+	YYErrorLedger ledger = {};
+	uint64_t report_number = 0;
+
+	Check(gate.TryEnter(100),
+		"gate: a free gate is entered");
+	Check(!gate.TryEnter(100) && gate.m_Misses.load() == 1,
+		"gate control: a held gate refuses after a bounded spin instead of waiting, and counts the miss");
+
+	Check(YYErrorClassifyGated(gate, ledger, 100, SignatureOf("alpha failed"), 0, report_number) == YYERROR_BUSY
+		&& report_number == 0 && ledger.m_Counters.m_TotalErrors == 0 && gate.m_Misses.load() == 2,
+		"gate: a caller that cannot get in takes the count-only path and leaves the ledger untouched");
+
+	gate.Leave();
+
+	Check(YYErrorClassifyGated(gate, ledger, 100, SignatureOf("alpha failed"), 0, report_number) == YYERROR_WRITE_REPORT
+		&& ledger.m_Counters.m_TotalErrors == 1,
+		"gate control: once the gate is free, the same call is classified normally");
+	Check(gate.TryEnter(0),
+		"gate: the gated classify left the gate free behind it");
+}
+
+static void TestSummarySchedule()
+{
+	Check(YYErrorSummaryIsDue(5, 0, 0, 0),
+		"summary: the first activity is summarised at once");
+
+	const uint64_t next_allowed = YYErrorNextSummaryMs(1000, YYERROR_SUMMARY_INTERVAL_MS);
+	Check(next_allowed == 1000 + YYERROR_SUMMARY_INTERVAL_MS,
+		"summary: the next line is allowed one interval after the last");
+
+	Check(!YYErrorSummaryIsDue(9, 5, next_allowed - 1, next_allowed),
+		"summary control: counters changed, but the interval has not passed - no line");
+	Check(YYErrorSummaryIsDue(9, 5, next_allowed, next_allowed),
+		"summary: counters changed and the interval has passed - one line");
+	Check(!YYErrorSummaryIsDue(9, 9, next_allowed + 86400000, next_allowed),
+		"summary control: nothing changed since the last line - no line, however long ago it was");
+	Check(YYErrorNextSummaryMs(UINT64_MAX - 5, YYERROR_SUMMARY_INTERVAL_MS) == UINT64_MAX,
+		"summary: the schedule saturates instead of wrapping");
+
+	// The ledger could not be entered when the line was due: look again after the retry delay, not every frame.
+	const uint64_t retry_at = YYErrorNextSummaryMs(next_allowed, YYERROR_SUMMARY_RETRY_MS);
+	Check(!YYErrorSummaryIsDue(9, 5, retry_at - 1, retry_at),
+		"summary control: after a refused attempt, the frames before the retry time do not try again");
+	Check(YYErrorSummaryIsDue(9, 5, retry_at, retry_at) && retry_at - next_allowed < YYERROR_SUMMARY_INTERVAL_MS,
+		"summary: the retry comes after the retry delay, well inside one interval");
+}
+
+int main()
+{
+	static_assert(std::is_trivially_destructible_v<YYErrorLedger>, "the ledger must have no destructor to run at process exit");
+	static_assert(std::is_trivially_destructible_v<YYErrorGate>, "the gate must have no destructor to run at process exit");
+
+	TestSignature();
+	TestFirstSightingAndRepeats();
+	TestDeferred();
+	TestFailedReportIsRetriedOnce();
+	TestTableFillsThenOverflowSlot();
+	TestOverflowSlotRemembersItsLastReport();
+	TestOverflowDefersToReportInFlight();
+	TestMostFrequent();
+	TestLostReportExpires();
+	TestForwarding();
+	TestExpansion();
+	TestExpansionFallbacks();
+	TestGate();
+	TestSummarySchedule();
+
+	printf("\n%d check(s), %d failure(s)\n", g_Checks, g_Failures);
+	return g_Failures ? 1 : 0;
+}
