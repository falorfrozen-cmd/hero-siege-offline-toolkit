+	bool CmLogIsWritable()
+	{
+		// A stream that never opened (read-only game directory) or that has latched an error (full
+		// disk) takes nothing more. HkYYError asks BEFORE it builds a report, so that a log which
+		// cannot take the report does not cost the game thread a stacktrace and a symbol pass for it.
+		return g_LogFile.is_open() && g_LogFile.good();
+	}
+
+	bool CmWriteLogOutputRaw(
+		IN std::string_view Text
+	)
+	{
+		// Text goes out verbatim. CmWriteLogOutput treats what it is given as a printf format and
+		// re-expands it into a 4096-byte buffer: a '%' in the text is undefined behaviour there, and
+		// anything of 4096 bytes or more is replaced by "<string too long to print>". A YYError
+		// report carries the runner's own message, and nothing keeps it shorter than that.
+		//
+		// INHERITED: like CmWriteLogOutput, this writes to g_LogFile with no synchronisation.
+		// Upstream's logging is not thread-safe, and no lock is added here on purpose: a lock in
+		// the logger is one more thing a thread can be holding when ExitProcess stops it.
+		if (!CmLogIsWritable())
+			return false;
+
+		g_LogFile.write(Text.data(), static_cast<std::streamsize>(Text.size()));
+		g_LogFile.put('\n');
+		g_LogFile.flush();
+
+		// Callers use this to decide whether the text really reached the log.
+		return g_LogFile.good();
+	}
+
 	void CmpCloseLogFile()
 	{
 		g_LogFile.close();
diff --git a/YYToolkit/source/YYTK/Module Internals/GameMaker/Generic/GameSymbolWalk.hpp b/YYToolkit/source/YYTK/Module Internals/GameMaker/Generic/GameSymbolWalk.hpp
new file mode 100644
index 0000000..a65757a
--- /dev/null
+++ b/YYToolkit/source/YYTK/Module Internals/GameMaker/Generic/GameSymbolWalk.hpp	
@@ -0,0 +1,242 @@
+#ifndef YYTK_GAME_SYMBOL_WALK_H_
+#define YYTK_GAME_SYMBOL_WALK_H_
+
+// Decisions the game symbol table build makes about what it reads (Hero Siege patch series).
+//
+// The runner's functions array carries no length we can read, so the builtin walk always looks
+// at one slot past the last real entry at the least. Upstream builds a std::string from whatever
+// name pointer that slot holds before anything has looked at it. The checks in this header are
+// what stands between the walk and that pointer, and they are also what words the log lines,
+// so that a walk which ended early or a table that was refused says which of its causes it was.
+//
+// Plain logic: addresses come in as numbers, nothing here knows a YYToolkit or Aurie type.
+// YYToolkit/hs-tests/game_symbol_walk_test.cpp exercises it on the build host, without a game.
+//
+// Only standard headers are included, on purpose - keep it that way, or the host test stops compiling.
+
+#include <cstddef>
+#include <cstdint>
+#include <cstring>
+
+#ifndef IN
+#define IN
+#endif
+#ifndef OUT
+#define OUT
+#endif
+
+namespace YYTK
+{
+	// Longer than any builtin function name. ASSUMED: runners that embed the name in the slot
+	// give it 64 bytes, so a referenced name four times that long is taken to be no name at all.
+	constexpr size_t GAME_SYMBOL_MAX_NAME_LENGTH = 256;
+
+	// ImageEnd is one past the last byte (base + SizeOfImage).
+	inline bool GmSymbolAddressInsideImage(
+		IN uintptr_t Address,
+		IN uintptr_t ImageBase,
+		IN uintptr_t ImageEnd
+	)
+	{
+		return Address >= ImageBase && Address < ImageEnd;
+	}
+
+	enum GameSymbolSlotVerdict : int32_t
+	{
+		// The name may be read (NameLength says how much of it) and looked up in the runner.
+		GAME_SYMBOL_SLOT_READABLE = 0,
+		// A null routine: how the walk normally ends, as in upstream. The name is not looked at.
+		GAME_SYMBOL_SLOT_NULL_ROUTINE,
+		// The name pointer does not point into the game image: this is not an entry of the array.
+		GAME_SYMBOL_SLOT_NAME_OUTSIDE_IMAGE,
+		// It does, but no terminator follows within the limit or before the image ends.
+		GAME_SYMBOL_SLOT_NAME_UNTERMINATED
+	};
+
+	// Judges one slot of a functions array whose entries REFERENCE their name (RFunctionStringRef),
+	// from the two pointers stored in the slot itself. Name is dereferenced only once it is known to
+	// point into the image, and never past the image's end.
+	//
+	// The test is structural: YkDetermineFunctionEntrySize already takes "the first name lies in the
+	// image's .rdata" as its proof that names are references, and this asks the same of every slot.
+	// ASSUMED, not measured: every real builtin name of Hero Siege's runner lies in the game image.
+	// If one does not, the walk stops there and the log line says at which slot.
+	//
+	// The ROUTINE is deliberately not part of this verdict: the walk never reads through it, so a
+	// routine outside the image is no danger - see GmSymbolRoutineBelongsInTable.
+	inline GameSymbolSlotVerdict GmSymbolJudgeReferentialSlot(
+		IN const char* Name,
+		IN uintptr_t Routine,
+		IN uintptr_t ImageBase,
+		IN uintptr_t ImageEnd,
+		IN size_t MaximumNameLength,
+		OUT size_t& NameLength
+	)
+	{
+		NameLength = 0;
+
+		if (!Routine)
+			return GAME_SYMBOL_SLOT_NULL_ROUTINE;
+
+		const uintptr_t name_address = reinterpret_cast<uintptr_t>(Name);
+		if (!GmSymbolAddressInsideImage(name_address, ImageBase, ImageEnd))
+			return GAME_SYMBOL_SLOT_NAME_OUTSIDE_IMAGE;
+
+		size_t readable = static_cast<size_t>(ImageEnd - name_address);
+		if (readable > MaximumNameLength)
+			readable = MaximumNameLength;
+
+		const void* terminator = memchr(Name, '\0', readable);
+		if (!terminator)
+			return GAME_SYMBOL_SLOT_NAME_UNTERMINATED;
+
+		NameLength = static_cast<size_t>(static_cast<const char*>(terminator) - Name);
+		return GAME_SYMBOL_SLOT_READABLE;
+	}
+
+	// Whether a routine is worth a place in the table. GmResolveGameSymbolFromAddress only ever
+	// resolves addresses inside the game image, so a key outside it can name nothing; it is left out
+	// and counted. The walk goes on: a slot whose NAME the runner knows is a real entry, whoever
+	// its routine belongs to (a mod may have pointed it at its own code).
+	inline bool GmSymbolRoutineBelongsInTable(
+		IN uintptr_t Routine,
+		IN uintptr_t ImageBase,
+		IN uintptr_t ImageEnd
+	)
+	{
+		return Routine && GmSymbolAddressInsideImage(Routine, ImageBase, ImageEnd);
+	}
+
+	// How the builtin walk came to an end.
+	enum GameSymbolWalkEnd : int32_t
+	{
+		// No functions array is known, so no slot was read.
+		GAME_SYMBOL_WALK_SKIPPED = 0,
+		// The two ends upstream relies on.
+		GAME_SYMBOL_WALK_NULL_ROUTINE,
+		GAME_SYMBOL_WALK_UNKNOWN_NAME,
+		// The ends this series adds: the slot did not look like an entry, and its name was NOT read.
+		GAME_SYMBOL_WALK_NAME_OUTSIDE_IMAGE,
+		GAME_SYMBOL_WALK_NAME_UNTERMINATED,
+		// The array never ended by itself.
+		GAME_SYMBOL_WALK_SLOT_CAP
+	};
+
+	inline GameSymbolWalkEnd GmSymbolWalkEndFromVerdict(
+		IN GameSymbolSlotVerdict Verdict
+	)
+	{
+		switch (Verdict)
+		{
+		case GAME_SYMBOL_SLOT_NULL_ROUTINE:
+			return GAME_SYMBOL_WALK_NULL_ROUTINE;
+		case GAME_SYMBOL_SLOT_NAME_OUTSIDE_IMAGE:
+			return GAME_SYMBOL_WALK_NAME_OUTSIDE_IMAGE;
+		case GAME_SYMBOL_SLOT_NAME_UNTERMINATED:
+			return GAME_SYMBOL_WALK_NAME_UNTERMINATED;
+		default:
+			// A readable slot does not end the walk; what the runner says about its name may.
+			return GAME_SYMBOL_WALK_UNKNOWN_NAME;
+		}
+	}
+
+	// True for the ends that mean "this slot was refused", as opposed to "the array was over".
+	inline bool GmSymbolWalkWasStopped(
+		IN GameSymbolWalkEnd End
+	)
+	{
+		return End == GAME_SYMBOL_WALK_NAME_OUTSIDE_IMAGE || End == GAME_SYMBOL_WALK_NAME_UNTERMINATED;
+	}
+
+	inline const char* GmSymbolWalkEndText(
+		IN GameSymbolWalkEnd End
+	)
+	{
+		switch (End)
+		{
+		case GAME_SYMBOL_WALK_SKIPPED:
+			return "skipped: no functions array is known";
+		case GAME_SYMBOL_WALK_NULL_ROUTINE:
+			return "a null routine";
+		case GAME_SYMBOL_WALK_UNKNOWN_NAME:
+			return "a name the runner does not know";
+		case GAME_SYMBOL_WALK_NAME_OUTSIDE_IMAGE:
+			return "name pointer outside the game image";
+		case GAME_SYMBOL_WALK_NAME_UNTERMINATED:
+			return "name not terminated inside the game image";
+		case GAME_SYMBOL_WALK_SLOT_CAP:
+			return "the slot cap - the array never ended by itself";
+		}
+
+		return "unknown";
+	}
+
+	// A walk that read slots and kept nothing is what the WRONG functions array looks like: its
+	// first entry has a null routine, or a name the runner does not know. Reading "1 slot walked"
+	// as healthy is exactly the mistake the log line has to prevent.
+	inline bool GmSymbolBuiltinWalkLooksWrong(
+		IN GameSymbolWalkEnd End,
+		IN int SlotsWalked,
+		IN int BuiltinsAccepted
+	)
+	{
+		if (End == GAME_SYMBOL_WALK_SKIPPED)
+			return false;
+
+		return SlotsWalked > 0 && BuiltinsAccepted == 0;
+	}
+
+	// Why a table without a single usable script is refused. The three causes call for three
+	// different investigations, so they do not share a sentence.
+	enum GameSymbolScriptRefusal : int32_t
+	{
+		// There is at least one usable script: no refusal.
+		GAME_SYMBOL_SCRIPTS_USABLE = 0,
+		// YYToolkit never located Script_Data: no slot could even be asked for.
+		GAME_SYMBOL_SCRIPTS_NO_LOOKUP_ROUTINE,
+		// Script_Data is known and returned nothing at all - what a build made too early would look like.
+		GAME_SYMBOL_SCRIPTS_NONE_RETURNED,
+		// Scripts came back, and every one had a null m_Functions or m_Name - what a CScript layout
+		// that does not match this runner would look like.
+		GAME_SYMBOL_SCRIPTS_ALL_REJECTED
+	};
+
+	inline GameSymbolScriptRefusal GmSymbolJudgeScriptWalk(
+		IN bool LookupRoutineKnown,
+		IN int ScriptsReturned,
+		IN int ScriptsUsable
+	)
+	{
+		if (ScriptsUsable > 0)
+			return GAME_SYMBOL_SCRIPTS_USABLE;
+
+		if (!LookupRoutineKnown)
+			return GAME_SYMBOL_SCRIPTS_NO_LOOKUP_ROUTINE;
+
+		if (ScriptsReturned <= 0)
+			return GAME_SYMBOL_SCRIPTS_NONE_RETURNED;
+
+		return GAME_SYMBOL_SCRIPTS_ALL_REJECTED;
+	}
+
+	inline const char* GmSymbolScriptRefusalText(
+		IN GameSymbolScriptRefusal Refusal
+	)
+	{
+		switch (Refusal)
+		{
+		case GAME_SYMBOL_SCRIPTS_USABLE:
+			return "scripts are usable";
+		case GAME_SYMBOL_SCRIPTS_NO_LOOKUP_ROUTINE:
+			return "m_GetScriptData is unknown - YYToolkit never located the runner's Script_Data, so no script could be asked for";
+		case GAME_SYMBOL_SCRIPTS_NONE_RETURNED:
+			return "no slot returned a script - Script_Data is known but gave nothing (a build made before the scripts exist would look like this)";
+		case GAME_SYMBOL_SCRIPTS_ALL_REJECTED:
+			return "scripts were returned but 0 were usable - every one had a null m_Functions or m_Name (a CScript layout that does not match this runner would look like this)";
+		}
+
+		return "unknown";
+	}
+}
+
+#endif // YYTK_GAME_SYMBOL_WALK_H_
