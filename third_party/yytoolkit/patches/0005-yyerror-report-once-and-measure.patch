+		static void HkpWriteYYErrorSummary(
+			IN const YYErrorCounters& Counters,
+			IN uint64_t TopReportNumber,
+			IN uint64_t TopCount
+		)
+		{
+			GameSymbolTableInfo symbol_table = {};
+			GmQueryGameSymbolTableInfo(symbol_table);
+
+			// Cumulative since the game started.
+			// total = every HkYYError call; total - busy - reentered of them went through the ledger.
+			// report_failures, expired, stale, busy, dropped, truncated and unexpandable should read 0
+			// in a healthy session; they are here so that a ledger which has quietly stopped reporting,
+			// or a text that is not the runner's, shows up in the log.
+			// stale = finishes of reports that had already expired (each was counted under expired and
+			// report_failures when it expired); stale_written = how many of those are in the log after
+			// all. Their time IS in report_ms_total/report_ms_max: a report that slow is the finding.
+			// returned/runner_ms only move if the runner's YYError returns to us instead of unwinding
+			// through us - which of the two it does is NOT known, and this is how we find out.
+			// dropped is the other reason returned can stand still: Aurie gave no trampoline, so the
+			// runner's YYError was never called. Read returned= together with dropped=.
+			CmWriteLogOutput(
+				"[hs] YYError summary: total=%lld distinct=%llu/%zu reports=%llu report_failures=%llu overflow_hits=%llu"
+				" report_ms_total=%.3f report_ms_max=%.3f symtab_build_ms=%.3f (%s, %d attempt(s))"
+				" | repeats=%llu variants=%llu deferred=%llu overflow_suppressed=%llu expired=%llu stale=%llu stale_written=%llu"
+				" busy=%llu reentered=%lld truncated=%lld unexpandable=%lld"
+				" count_only_ms=%.3f returned=%lld dropped=%lld runner_ms=%.3f top=report#%llu x%llu",
+				static_cast<long long>(g_YYErrorCalls),
+				Counters.m_Distinct,
+				YYERROR_MAX_DISTINCT,
+				Counters.m_ReportsWritten,
+				Counters.m_ReportFailures,
+				Counters.m_OverflowHits,
+				HkpTicksToMilliseconds(Counters.m_ReportTicksTotal),
+				HkpTicksToMilliseconds(Counters.m_ReportTicksMax),
+				HkpTicksToMilliseconds(symbol_table.m_BuildTicks),
+				symbol_table.m_Published ? "built" : "not built",
+				symbol_table.m_BuildAttempts,
+				Counters.m_Repeats,
+				Counters.m_TextVariants,
+				Counters.m_Deferred,
+				Counters.m_OverflowSuppressed,
+				Counters.m_ExpiredReports,
+				Counters.m_StaleFinishes,
+				Counters.m_StaleWritten,
+				static_cast<unsigned long long>(g_YYErrorGate.m_Misses.load()),
+				static_cast<long long>(g_YYErrorReentered),
+				static_cast<long long>(g_YYErrorTextTruncated),
+				static_cast<long long>(g_YYErrorTextUnexpandable),
+				HkpTicksToMilliseconds(g_YYErrorCountOnlyTicks),
+				static_cast<long long>(g_YYErrorReturned),
+				static_cast<long long>(g_YYErrorDropped),
+				HkpTicksToMilliseconds(g_YYErrorRunnerTicks),
+				TopReportNumber,
+				TopCount
+			);
+		}
+
+		// The text about to be keyed, reported and forwarded is not the runner's full text. Counted
+		// every time, said once per kind. The text itself is NOT put in the line: CmWriteLogOutput
+		// re-expands what it is given into a fixed 4096-byte buffer.
+		static void HkpNoteYYErrorTextFallback(
+			IN YYErrorTextFallback Fallback
+		)
+		{
+			if (Fallback == YYERROR_TEXT_COMPLETE)
+				return;
+
+			const bool truncated = (Fallback == YYERROR_TEXT_TRUNCATED);
+			InterlockedIncrement64(truncated ? &g_YYErrorTextTruncated : &g_YYErrorTextUnexpandable);
+
+			if (InterlockedExchange(truncated ? &g_YYErrorTextTruncatedLogged : &g_YYErrorTextUnexpandableLogged, 1))
+				return;
+
+			try
+			{
+				if (truncated)
+				{
+					CmWriteLogOutput(
+						"[hs] YYError message truncated: the runner's text is longer than %zu bytes and the heap refused a copy of it,"
+						" so the ledger, the report and the runner itself get its first %zu bytes. Said once; truncated= in the summary counts them.",
+						YYERROR_STACK_BUFFER_SIZE - 1,
+						YYERROR_STACK_BUFFER_SIZE - 1
+					);
+				}
+				else
+				{
+					CmWriteLogOutput(
+						"[hs] YYError message not expanded: vsnprintf refused the runner's format, so the format itself, specifiers and all,"
+						" is what the ledger, the report and the runner get. Said once; unexpandable= in the summary counts them."
+					);
+				}
+			}
+			catch (...)
+			{
+			}
+		}
+
+		// Called once per frame from HkPresent. While nothing has moved since the last summary
+		// line, it costs two loads and a compare, and writes nothing.
+		static void HkpYYErrorSummaryTick()
+		{
+			const uint64_t activity = static_cast<uint64_t>(g_YYErrorActivity);
+			if (activity == static_cast<uint64_t>(g_YYErrorSummarisedActivity))
+				return;
+
+			const uint64_t now_ms = GetTickCount64();
+			if (!YYErrorSummaryIsDue(activity, static_cast<uint64_t>(g_YYErrorSummarisedActivity), now_ms, static_cast<uint64_t>(g_YYErrorNextSummaryMs)))
+				return;
+
+			// Copy inside the gate; format and write outside it.
+			if (!g_YYErrorGate.TryEnter(YYERROR_GATE_SPIN_LIMIT))
+			{
+				// Look again in a second, not on the next frame: spinning every frame for a gate that
+				// stays shut would be a per-frame cost of our own making.
+				InterlockedExchange64(&g_YYErrorNextSummaryMs, static_cast<LONG64>(YYErrorNextSummaryMs(now_ms, YYERROR_SUMMARY_RETRY_MS)));
