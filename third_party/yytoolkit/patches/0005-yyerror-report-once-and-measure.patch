+static void TestForwarding()
+{
+	const char* with_percent = "100% of %s went wrong at %d%%, see %n";
+	const char* plain = "Unable to find any instance for object index '257087'";
+
+	g_StubCalls = 0;
+	Check(YYErrorForward(StubTrampoline, with_percent) && g_StubCalls == 1,
+		"forward: the original routine is called exactly once");
+	Check(g_StubExpansion == with_percent,
+		"target: a message containing '%' reaches the runner byte-identical");
+	Check(g_StubFormat == "%s",
+		"forward: the text travels as an argument of \"%s\", never in the format slot");
+
+	YYErrorForward(StubTrampoline, plain);
+	Check(g_StubExpansion == plain,
+		"forward: a message without '%' reaches the runner byte-identical too");
+
+	// What upstream does: the text goes in the format slot. "%%" is the one '%' sequence that is
+	// safe to run through printf with no arguments, and it is enough to show the text changes.
+	StubTrampoline("progress 100%% done");
+	Check(g_StubExpansion != "progress 100%% done",
+		"control: the same stub DOES see a difference when text is passed in the format slot");
+
+	g_StubCalls = 0;
+	Check(!YYErrorForward(nullptr, plain) && g_StubCalls == 0,
+		"forward control: with no routine, nothing is called and the caller is told");
+}
