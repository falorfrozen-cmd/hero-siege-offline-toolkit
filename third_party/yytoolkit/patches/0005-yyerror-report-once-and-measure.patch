+				CmWriteLogOutput(
+					"[hs] YYError report cost: report #%llu (%zu bytes, %s) | total %.3f ms | stacktrace capture %.3f ms"
+					" | game symbols %.3f ms over %zu game frame(s) | other symbols %.3f ms over %zu other frame(s)"
