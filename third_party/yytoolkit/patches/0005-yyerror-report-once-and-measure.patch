diff --git a/YYToolkit/hs-tests/game_symbol_walk_test.cpp b/YYToolkit/hs-tests/game_symbol_walk_test.cpp
new file mode 100644
index 0000000..e3cae08
--- /dev/null
+++ b/YYToolkit/hs-tests/game_symbol_walk_test.cpp
@@ -0,0 +1,204 @@
+// Host test for the game symbol table's slot checks (Hero Siege patch series). No game, no YYToolkit, no framework.
+//
+// Build and run, from a Visual Studio x64 developer prompt:
+//   cl /nologo /std:c++latest /EHsc /W4 game_symbol_walk_test.cpp && game_symbol_walk_test.exe
+//
+// One line per check. Exit code 0 only if every check passed.
+// Every predicate is checked both ways: a case where it must hold, and a control where it must not.
+//
+// The "game image" here is a byte buffer, and a "slot" is two values handed to the judge. A pointer
+// that must not be read is given a value that cannot be read (0x10): if the judge touched it, this
+// test would not fail a check, it would crash - which fails the run just as well.
+
+#include "../source/YYTK/Module Internals/GameMaker/Generic/GameSymbolWalk.hpp"
+
+#include <cstdio>
+#include <cstring>
+
+using namespace YYTK;
+
+static int g_Checks = 0;
+static int g_Failures = 0;
+
+static void Check(
+	bool Condition,
+	const char* Name
+)
+{
+	g_Checks++;
+	if (!Condition)
+		g_Failures++;
+
+	printf("%s  %s\n", Condition ? "PASS" : "FAIL", Name);
+}
+
+// ===== A stand-in for the game image =====
+
+constexpr size_t FAKE_IMAGE_SIZE = 64;
+
+// The image is the first FAKE_IMAGE_SIZE bytes. What follows it is memory that is NOT the image,
+// and it starts with a terminator on purpose: a judge that read past the image's end would find it.
+static char g_Memory[FAKE_IMAGE_SIZE * 2];
+
+static uintptr_t ImageBase()
+{
+	return reinterpret_cast<uintptr_t>(&g_Memory[0]);
+}
+
+static uintptr_t ImageEnd()
+{
+	return ImageBase() + FAKE_IMAGE_SIZE;
+}
+
+static void BuildFakeImage()
+{
+	memset(g_Memory, 'x', sizeof(g_Memory));
+	g_Memory[FAKE_IMAGE_SIZE] = '\0';
+
+	// "abs" at offset 4, a ten-character name at offset 16. The last four bytes of the image stay 'x':
+	// a name there runs into the end of the image without a terminator.
+	memcpy(&g_Memory[4], "abs", 4);
+	memcpy(&g_Memory[16], "draw_self_", 11);
+}
+
+// ===== Tests =====
+
+static void TestAddressInsideImage()
+{
+	Check(GmSymbolAddressInsideImage(ImageBase(), ImageBase(), ImageEnd()),
+		"inside: the image's first byte is inside it");
+	Check(GmSymbolAddressInsideImage(ImageEnd() - 1, ImageBase(), ImageEnd()),
+		"inside: the image's last byte is inside it");
+	Check(!GmSymbolAddressInsideImage(ImageEnd(), ImageBase(), ImageEnd()),
+		"inside control: one past the last byte is NOT inside it");
+	Check(!GmSymbolAddressInsideImage(ImageBase() - 1, ImageBase(), ImageEnd()),
+		"inside control: one before the first byte is NOT inside it");
+	Check(!GmSymbolAddressInsideImage(0, ImageBase(), ImageEnd()),
+		"inside control: a null pointer is NOT inside it");
+}
+
+static void TestReferentialSlot()
+{
+	const uintptr_t routine_inside = ImageBase() + 40;
+	const char* const unreadable = reinterpret_cast<const char*>(static_cast<uintptr_t>(0x10));
+	size_t name_length = 99;
+
+	Check(GmSymbolJudgeReferentialSlot(&g_Memory[4], routine_inside, ImageBase(), ImageEnd(), GAME_SYMBOL_MAX_NAME_LENGTH, name_length) == GAME_SYMBOL_SLOT_READABLE
+		&& name_length == 3 && memcmp(&g_Memory[4], "abs", name_length) == 0,
+		"baseline: a real entry (name in the image, terminated) is readable, and its length is reported");
+
+	name_length = 99;
+	Check(GmSymbolJudgeReferentialSlot(unreadable, 0, ImageBase(), ImageEnd(), GAME_SYMBOL_MAX_NAME_LENGTH, name_length) == GAME_SYMBOL_SLOT_NULL_ROUTINE
+		&& name_length == 0,
+		"end of array: a null routine ends the walk as upstream does, and the name pointer is never touched");
+
+	Check(GmSymbolJudgeReferentialSlot(unreadable, routine_inside, ImageBase(), ImageEnd(), GAME_SYMBOL_MAX_NAME_LENGTH, name_length) == GAME_SYMBOL_SLOT_NAME_OUTSIDE_IMAGE,
+		"target: a slot of leftovers (non-null routine, wild name pointer) is refused WITHOUT reading the name");
+	Check(GmSymbolJudgeReferentialSlot(nullptr, routine_inside, ImageBase(), ImageEnd(), GAME_SYMBOL_MAX_NAME_LENGTH, name_length) == GAME_SYMBOL_SLOT_NAME_OUTSIDE_IMAGE,
+		"target: a null name with a non-null routine is refused too");
+	Check(GmSymbolJudgeReferentialSlot(&g_Memory[FAKE_IMAGE_SIZE], routine_inside, ImageBase(), ImageEnd(), GAME_SYMBOL_MAX_NAME_LENGTH, name_length) == GAME_SYMBOL_SLOT_NAME_OUTSIDE_IMAGE,
+		"target: a name pointer that is exactly the image's end is outside it");
+
+	static const char name_elsewhere[] = "abs";
+	Check(GmSymbolJudgeReferentialSlot(name_elsewhere, routine_inside, ImageBase(), ImageEnd(), GAME_SYMBOL_MAX_NAME_LENGTH, name_length) == GAME_SYMBOL_SLOT_NAME_OUTSIDE_IMAGE,
+		"control: the very same name text, stored outside the image, is refused - it is the address that is judged");
+
+	name_length = 99;
+	Check(GmSymbolJudgeReferentialSlot(&g_Memory[FAKE_IMAGE_SIZE - 4], routine_inside, ImageBase(), ImageEnd(), GAME_SYMBOL_MAX_NAME_LENGTH, name_length) == GAME_SYMBOL_SLOT_NAME_UNTERMINATED
+		&& name_length == 0,
+		"bound: a name that runs into the image's end is unterminated - the terminator just past the end was not read");
+
+	Check(GmSymbolJudgeReferentialSlot(&g_Memory[16], routine_inside, ImageBase(), ImageEnd(), 5, name_length) == GAME_SYMBOL_SLOT_NAME_UNTERMINATED,
+		"bound: a ten-character name is unterminated under a limit of 5");
+	Check(GmSymbolJudgeReferentialSlot(&g_Memory[16], routine_inside, ImageBase(), ImageEnd(), 11, name_length) == GAME_SYMBOL_SLOT_READABLE && name_length == 10,
+		"bound control: the same name is readable once the limit covers its terminator");
+
+	// The routine is not part of the verdict: a mod may have pointed a real entry at its own code.
+	Check(GmSymbolJudgeReferentialSlot(&g_Memory[4], 0x10, ImageBase(), ImageEnd(), GAME_SYMBOL_MAX_NAME_LENGTH, name_length) == GAME_SYMBOL_SLOT_READABLE,
+		"a routine outside the image does not make a slot unreadable: the walk never reads through it");
+}
+
+static void TestRoutineBelongsInTable()
+{
+	Check(GmSymbolRoutineBelongsInTable(ImageBase() + 40, ImageBase(), ImageEnd()),
+		"table: a routine inside the image gets a place in the table");
+	Check(!GmSymbolRoutineBelongsInTable(ImageEnd() + 40, ImageBase(), ImageEnd()),
+		"table control: a routine outside the image does not - the table could never resolve to it");
+	Check(!GmSymbolRoutineBelongsInTable(0, ImageBase(), ImageEnd()),
+		"table control: a null routine does not");
+}
+
+static void TestWalkEnd()
+{
+	Check(GmSymbolWalkEndFromVerdict(GAME_SYMBOL_SLOT_NULL_ROUTINE) == GAME_SYMBOL_WALK_NULL_ROUTINE
+		&& GmSymbolWalkEndFromVerdict(GAME_SYMBOL_SLOT_NAME_OUTSIDE_IMAGE) == GAME_SYMBOL_WALK_NAME_OUTSIDE_IMAGE
+		&& GmSymbolWalkEndFromVerdict(GAME_SYMBOL_SLOT_NAME_UNTERMINATED) == GAME_SYMBOL_WALK_NAME_UNTERMINATED,
+		"walk end: each refusing verdict maps to its own end");
+
+	Check(GmSymbolWalkWasStopped(GAME_SYMBOL_WALK_NAME_OUTSIDE_IMAGE) && GmSymbolWalkWasStopped(GAME_SYMBOL_WALK_NAME_UNTERMINATED),
+		"stopped: a refused slot is reported as a stopped walk (it gets its own log line)");
+	Check(!GmSymbolWalkWasStopped(GAME_SYMBOL_WALK_NULL_ROUTINE) && !GmSymbolWalkWasStopped(GAME_SYMBOL_WALK_UNKNOWN_NAME)
+		&& !GmSymbolWalkWasStopped(GAME_SYMBOL_WALK_SLOT_CAP) && !GmSymbolWalkWasStopped(GAME_SYMBOL_WALK_SKIPPED),
+		"stopped control: the ends upstream relies on, the cap and a skipped walk are not");
+
+	Check(strcmp(GmSymbolWalkEndText(GAME_SYMBOL_WALK_NAME_OUTSIDE_IMAGE), GmSymbolWalkEndText(GAME_SYMBOL_WALK_NAME_UNTERMINATED)) != 0
+		&& strcmp(GmSymbolWalkEndText(GAME_SYMBOL_WALK_NULL_ROUTINE), GmSymbolWalkEndText(GAME_SYMBOL_WALK_UNKNOWN_NAME)) != 0
+		&& strcmp(GmSymbolWalkEndText(GAME_SYMBOL_WALK_SKIPPED), GmSymbolWalkEndText(GAME_SYMBOL_WALK_SLOT_CAP)) != 0,
+		"walk end: different ends are worded differently in the log");
+	Check(strstr(GmSymbolWalkEndText(GAME_SYMBOL_WALK_NAME_OUTSIDE_IMAGE), "outside the game image") != nullptr,
+		"walk end: the refusal says the pointer was outside the game image");
+}
+
+static void TestBuiltinWalkLooksWrong()
+{
+	Check(GmSymbolBuiltinWalkLooksWrong(GAME_SYMBOL_WALK_NULL_ROUTINE, 1, 0),
+		"wrong array: one slot walked, null routine, nothing accepted - flagged");
+	Check(GmSymbolBuiltinWalkLooksWrong(GAME_SYMBOL_WALK_UNKNOWN_NAME, 1, 0),
+		"wrong array: one slot walked, name unknown to the runner, nothing accepted - flagged");
+	Check(GmSymbolBuiltinWalkLooksWrong(GAME_SYMBOL_WALK_NAME_OUTSIDE_IMAGE, 1, 0),
+		"wrong array: first slot refused, nothing accepted - flagged");
+	Check(!GmSymbolBuiltinWalkLooksWrong(GAME_SYMBOL_WALK_NULL_ROUTINE, 1500, 1499),
+		"wrong array control: a walk that accepted symbols is not flagged");
+	Check(!GmSymbolBuiltinWalkLooksWrong(GAME_SYMBOL_WALK_SKIPPED, 0, 0),
+		"wrong array control: a walk that was skipped is not flagged as wrong - it says 'skipped' instead");
+}
+
+static void TestScriptRefusal()
+{
+	Check(GmSymbolJudgeScriptWalk(true, 5000, 4990) == GAME_SYMBOL_SCRIPTS_USABLE,
+		"scripts baseline: usable scripts mean no refusal");
+	Check(GmSymbolJudgeScriptWalk(true, 1, 1) == GAME_SYMBOL_SCRIPTS_USABLE,
+		"scripts baseline: one usable script is enough");
+
+	Check(GmSymbolJudgeScriptWalk(false, 0, 0) == GAME_SYMBOL_SCRIPTS_NO_LOOKUP_ROUTINE,
+		"refusal: Script_Data never located is its own reason");
+	Check(GmSymbolJudgeScriptWalk(true, 0, 0) == GAME_SYMBOL_SCRIPTS_NONE_RETURNED,
+		"refusal: Script_Data known but nothing returned is its own reason");
+	Check(GmSymbolJudgeScriptWalk(true, 5000, 0) == GAME_SYMBOL_SCRIPTS_ALL_REJECTED,
+		"refusal: thousands returned and every one rejected is its own reason - a layout question, not a timing one");
+	Check(GmSymbolJudgeScriptWalk(true, 5000, 0) != GmSymbolJudgeScriptWalk(true, 0, 0),
+		"refusal control: 'all rejected' is NOT reported as 'none returned'");
+
+	const char* const no_lookup = GmSymbolScriptRefusalText(GAME_SYMBOL_SCRIPTS_NO_LOOKUP_ROUTINE);
+	const char* const none_returned = GmSymbolScriptRefusalText(GAME_SYMBOL_SCRIPTS_NONE_RETURNED);
+	const char* const all_rejected = GmSymbolScriptRefusalText(GAME_SYMBOL_SCRIPTS_ALL_REJECTED);
+	Check(strcmp(no_lookup, none_returned) != 0 && strcmp(none_returned, all_rejected) != 0 && strcmp(no_lookup, all_rejected) != 0,
+		"refusal: the three reasons are three different sentences in the log");
+	Check(strstr(no_lookup, "m_GetScriptData") != nullptr && strstr(all_rejected, "0 were usable") != nullptr && strstr(none_returned, "no slot returned") != nullptr,
+		"refusal: each sentence names its own cause");
+}
+
+int main()
+{
+	BuildFakeImage();
+
+	TestAddressInsideImage();
+	TestReferentialSlot();
+	TestRoutineBelongsInTable();
+	TestWalkEnd();
+	TestBuiltinWalkLooksWrong();
+	TestScriptRefusal();
+
+	printf("\n%d check(s), %d failure(s)\n", g_Checks, g_Failures);
+	return g_Failures ? 1 : 0;
+}
diff --git a/YYToolkit/hs-tests/yyerror_ledger_test.cpp b/YYToolkit/hs-tests/yyerror_ledger_test.cpp
new file mode 100644
index 0000000..c4d648d
--- /dev/null
+++ b/YYToolkit/hs-tests/yyerror_ledger_test.cpp
@@ -0,0 +1,607 @@
+// Host test for the YYError bookkeeping (Hero Siege patch series). No game, no YYToolkit, no framework.
+//
+// Build and run, from a Visual Studio x64 developer prompt:
+//   cl /nologo /std:c++latest /EHsc /W4 yyerror_ledger_test.cpp && yyerror_ledger_test.exe
+//
+// One line per check. Exit code 0 only if every check passed.
+// Every predicate is checked both ways: a case where it must hold, and a control where it must not.
+
+#include "../source/YYTK/Module Internals/Hooks/YYErrorLedger.hpp"
+
+#include <cstdarg>
+#include <cstdio>
+#include <cstring>
+#include <new>
+#include <string>
+#include <type_traits>
+
+using namespace YYTK::Hooks;
+
+static int g_Checks = 0;
+static int g_Failures = 0;
+
+static void Check(
+	bool Condition,
+	const char* Name
+)
+{
+	g_Checks++;
+	if (!Condition)
+		g_Failures++;
+
+	printf("%s  %s\n", Condition ? "PASS" : "FAIL", Name);
+}
+
+// ===== Helpers =====
+
+static YYErrorSignature SignatureOf(
+	const std::string& Text
+)
+{
+	return YYErrorComputeSignature(Text.c_str(), Text.size());
+}
+
+static YYErrorDisposition Feed(
+	YYErrorLedger& Ledger,
+	const std::string& Text,
+	uint64_t NowMs,
+	uint64_t& ReportNumber
+)
+{
+	return Ledger.Classify(SignatureOf(Text), NowMs, ReportNumber);
+}
+
+// A message made of letters only, so that digit folding cannot merge two of them.
+static std::string DistinctMessage(
+	size_t Index
+)
+{
+	std::string text = "distinct message ";
+	text.push_back(static_cast<char>('a' + (Index % 26)));
+	text.push_back(static_cast<char>('a' + ((Index / 26) % 26)));
+	return text;
+}
+
+// Stands in for the runner's YYError: printf-style, records what it was given and what that expands to.
+static int g_StubCalls = 0;
+static std::string g_StubFormat;
+static std::string g_StubExpansion;
+
+static void StubTrampoline(
+	const char* Format,
+	...
+)
+{
+	char expansion[4096] = {};
+
+	va_list arguments;
+	va_start(arguments, Format);
+	vsnprintf(expansion, sizeof(expansion), Format, arguments);
+	va_end(arguments);
+
+	g_StubCalls++;
+	g_StubFormat = Format;
+	g_StubExpansion = expansion;
+}
+
+// Stands in for the std::string HkYYError expands long messages into. It can be told to refuse
+// to grow, which is the one way to reach the truncation fallback without exhausting the heap.
+struct TestHeapBuffer
+{
+	std::string m_Storage;
+	bool m_RefuseToGrow = false;
+
+	void resize(size_t Size)
+	{
+		if (m_RefuseToGrow)
+			throw std::bad_alloc();
+
+		m_Storage.resize(Size);
+	}
+
+	char* data() { return m_Storage.data(); }
+	size_t size() const { return m_Storage.size(); }
+	const char* c_str() const { return m_Storage.c_str(); }
+};
+
+// Fills the table with reported messages, so that whatever comes next lands in the overflow slot.
+static void FillTable(
+	YYErrorLedger& Ledger,
+	uint64_t NowMs
+)
+{
+	for (size_t i = 0; i < YYERROR_MAX_DISTINCT; i++)
+	{
+		uint64_t report_number = 0;
+		Feed(Ledger, DistinctMessage(i), NowMs, report_number);
+		Ledger.FinishReport(report_number, true, 1);
+	}
+}
+
+template <typename THeapBuffer>
+static YYErrorText Expand(
+	char* StackBuffer,
+	size_t StackBufferSize,
+	THeapBuffer& HeapBuffer,
+	const char* Format,
+	...
+)
+{
+	va_list arguments;
+	va_start(arguments, Format);
+	const YYErrorText text = YYErrorExpandMessage(StackBuffer, StackBufferSize, HeapBuffer, Format, arguments);
+	va_end(arguments);
+
+	return text;
+}
