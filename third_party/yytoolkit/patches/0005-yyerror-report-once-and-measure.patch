+					HkpTicksToMilliseconds(write_end - EntryTicks),
+					HkpTicksToMilliseconds(cost.m_CaptureTicks),
+					HkpTicksToMilliseconds(cost.m_GameSymbolTicks),
+					cost.m_GameFrames,
+					HkpTicksToMilliseconds(cost.m_OtherSymbolTicks),
+					cost.m_OtherFrames,
+					HkpTicksToMilliseconds(cost.m_SymbolTableTicks),
+					HkpTicksToMilliseconds(cost.m_ModuleListTicks),
+					HkpTicksToMilliseconds(write_end - write_start)
