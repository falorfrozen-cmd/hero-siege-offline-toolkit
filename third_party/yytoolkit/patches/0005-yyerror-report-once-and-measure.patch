+#ifndef YYTK_YYERROR_LEDGER_H_
+#define YYTK_YYERROR_LEDGER_H_
+
+// Bookkeeping for HkYYError (Hero Siege patch series).
+//
+// Hero Siege raises errors through YYError that the game then carries on from, over and over.
+// Upstream YYToolkit answers every one of them with a full, symbolised report. The pieces in this
+// header decide which calls still earn that report and which are only counted, and they hold the
+// rule for handing the text back to the runner.
+//
+// Everything here is plain logic: no clock, no file, no YYToolkit or Aurie type. The caller brings
+// the time and does the I/O. That is what lets YYToolkit/hs-tests/yyerror_ledger_test.cpp exercise
+// it on the build host, without a game.
+//
+// Only standard headers are included, on purpose - keep it that way, or the host test stops compiling.
+
+#include <atomic>
+#include <cstdarg>
+#include <cstddef>
+#include <cstdint>
+#include <cstdio>
+#include <cstring>
+#include <string>
+
+#if defined(_M_X64) || defined(_M_IX86)
+#include <intrin.h>
+#endif
+
+#ifndef IN
+#define IN
+#endif
+#ifndef OUT
+#define OUT
+#endif
+
+namespace YYTK
+{
+	namespace Hooks
+	{
+		// How many distinct messages can each earn a full report. One more record, the overflow
+		// slot, is shared by every message that arrives after the table has filled up.
+		constexpr size_t YYERROR_MAX_DISTINCT = 32;
+		constexpr size_t YYERROR_OVERFLOW_SLOT = YYERROR_MAX_DISTINCT;
+
+		// A report that could not be written is tried once more, then given up on.
+		constexpr uint8_t YYERROR_MAX_REPORT_ATTEMPTS = 2;
+
+		// The overflow slot cannot tell its messages apart, so it is limited by time instead.
+		constexpr uint64_t YYERROR_OVERFLOW_REPORT_INTERVAL_MS = 30000;
+
+		// A report whose builder never came back (its thread is gone, or it could not get the gate
+		// to say it was done) stops blocking other reports after this long.
+		constexpr uint64_t YYERROR_REPORT_EXPIRY_MS = 30000;
+
+		// The summary line is written at most this often.
+		constexpr uint64_t YYERROR_SUMMARY_INTERVAL_MS = 30000;
+		// If the ledger cannot be entered when a summary is due, look again after this long...
+		constexpr uint64_t YYERROR_SUMMARY_RETRY_MS = 1000;
+		// ...and after this many refusals in a row, say once that the ledger is out of reach.
+		constexpr long YYERROR_SUMMARY_GATE_MISS_LIMIT = 5;
+
+		// Messages up to this size are expanded on the stack, so a repeat allocates nothing.
+		constexpr size_t YYERROR_STACK_BUFFER_SIZE = 1024;
+
+		using YYErrorRoutine = void(*)(
+			IN const char* Format,
+			IN ...
+		);
+
+		// ===== Forwarding =====
+
+		// The runner's YYError is printf-style, and by the time we forward, the text is already
+		// expanded. It therefore always travels as an argument: put in the format slot (which is
+		// what upstream does), any '%' in it would be expanded a second time, against arguments
+		// that are not there.
+		// Returns false, without calling anything, if there is no routine to call.
+		inline bool YYErrorForward(
+			IN YYErrorRoutine Original,
+			IN const char* ExpandedText
+		)
+		{
+			if (!Original)
+				return false;
+
+			Original("%s", ExpandedText ? ExpandedText : "");
+			return true;
+		}
+
+		// ===== Message expansion =====
+
+		// The text handed on is not always what the runner would have produced. When it is not,
+		// the caller is told which way it fell short, so that it can say so in the log.
+		enum YYErrorTextFallback : int32_t
+		{
+			// The full expansion.
+			YYERROR_TEXT_COMPLETE = 0,
+			// Too long for the stack buffer, and the heap refused: the text is cut at the buffer's size.
+			YYERROR_TEXT_TRUNCATED,
+			// vsnprintf could not expand the format: the text is the format itself, specifiers and all.
+			YYERROR_TEXT_FORMAT_UNEXPANDABLE
+		};
+
+		struct YYErrorText
+		{
+			// Always terminated. Points into the caller's stack buffer or heap buffer.
+			const char* m_Text;
+			size_t m_Length;
+			YYErrorTextFallback m_Fallback;
+		};
+
+		// Expands Format/Arguments the way the runner would. Does not throw.
+		// THeapBuffer is std::string in YYToolkit. It is a parameter only so that the host test can
+		// bring one that refuses to grow; it needs resize(), data(), size() and c_str().
+		template <typename THeapBuffer>
+		inline YYErrorText YYErrorExpandMessage(
+			OUT char* StackBuffer,
+			IN size_t StackBufferSize,
+			OUT THeapBuffer& HeapBuffer,
+			IN const char* Format,
+			IN va_list Arguments
+		)
+		{
+			YYErrorText text = { StackBuffer, 0, YYERROR_TEXT_COMPLETE };
+			StackBuffer[0] = '\0';
+
+			if (!Format)
+				return text;
+
+			// vsnprintf consumes its va_list, and a second pass may be needed.
+			va_list copy_of_arguments;
+			va_copy(copy_of_arguments, Arguments);
+			const int size_required = vsnprintf(StackBuffer, StackBufferSize, Format, copy_of_arguments);
+			va_end(copy_of_arguments);
+
+			if (size_required < 0)
+			{
+				// The format could not be expanded. Its own text is the closest thing left.
+				snprintf(StackBuffer, StackBufferSize, "%s", Format);
+				text.m_Length = strlen(StackBuffer);
+				text.m_Fallback = YYERROR_TEXT_FORMAT_UNEXPANDABLE;
+				return text;
+			}
+
+			if (static_cast<size_t>(size_required) < StackBufferSize)
+			{
+				text.m_Length = static_cast<size_t>(size_required);
+				return text;
+			}
+
+			// Too long for the stack. vsnprintf has left a terminated, truncated copy behind,
+			// which is what the caller gets if the heap refuses.
+			text.m_Length = StackBufferSize - 1;
+			text.m_Fallback = YYERROR_TEXT_TRUNCATED;
+			try
+			{
+				HeapBuffer.resize(static_cast<size_t>(size_required) + 1);
+
+				va_copy(copy_of_arguments, Arguments);
+				vsnprintf(HeapBuffer.data(), HeapBuffer.size(), Format, copy_of_arguments);
+				va_end(copy_of_arguments);
+
+				HeapBuffer.resize(static_cast<size_t>(size_required));
+
+				text.m_Text = HeapBuffer.c_str();
+				text.m_Length = HeapBuffer.size();
+				text.m_Fallback = YYERROR_TEXT_COMPLETE;
+			}
+			catch (...)
+			{
+				text.m_Text = StackBuffer;
+			}
+
+			return text;
+		}
+
+		// ===== Message signature =====
+
+		struct YYErrorSignature
+		{
+			// FNV-1a over the text with every run of decimal digits folded to a single '#'.
+			// This is what decides whether two messages are "the same".
+			uint64_t m_Folded;
+			size_t m_FoldedLength;
+			// FNV-1a over the exact bytes. Only used to count how often the digits really differ.
+			uint64_t m_Exact;
+		};
+
+		// Why digits are folded: the one Hero Siege message on record embeds a number
+		// ("Unable to find any instance for object index '257087'"). Whether that number changes
+		// from one error to the next is NOT measured. If it does, keying on the exact text would
+		// give every error its own full report and the ledger would do nothing; folding makes the
+		// cheap path hold either way, and the "variants" counter in the summary reports which it was.
+		// The price: two messages that differ only in a number share one report (the first one's).
+		inline YYErrorSignature YYErrorComputeSignature(
+			IN const char* Text,
+			IN size_t Length
+		)
+		{
+			constexpr uint64_t fnv_offset_basis = 0xCBF29CE484222325ULL;
+			constexpr uint64_t fnv_prime = 0x100000001B3ULL;
+
+			YYErrorSignature signature = { fnv_offset_basis, 0, fnv_offset_basis };
+			bool inside_digits = false;
+
+			for (size_t i = 0; i < Length; i++)
+			{
+				const unsigned char character = static_cast<unsigned char>(Text[i]);
+
+				signature.m_Exact ^= character;
+				signature.m_Exact *= fnv_prime;
+
+				const bool is_digit = (character >= '0' && character <= '9');
+				if (is_digit && inside_digits)
+					continue;
+
+				inside_digits = is_digit;
+				signature.m_Folded ^= is_digit ? static_cast<unsigned char>('#') : character;
+				signature.m_Folded *= fnv_prime;
+				signature.m_FoldedLength++;
+			}
+
+			return signature;
+		}
+
+		// ===== The ledger =====
+
+		enum YYErrorDisposition : int32_t
+		{
+			// Build and write a full report, then call FinishReport with the number handed out.
+			YYERROR_WRITE_REPORT = 0,
+			// The same, for a message that arrived after the table had filled up (the overflow slot).
+			YYERROR_WRITE_OVERFLOW_REPORT,
+			// Known message, already reported (or given up on after two failures): count only.
+			YYERROR_REPEAT,
+			// Would have earned a report, but one is being built right now: count only, try next time.
+			YYERROR_DEFERRED,
+			// The table is full, and the overflow slot reported this same message last time or
+			// reported anything too recently: count only.
+			YYERROR_OVERFLOW_SUPPRESSED,
+			// The ledger could not be entered (see YYErrorGate): count only. Never returned by
+			// YYErrorLedger::Classify itself.
+			YYERROR_BUSY
+		};
+
+		// Everything that does not want a report is the count-only path.
+		inline bool YYErrorWantsReport(
+			IN YYErrorDisposition Disposition
+		)
+		{
+			return Disposition == YYERROR_WRITE_REPORT || Disposition == YYERROR_WRITE_OVERFLOW_REPORT;
+		}
+
+		struct YYErrorRecord
+		{
+			uint64_t m_Signature;
+			uint64_t m_ExactHash;
+			uint64_t m_Count;
+			// Number of the latest report attempt made for this record.
+			uint64_t m_ReportNumber;
+			size_t m_FoldedLength;
+			uint8_t m_Attempts;
+			// Set by FinishReport(Written = true) and by nothing else: a record is never "reported"
+			// on the strength of a report somebody merely intended to write.
+			bool m_Reported;
+		};
+
+		struct YYErrorCounters
+		{
+			uint64_t m_TotalErrors;
+			uint64_t m_Distinct;
+			uint64_t m_ReportAttempts;
+			uint64_t m_ReportsWritten;
+			uint64_t m_ReportFailures;
+			uint64_t m_Repeats;
+			uint64_t m_Deferred;
+			uint64_t m_OverflowHits;
+			uint64_t m_OverflowSuppressed;
+			// Counted sightings whose exact text differed from the first sighting's: the digits varied.
+			uint64_t m_TextVariants;
+			uint64_t m_ExpiredReports;
+			// Finishes that arrived for a report the ledger had already expired (and counted as failed)...
+			uint64_t m_StaleFinishes;
+			// ...and how many of those had really been written: that report is in the log after all.
+			uint64_t m_StaleWritten;
+			// Caller's clock (QueryPerformanceCounter ticks in YYToolkit), hook entry to report written.
+			// Stale finishes are included: a report slow enough to expire is the one worth knowing about.
+			int64_t m_ReportTicksTotal;
+			int64_t m_ReportTicksMax;
+		};
+
+		// Plain data, so a static one is constant-initialised and has no destructor to run while
+		// the process is tearing down (YYError can still fire then). Not synchronised: see YYErrorGate.
+		struct YYErrorLedger
+		{
+			// The last record is the overflow slot.
+			YYErrorRecord m_Records[YYERROR_MAX_DISTINCT + 1];
+			size_t m_RecordCount;
+			YYErrorCounters m_Counters;
+
+			bool m_ReportInFlight;
+			size_t m_InFlightRecord;
+			uint64_t m_InFlightReportNumber;
+			uint64_t m_InFlightSinceMs;
+			uint64_t m_OverflowNextReportMs;
+
+			// The work done here is bounded by YYERROR_MAX_DISTINCT compares, whatever the game
+			// does: no allocation, no I/O, nothing that depends on the number of scripts or frames.
+			YYErrorDisposition Classify(
+				IN const YYErrorSignature& Signature,
+				IN uint64_t NowMs,
+				OUT uint64_t& ReportNumber
+			)
+			{
+				ReportNumber = 0;
+				m_Counters.m_TotalErrors++;
+
+				// Without this, one lost FinishReport would defer every later report for good -
+				// a ledger that says it is working and reports nothing.
+				// (Two threads can read the clock and then enter in the opposite order, so NowMs
+				// may be slightly older than the in-flight stamp; that must not read as "expired".)
+				if (m_ReportInFlight && NowMs >= m_InFlightSinceMs && (NowMs - m_InFlightSinceMs) >= YYERROR_REPORT_EXPIRY_MS)
+				{
+					m_Counters.m_ExpiredReports++;
+					m_Counters.m_ReportFailures++;
+					m_ReportInFlight = false;
+				}
+
+				size_t record_index = m_RecordCount;
+				for (size_t i = 0; i < m_RecordCount; i++)
+				{
+					if (m_Records[i].m_Signature == Signature.m_Folded && m_Records[i].m_FoldedLength == Signature.m_FoldedLength)
+					{
+						record_index = i;
+						break;
+					}
+				}
+
+				// Never seen, and there is still room: remember it.
+				bool first_sighting = false;
+				if (record_index == m_RecordCount && m_RecordCount < YYERROR_MAX_DISTINCT)
+				{
+					YYErrorRecord& new_record = m_Records[m_RecordCount++];
+					new_record = {};
+					new_record.m_Signature = Signature.m_Folded;
+					new_record.m_FoldedLength = Signature.m_FoldedLength;
+					new_record.m_ExactHash = Signature.m_Exact;
+
+					m_Counters.m_Distinct = m_RecordCount;
+					first_sighting = true;
+				}
+
+				if (record_index < YYERROR_MAX_DISTINCT)
+				{
+					YYErrorRecord& record = m_Records[record_index];
+					record.m_Count++;
+
+					if (!first_sighting && record.m_ExactHash != Signature.m_Exact)
+						m_Counters.m_TextVariants++;
+
+					if (record.m_Reported || record.m_Attempts >= YYERROR_MAX_REPORT_ATTEMPTS)
+					{
+						m_Counters.m_Repeats++;
+						return YYERROR_REPEAT;
+					}
+
+					if (m_ReportInFlight)
+					{
+						m_Counters.m_Deferred++;
+						return YYERROR_DEFERRED;
+					}
+
+					record.m_Attempts++;
+					ReportNumber = BeginReport(record_index, NowMs);
+					return YYERROR_WRITE_REPORT;
+				}
+
+				// The table is full and this message is not in it. It must not go unreported just
+				// for arriving late - the error that finally closes the game may well be a new one.
+				YYErrorRecord& overflow = m_Records[YYERROR_OVERFLOW_SLOT];
+				overflow.m_Count++;
+				m_Counters.m_OverflowHits++;
+
+				const bool same_as_last_report =
+					overflow.m_Reported &&
+					overflow.m_Signature == Signature.m_Folded &&
+					overflow.m_FoldedLength == Signature.m_FoldedLength;
+
+				if (same_as_last_report || NowMs < m_OverflowNextReportMs)
+				{
+					m_Counters.m_OverflowSuppressed++;
+					return YYERROR_OVERFLOW_SUPPRESSED;
+				}
+
+				if (m_ReportInFlight)
+				{
+					m_Counters.m_Deferred++;
+					return YYERROR_DEFERRED;
+				}
+
+				overflow.m_Signature = Signature.m_Folded;
+				overflow.m_FoldedLength = Signature.m_FoldedLength;
+				overflow.m_ExactHash = Signature.m_Exact;
+				overflow.m_Reported = false;
+
+				// Moved on at the attempt, not at the success, so a log that refuses every write
+				// cannot turn each overflow error into a full report attempt.
+				m_OverflowNextReportMs = NowMs + YYERROR_OVERFLOW_REPORT_INTERVAL_MS;
+
+				ReportNumber = BeginReport(YYERROR_OVERFLOW_SLOT, NowMs);
+				return YYERROR_WRITE_OVERFLOW_REPORT;
+			}
+
+			// Written = the report really reached the log. Returns false if ReportNumber is not the
+			// report in flight: it expired in the meantime, and was counted as a failure then.
+			// Such a stale finish never touches the report that IS in flight. Its time still goes
+			// into the totals, and if it was written after all, its record is marked reported -
+			// unless that record has been given another attempt since (m_ReportNumber moved on).
+			bool FinishReport(
+				IN uint64_t ReportNumber,
+				IN bool Written,
+				IN int64_t ElapsedTicks
+			)
+			{
+				if (ElapsedTicks > 0)
+				{
+					m_Counters.m_ReportTicksTotal += ElapsedTicks;
+					if (ElapsedTicks > m_Counters.m_ReportTicksMax)
+						m_Counters.m_ReportTicksMax = ElapsedTicks;
+				}
+
+				if (!m_ReportInFlight || m_InFlightReportNumber != ReportNumber)
+				{
+					m_Counters.m_StaleFinishes++;
+
+					if (Written && ReportNumber)
+					{
+						m_Counters.m_StaleWritten++;
+
+						for (size_t i = 0; i < m_RecordCount; i++)
+						{
+							if (m_Records[i].m_ReportNumber == ReportNumber)
+								m_Records[i].m_Reported = true;
+						}
+
+						// Not part of m_RecordCount. Its signature only ever changes together with
+						// its report number, so a match still means "the message that report was for".
+						if (m_Records[YYERROR_OVERFLOW_SLOT].m_ReportNumber == ReportNumber)
+							m_Records[YYERROR_OVERFLOW_SLOT].m_Reported = true;
+					}
+
+					return false;
+				}
+
+				if (Written)
+				{
+					m_Records[m_InFlightRecord].m_Reported = true;
+					m_Counters.m_ReportsWritten++;
+				}
+				else
+				{
+					m_Counters.m_ReportFailures++;
+				}
+
+				m_ReportInFlight = false;
+				return true;
+			}
+
+			// The tracked record seen most often, so the summary can point at its report. Overflow slot excluded.
+			const YYErrorRecord* MostFrequent() const
+			{
+				const YYErrorRecord* most_frequent = nullptr;
+				for (size_t i = 0; i < m_RecordCount; i++)
+				{
+					if (!most_frequent || m_Records[i].m_Count > most_frequent->m_Count)
+						most_frequent = &m_Records[i];
+				}
+
+				return most_frequent;
+			}
+
+		private:
+			uint64_t BeginReport(
+				IN size_t RecordIndex,
+				IN uint64_t NowMs
+			)
+			{
+				m_ReportInFlight = true;
+				m_InFlightRecord = RecordIndex;
+				m_InFlightSinceMs = NowMs;
+				m_InFlightReportNumber = ++m_Counters.m_ReportAttempts;
+				m_Records[RecordIndex].m_ReportNumber = m_InFlightReportNumber;
+
+				return m_InFlightReportNumber;
+			}
+		};
+
+		// ===== Synchronisation =====
+
+		// YYError has to be assumed callable on any thread. The ledger is guarded by this gate
+		// rather than by an OS lock, because of how the process ends: ExitProcess stops every
+		// other thread wherever it stands, and a lock held by one of them is never released.
+		// Anything that waits on such a lock hangs the game on its way out. This gate never
+		// waits: it spins a bounded number of times and then reports failure, and whoever fails
+		// to get in takes the count-only path and is counted here. A gate orphaned at exit
+		// therefore costs later callers their bookkeeping, and nothing else.
+		struct YYErrorGate
+		{
+			std::atomic<uint32_t> m_Held;
+			std::atomic<uint64_t> m_Misses;
+
+			bool TryEnter(
+				IN uint32_t SpinLimit
+			)
+			{
+				for (uint32_t i = 0; i <= SpinLimit; i++)
+				{
+					uint32_t expected = 0;
+					if (m_Held.compare_exchange_strong(expected, 1))
+						return true;
+
+#if defined(_M_X64) || defined(_M_IX86)
+					_mm_pause();
+#endif
+				}
+
+				m_Misses.fetch_add(1);
+				return false;
+			}
+
+			void Leave()
+			{
+				m_Held.store(0);
+			}
+		};
+
+		// Classify, but only if the gate lets us in.
+		inline YYErrorDisposition YYErrorClassifyGated(
+			IN OUT YYErrorGate& Gate,
+			IN OUT YYErrorLedger& Ledger,
+			IN uint32_t SpinLimit,
+			IN const YYErrorSignature& Signature,
+			IN uint64_t NowMs,
+			OUT uint64_t& ReportNumber
+		)
+		{
+			ReportNumber = 0;
+			if (!Gate.TryEnter(SpinLimit))
+				return YYERROR_BUSY;
+
+			const YYErrorDisposition disposition = Ledger.Classify(Signature, NowMs, ReportNumber);
+			Gate.Leave();
+
+			return disposition;
+		}
+
+		// ===== Summary scheduling =====
+
+		// Activity is a count of YYError calls; SummarisedActivity is its value when the last
+		// summary line was written. A line is owed only if something happened since, and is
+		// written only once the interval since the previous line has passed.
+		inline bool YYErrorSummaryIsDue(
+			IN uint64_t Activity,
+			IN uint64_t SummarisedActivity,
+			IN uint64_t NowMs,
+			IN uint64_t NextAllowedMs
+		)
+		{
+			return Activity != SummarisedActivity && NowMs >= NextAllowedMs;
+		}
+
+		inline uint64_t YYErrorNextSummaryMs(
+			IN uint64_t NowMs,
+			IN uint64_t IntervalMs
+		)
+		{
+			// Saturating: a wrapped sum would make every frame "due".
+			return (NowMs > UINT64_MAX - IntervalMs) ? UINT64_MAX : NowMs + IntervalMs;
+		}
+	}
+}
+
+#endif // YYTK_YYERROR_LEDGER_H_
