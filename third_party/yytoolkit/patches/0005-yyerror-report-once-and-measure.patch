 		size_t YkDetermineFunctionEntrySize();
 
+		// Whether YkExtractFunctionEntry has an array to read - it dereferences both pointers unchecked.
+		// Not virtual, and this header is private to the DLL: the plugin-facing interface is unchanged.
+		bool YkHasFunctionsArray() const
+		{
+			return m_FunctionsArray && *m_FunctionsArray && m_FunctionEntrySize;
+		}
+
+		// A raw look at one slot of the functions array, for a caller that has to judge the slot
+		// BEFORE YkExtractFunctionEntry builds a std::string from whatever its name pointer holds.
+		// Reads the slot itself and nothing it points to. NameReference stays null when the name
+		// is embedded in the slot (RFunctionStringFull). Returns false if there is no array to look at.
+		bool YkPeekFunctionEntry(
+			IN size_t Index,
+			OUT bool& NameIsReference,
+			OUT const char*& NameReference,
+			OUT TRoutine& Routine
+		)
+		{
+			NameIsReference = false;
+			NameReference = nullptr;
+			Routine = nullptr;
+
+			if (!YkHasFunctionsArray())
+				return false;
+
+			RFunction* functions_array = *m_FunctionsArray;
+			if (m_FunctionEntrySize == sizeof(RFunctionStringRef))
+			{
+				const RFunctionStringRef& function_entry = functions_array->GetIndexReferential(Index);
+
+				NameIsReference = true;
+				NameReference = function_entry.m_Name;
+				Routine = function_entry.m_Routine;
+				return true;
+			}
+
+			if (m_FunctionEntrySize == sizeof(RFunctionStringFull))
+			{
+				Routine = functions_array->GetIndexFull(Index).m_Routine;
+				return true;
+			}
+
+			return false;
+		}
+
+		// Whether GetScriptData has a runner routine to call at all.
+		bool YkHasScriptDataRoutine() const
+		{
+			return m_GetScriptData != nullptr;
+		}
+
 		// === Interface Functions ===
 		virtual Aurie::AurieStatus Create() override final;
 
