new file mode 100644
index 0000000..17fd320
--- /dev/null
+++ b/YYToolkit/hs-tests/ri_dump_test.cpp
@@ -0,0 +1,117 @@
+// Host test for the init dump helpers of Generic-RunnerInterfaceScan.hpp - needs neither the game
+// nor Aurie/Zydis/Windows.
+//
+// From a "x64 Native Tools" prompt, in this directory:
+//     cl /nologo /std:c++latest /EHsc /W4 ri_dump_test.cpp && ri_dump_test.exe
+//
+// Prints one line per check and returns non-zero if any check failed.
+// Every predicate has at least one input it must accept and one it must refuse.
+
+#include "../source/YYTK/Module Internals/GameMaker/Generic/Generic-RunnerInterfaceScan.hpp"
+
+#include <cstdio>
+
+using namespace YYTK::RiScan;
+
+static int g_ChecksRun = 0;
+static int g_ChecksFailed = 0;
+
+static void Check(
+	IN bool Condition,
+	IN const char* Name
+)
+{
+	g_ChecksRun++;
+	if (!Condition)
+		g_ChecksFailed++;
+
+	std::printf("%s  %s\n", Condition ? "ok  " : "FAIL", Name);
+}
+
+static void TestDumpGate()
+{
+	Check(IsDumpRequested(L"1", 1), "gate: YYTK_RI_VERBOSE=1 asks for the dump");
+
+	// Not null-terminated on purpose: only ValueLength characters may be looked at
+	const wchar_t unterminated[2] = { L'1', L'1' };
+	Check(IsDumpRequested(unterminated, 1), "gate: the value does not have to be null-terminated");
+
+	// What cmd stores for "set YYTK_RI_VERBOSE=1 && game.exe" - the blank before the && is part of the value
+	Check(IsDumpRequested(L"1 ", 2), "gate: a 1 followed by a blank asks for the dump");
+	Check(IsDumpRequested(L" 1", 2), "gate: a 1 after a blank asks for the dump");
+	Check(IsDumpRequested(L" \t1\t ", 5), "gate: blanks and tabs on both sides are ignored");
+
+	Check(!IsDumpRequested(L"", 0), "gate: an empty value does not");
+	Check(!IsDumpRequested(L" ", 1), "gate: a blank alone does not");
+	Check(!IsDumpRequested(L" \t ", 3), "gate: blanks and tabs alone do not");
+	Check(!IsDumpRequested(L"0", 1), "gate: 0 does not");
+	Check(!IsDumpRequested(L"2", 1), "gate: 2 does not");
+	Check(!IsDumpRequested(L"10", 2), "gate: 10 does not");
+	Check(!IsDumpRequested(L"11", 2), "gate: 11 does not");
+	Check(!IsDumpRequested(L"1 1", 3), "gate: a blank between two 1s is not ignored");
+	Check(!IsDumpRequested(L" 0 ", 3), "gate: a padded 0 does not");
+	Check(!IsDumpRequested(L"1\n", 2), "gate: only blanks and tabs are ignored, a newline is not");
+	Check(!IsDumpRequested(L"true", 4), "gate: true does not");
+	Check(!IsDumpRequested(L"1", 0), "gate: a length of 0 does not, whatever the buffer holds");
+	Check(!IsDumpRequested(nullptr, 1), "gate: no value does not");
+
+	// The three answers, from what GetEnvironmentVariableW returns for a 16 character buffer
+	constexpr size_t capacity = 16;
+	Check(ClassifyDumpRequest(L"1", 1, capacity) == DumpRequest::Requested, "answer: 1 is a request");
+	Check(ClassifyDumpRequest(L"1 ", 2, capacity) == DumpRequest::Requested, "answer: a 1 followed by a blank is a request");
+	Check(ClassifyDumpRequest(L"", 0, capacity) == DumpRequest::NotSet, "answer: a returned length of 0 is a variable that is not set");
+	Check(ClassifyDumpRequest(L"1", 0, capacity) == DumpRequest::NotSet, "answer: ...whatever the buffer holds");
+	Check(ClassifyDumpRequest(L"0", 1, capacity) == DumpRequest::Refused, "answer: 0 is set, but refused - not the same as not set");
+	Check(ClassifyDumpRequest(L"true", 4, capacity) == DumpRequest::Refused, "answer: true is set, but refused");
+	Check(ClassifyDumpRequest(L"              1", 15, capacity) == DumpRequest::Requested, "answer: the longest value that fits is still looked at");
+
+	// A value that did not fit: the buffer holds nothing of it, and the length is the capacity it needs.
+	// The buffer is given a lone 1 here, to show that it is not what decides.
+	Check(ClassifyDumpRequest(L"1", capacity, capacity) == DumpRequest::Refused, "answer: a value that needs the whole buffer for itself is refused");
+	Check(ClassifyDumpRequest(L"1", 4096, capacity) == DumpRequest::Refused, "answer: a very long value is refused");
+	Check(ClassifyDumpRequest(L"1", 1, 1) == DumpRequest::Refused, "answer: a buffer without room for the terminator fits nothing");
+}
+
+static void TestRowCount()
+{
+	constexpr size_t row_size = 32;
+
+	// The emulated stack of the hook: 16 KiB, 512 rows
+	std::vector<uint8_t> stack(0x4000, 0);
+	Check(CountNonZeroRows(stack.data(), stack.size(), row_size) == 0, "rows: a zeroed stack has no non-zero row");
+
+	// 100 pointers from 0x1F60 on, as in the measured log: 800 bytes, exactly 25 rows
+	for (size_t slot = 0; slot < 100; slot++)
+		stack[0x1F60 + (slot * 8) + 5] = 0x7F;
+	Check(CountNonZeroRows(stack.data(), stack.size(), row_size) == 25, "rows: 100 pointers from a row boundary on are 25 rows");
+
+	std::vector<uint8_t> edges(4 * row_size, 0);
+	edges[0] = 1;
+	Check(CountNonZeroRows(edges.data(), edges.size(), row_size) == 1, "rows: the first byte of a row counts");
+	edges[0] = 0;
+	edges[row_size - 1] = 1;
+	Check(CountNonZeroRows(edges.data(), edges.size(), row_size) == 1, "rows: the last byte of a row counts");
+	edges[row_size] = 1;
+	Check(CountNonZeroRows(edges.data(), edges.size(), row_size) == 2, "rows: bytes either side of a row boundary are two rows");
+	edges[row_size + 1] = 1;
+	Check(CountNonZeroRows(edges.data(), edges.size(), row_size) == 2, "rows: two bytes in one row are one row");
+
+	// Bytes after the last whole row must neither be counted nor be read as part of a row
+	std::vector<uint8_t> ragged(row_size + 5, 0);
+	ragged[row_size + 2] = 1;
+	Check(CountNonZeroRows(ragged.data(), ragged.size(), row_size) == 0, "rows: bytes after the last whole row are not counted");
+	Check(CountNonZeroRows(ragged.data(), row_size - 1, row_size) == 0, "rows: less than one row is no row");
+
+	Check(CountNonZeroRows(edges.data(), edges.size(), 0) == 0, "rows: a row size of 0 is refused");
+	Check(CountNonZeroRows(nullptr, 64, row_size) == 0, "rows: no buffer, no rows");
+	Check(CountNonZeroRows(edges.data(), 0, row_size) == 0, "rows: no bytes, no rows");
+}
+
+int main()
+{
+	TestDumpGate();
+	TestRowCount();
+
+	std::printf("%d checks, %d failed\n", g_ChecksRun, g_ChecksFailed);
+	return g_ChecksFailed ? 1 : 0;
+}
