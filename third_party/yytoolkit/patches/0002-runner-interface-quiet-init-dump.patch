 // Pure helpers for the runner interface scan in Generic-RunnerInterfaceNew.cpp.
 //
 // Only standard headers are included - no Aurie, no Zydis, no Windows - so that
-// YYToolkit/hs-tests/ri_scan_test.cpp can compile and exercise every function in here on a build
-// host, without the game. Nothing in this file touches memory it was not handed, a file, or a global.
+// YYToolkit/hs-tests/ri_scan_test.cpp and ri_dump_test.cpp can compile and exercise every function in
+// here on a build host, without the game. Nothing in this file touches memory it was not handed, a file, or a global.
 
 #include <cstddef>
 #include <cstdint>
@@ -602,6 +602,94 @@ namespace YYTK
 				Stored.SizeOfImage == Current.SizeOfImage &&
 				Stored.CheckSum == Current.CheckSum;
 		}
+
+		// ===== The init dump =====
+
+		// True if the value of YYTK_RI_VERBOSE asks for the dump, which only "1" does.
+		// Value does not have to be null-terminated.
+		//
+		// Blanks and tabs around the 1 are ignored: "set YYTK_RI_VERBOSE=1 && game.exe" in cmd stores
+		// "1 " (everything up to the &&), and that is the commonest way to follow the log's own advice.
+		inline bool IsDumpRequested(
+			IN const wchar_t* Value,
+			IN size_t ValueLength
+		)
+		{
+			if (!Value)
+				return false;
+
+			const auto is_blank = [](wchar_t Character) -> bool
+				{
+					return Character == L' ' || Character == L'\t';
+				};
+
+			size_t first = 0;
+			size_t last = ValueLength;
+
+			while (first < last && is_blank(Value[first]))
+				first++;
+
+			while (last > first && is_blank(Value[last - 1]))
+				last--;
+
+			return (last - first) == 1 && Value[first] == L'1';
+		}
+
+		// What the environment said about the dump. "Set, but refused" is its own answer, so that the
+		// log can tell "the variable never reached the game" from "it arrived and was not 1".
+		enum class DumpRequest
+		{
+			NotSet,
+			Refused,
+			Requested
+		};
+
+		// Reads the result of GetEnvironmentVariableW(Name, Value, ValueCapacity), whose return value is
+		// ReturnedLength: 0 if the variable is not set (or empty), the number of characters stored if the
+		// value fit, and the capacity it would have needed - which is not below ValueCapacity - if it did
+		// not. A value that did not fit was not looked at, and is refused: no such value is "1".
+		inline DumpRequest ClassifyDumpRequest(
+			IN const wchar_t* Value,
+			IN size_t ReturnedLength,
+			IN size_t ValueCapacity
+		)
+		{
+			if (!ReturnedLength)
+				return DumpRequest::NotSet;
+
+			if (ReturnedLength >= ValueCapacity)
+				return DumpRequest::Refused;
+
+			return IsDumpRequested(Value, ReturnedLength) ? DumpRequest::Requested : DumpRequest::Refused;
+		}
+
+		// The number of rows of BytesPerRow bytes that hold anything but zeros.
+		// Bytes left over after the last whole row are not counted.
+		inline size_t CountNonZeroRows(
+			IN const uint8_t* Bytes,
+			IN size_t ByteCount,
+			IN size_t BytesPerRow
+		)
+		{
+			if (!Bytes || !BytesPerRow)
+				return 0;
+
+			size_t non_zero_rows = 0;
+
+			for (size_t row_start = 0; (ByteCount - row_start) >= BytesPerRow; row_start += BytesPerRow)
+			{
+				for (size_t index = 0; index < BytesPerRow; index++)
+				{
+					if (Bytes[row_start + index])
+					{
+						non_zero_rows++;
+						break;
+					}
+				}
+			}
+
+			return non_zero_rows;
+		}
 	}
 }
 
