diff --git a/YYToolkit/source/YYTK/Module Interface/ObjectCallGate.hpp b/YYToolkit/source/YYTK/Module Interface/ObjectCallGate.hpp
new file mode 100644
index 0000000..056f1be
--- /dev/null
+++ b/YYToolkit/source/YYTK/Module Interface/ObjectCallGate.hpp	
@@ -0,0 +1,157 @@
+#ifndef YYTK_OBJECT_CALL_GATE_H_
+#define YYTK_OBJECT_CALL_GATE_H_
+
+// DLL-private - this file is not part of the plugin ABI, and plugins never see it.
+//
+// It holds the build switch for the ExecuteIt hook, and the pure logic that
+// YYTKInterfaceImpl::CreateCallback() uses when it refuses EVENT_OBJECT_CALL.
+// Only standard and Windows headers are included, so that
+// YYToolkit/hs-tests/ObjectCallGateTest.cpp can compile and run it without the game.
+
+#include <Windows.h>
+#include <atomic>
+#include <cstdint>
+#include <string>
+
+#ifndef IN
+#define IN
+#endif // IN
+
+#ifndef OUT
+#define OUT
+#endif // OUT
+
+// Controls whether Hooks::HkPreinitialize() installs the ExecuteIt detour, which is the
+// only thing that dispatches EVENT_OBJECT_CALL. This fork ships with it OFF - see the
+// comment in HkPreinitialize() for why, and YYTKInterfaceImpl::CreateCallback() for
+// what a plugin observes. Build with /DYYTK_HOOK_EXECUTEIT=1 for upstream behavior.
+#ifndef YYTK_HOOK_EXECUTEIT
+#define YYTK_HOOK_EXECUTEIT 0
+#endif // YYTK_HOOK_EXECUTEIT
+
+namespace YYTK
+{
+	namespace ObjectCallGate
+	{
+		// How many refused EVENT_OBJECT_CALL registrations are written to the log and the console.
+		// Each written refusal is a flushed file write, so the number has to be bounded:
+		// a plugin that retries the registration every frame must not be able to grow
+		// YYToolkit.log without limit. No such plugin was observed - this is a precaution.
+		constexpr uint32_t max_logged_refusals = 8;
+
+		// The longest image name that is put into a refusal line.
+		// CmpParseVa() formats into a fixed 4096 byte buffer, so whatever goes into it has to be bounded.
+		constexpr size_t max_image_name_length = 64;
+
+		// Counts one refusal, and returns its number (the first refusal is number 1).
+		// The count sticks at UINT32_MAX instead of wrapping around, because a wrapped counter
+		// would start logging again.
+		//
+		// ASSUMED, not measured: CreateCallback() can be reached from more than one thread
+		// (a plugin's init thread and the game thread). The compare-exchange hands every number out
+		// exactly once either way, and takes no lock. The callback list itself is unguarded upstream,
+		// and that is left as it was.
+		inline uint32_t CountRefusal(
+			IN OUT std::atomic<uint32_t>& RefusalCount
+		)
+		{
+			uint32_t seen_count = RefusalCount.load();
+
+			while (seen_count != UINT32_MAX)
+			{
+				// On failure, seen_count is reloaded with the current value.
+				if (RefusalCount.compare_exchange_weak(seen_count, seen_count + 1))
+					return seen_count + 1;
+			}
+
+			return UINT32_MAX;
+		}
+
+		// Whether the refusal with this number is written out. Number 0 means "no refusal".
+		inline bool ShouldLogRefusal(
+			IN uint32_t RefusalNumber
+		)
+		{
+			return RefusalNumber >= 1 && RefusalNumber <= max_logged_refusals;
+		}
+
+		// Whether the refusal with this number is the last one that is written out,
+		// ie. the one that has to say that the following ones are silent.
+		inline bool IsLastLoggedRefusal(
+			IN uint32_t RefusalNumber
+		)
+		{
+			return RefusalNumber == max_logged_refusals;
+		}
+
+		// Turns an image path into something that is safe to put into a log line:
+		// only the file name (a full path may carry the user's profile folder name),
+		// printable ASCII only, and never longer than max_image_name_length.
+		inline std::string NarrowImageName(
+			IN const std::wstring& ImagePath
+		)
+		{
+			const size_t last_separator = ImagePath.find_last_of(L"\\/");
+			const size_t name_start = (last_separator == std::wstring::npos) ? 0 : last_separator + 1;
+
+			std::string image_name;
+			for (size_t i = name_start; i < ImagePath.size(); i++)
+			{
+				const wchar_t character = ImagePath[i];
+				const bool is_printable_ascii = (character >= 0x20 && character <= 0x7E);
+
+				image_name.push_back(is_printable_ascii ? static_cast<char>(character) : '?');
+			}
+
+			if (image_name.empty())
+				return "<unknown>";
+
+			if (image_name.size() > max_image_name_length)
+			{
+				image_name.resize(max_image_name_length - 3);
+				image_name.append("...");
+			}
+
+			return image_name;
+		}
+
+		// Names the image that a callback routine lives in.
+		//
+		// The loader is asked about the routine's address. The AurieModule pointer that came
+		// with the request is deliberately not used for this: upstream never dereferences it
+		// in CreateCallback(), and a refusal path must not be the first place that does.
+		inline std::string DescribeRoutineOwner(
+			IN PVOID Routine
+		)
+		{
+			HMODULE owner_image = nullptr;
+
+			if (!Routine)
+				return NarrowImageName(L"");
+
+			if (!GetModuleHandleExW(
+				GET_MODULE_HANDLE_EX_FLAG_FROM_ADDRESS | GET_MODULE_HANDLE_EX_FLAG_UNCHANGED_REFCOUNT,
+				static_cast<LPCWSTR>(Routine),
+				&owner_image
+			))
+			{
+				return NarrowImageName(L"");
+			}
+
+			wchar_t image_path[1024] = { 0 };
+			const DWORD path_length = GetModuleFileNameW(
+				owner_image,
+				image_path,
+				static_cast<DWORD>(std::size(image_path))
+			);
+
+			// A path that didn't fit has lost its file name, which is the part that matters.
+			if (path_length == 0 || path_length >= std::size(image_path))
+				return NarrowImageName(L"");
+
+			return NarrowImageName(std::wstring(image_path, path_length));
+		}
+	}
+}
