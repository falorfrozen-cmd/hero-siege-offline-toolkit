@@ -0,0 +1,562 @@
+#ifndef YYTK_FUNCTIONS_ARRAY_VALIDATION_H_
+#define YYTK_FUNCTIONS_ARRAY_VALIDATION_H_
+
+// Positive identification of the runner's "RFunction* the_functions" global.
+//
+// This header depends on nothing but the Windows and the standard headers, so that
+// hs-tests/fnarray_validation_test.cpp can exercise it in a plain executable,
+// whose own image then plays the role of the game image. No game is needed.
+//
+// Everything in here has internal linkage on purpose. The names are generic enough
+// (regions, spans, snapshots) that another translation unit may want its own.
+
+#include <Windows.h>
+#include <cstdint>
+#include <cstring>
+#include <string>
+
+#ifndef IN
+#define IN
+#endif // IN
+
+#ifndef OUT
+#define OUT
+#endif // OUT
+
+namespace YYTK
+{
+	namespace FunctionsArrayValidation
+	{
+		namespace
+		{
+			// How many entries from the start of the table have to parse.
+			// ASSUMED, not measured: a real table holds every builtin the runner registers,
+			// so it has way more entries than this, and none of the first few is a placeholder
+			// without a routine. If that is wrong for some runner, the real table is rejected
+			// with a reason that names the entry, and initialization fails with a status.
+			constexpr size_t SAMPLE_COUNT = 8;
+
+			// Size of the buffer a name is copied into, terminator included.
+			// Names end up in log lines, and CmpParseVa formats those into a 4096 byte buffer
+			// with vsprintf_s, which terminates the process on overflow. Keep this small.
+			constexpr size_t NAME_BUFFER_SIZE = 256;
+
+			// Upper bound for a reason string, for the same reason as above
+			constexpr size_t MAXIMUM_REASON_LENGTH = 1024;
+
+			// How many times the whole search may fail before stage 2 stops repeating it.
+			// Stage 2 is entered again for every module that gets initialized while it is incomplete
+			// (ModuleMain.cpp), and a failed search logs one line per distinct candidate, per finder.
+			// ASSUMED: a search that failed this often does not start to succeed later.
+			constexpr size_t MAXIMUM_FAILED_SEARCHES = 3;
+
+			// Code_Function_Find reports builtins below this value, scripts and
+			// extension functions at or above it (see GetNamedRoutinePointer).
+			constexpr int BUILTIN_INDEX_LIMIT = 100000;
+
+			// Same signature as YYRunnerInterface::Code_Function_Find
+			using FunctionFinder = bool(*)(
+				IN const char* Name,
+				OUT int* Index
+			);
+
+			// Mirrors of RFunctionStringRef and RFunctionStringFull (Tool.hpp).
+			// YYC-Functions.cpp static_asserts that they match in size and field offsets.
+			struct ReferentialEntryLayout
+			{
+				const char* m_Name;
+				void* m_Routine;
+				int32_t m_ArgumentCount;
+				int32_t m_UsageCount;
+			};
+
+			struct EmbeddedEntryLayout
+			{
+				char m_Name[64];
+				void* m_Routine;
+				int32_t m_ArgumentCount;
+				int32_t m_UsageCount;
+			};
+
+			// Our own copy of one entry, no matter what layout it came from
+			struct FunctionEntrySnapshot
+			{
+				char Name[NAME_BUFFER_SIZE];
+				uintptr_t Routine;
+			};
+
+			// What GmpiSelectFunctionsArray settled on. All zero if nothing was selected.
+			struct FunctionsArraySelection
+			{
+				// Address of the global, not of the table
+				uintptr_t Candidate;
+				// Index into the list the candidate came from
+				size_t CandidateIndex;
+				size_t EntrySize;
+				// How many distinct candidates were looked at, the selected one included
+				size_t ExaminedCount;
+			};
+
+			// Fails for everything that cannot be touched without consequences:
+			// unmapped or reserved memory, PAGE_NOACCESS, and guard pages
+			// (touching a guard page raises an exception and disarms the guard).
+			inline bool GmpiQueryRegion(
+				IN uintptr_t Address,
+				OUT MEMORY_BASIC_INFORMATION& Region
+			)
+			{
+				memset(&Region, 0, sizeof(Region));
+
+				if (!VirtualQuery(reinterpret_cast<LPCVOID>(Address), &Region, sizeof(Region)))
+					return false;
+
+				if (Region.State != MEM_COMMIT)
+					return false;
+
+				if (Region.Protect & (PAGE_GUARD | PAGE_NOACCESS))
+					return false;
+
+				return true;
+			}
+
+			// "Not PAGE_NOACCESS" is not the same thing as readable:
+			// PAGE_EXECUTE and a protection of 0 are neither.
+			inline bool GmpiIsRegionReadable(
+				IN const MEMORY_BASIC_INFORMATION& Region
+			)
+			{
+				switch (Region.Protect & 0xFF)
+				{
+				case PAGE_READONLY:
+				case PAGE_READWRITE:
+				case PAGE_WRITECOPY:
+				case PAGE_EXECUTE_READ:
+				case PAGE_EXECUTE_READWRITE:
+				case PAGE_EXECUTE_WRITECOPY:
+					return true;
+				}
+
+				return false;
+			}
+
+			inline bool GmpiIsRegionExecutable(
+				IN const MEMORY_BASIC_INFORMATION& Region
+			)
+			{
+				switch (Region.Protect & 0xFF)
+				{
+				case PAGE_EXECUTE:
+				case PAGE_EXECUTE_READ:
+				case PAGE_EXECUTE_READWRITE:
+				case PAGE_EXECUTE_WRITECOPY:
+					return true;
+				}
+
+				return false;
+			}
+
+			// Every section of a loaded image shares the image base as its allocation base,
+			// so this needs neither section names nor the PE headers.
+			inline bool GmpiIsRegionInImage(
+				IN const MEMORY_BASIC_INFORMATION& Region,
+				IN LPCVOID ImageBase
+			)
+			{
+				return ImageBase && Region.Type == MEM_IMAGE && Region.AllocationBase == ImageBase;
+			}
+
+			inline bool GmpiIsReadableImageAddress(
+				IN uintptr_t Address,
+				IN LPCVOID ImageBase
+			)
+			{
+				MEMORY_BASIC_INFORMATION region;
+				return GmpiQueryRegion(Address, region) && GmpiIsRegionReadable(region) && GmpiIsRegionInImage(region, ImageBase);
+			}
+
+			inline bool GmpiIsExecutableImageAddress(
+				IN uintptr_t Address,
+				IN LPCVOID ImageBase
+			)
+			{
+				MEMORY_BASIC_INFORMATION region;
+				return GmpiQueryRegion(Address, region) && GmpiIsRegionExecutable(region) && GmpiIsRegionInImage(region, ImageBase);
+			}
+
+			// Returns how many bytes starting at Address are committed and readable, up to MaximumSize.
+			// One VirtualQuery per region, not per byte or per page.
+			inline size_t GmpiGetReadableSpan(
+				IN uintptr_t Address,
+				IN size_t MaximumSize
+			)
+			{
+				size_t span = 0;
+				while (Address && span < MaximumSize)
+				{
+					const uintptr_t cursor = Address + span;
+					if (cursor < Address)
+						break;
+
+					MEMORY_BASIC_INFORMATION region;
+					if (!GmpiQueryRegion(cursor, region) || !GmpiIsRegionReadable(region))
+						break;
+
+					// VirtualQuery rounds BaseAddress down to the page and measures RegionSize from
+					// there, so what is left for us is counted from the cursor, not from the base.
+					const uintptr_t region_end = reinterpret_cast<uintptr_t>(region.BaseAddress) + region.RegionSize;
+					if (region_end <= cursor)
+						break;
+
+					const size_t available = region_end - cursor;
+					const size_t wanted = MaximumSize - span;
+					span += (available < wanted) ? available : wanted;
+				}
+
+				return span;
+			}
+
+			// Copies memory that may not be mapped at all. Never faults.
+			inline bool GmpiCopyMemory(
+				IN uintptr_t Address,
+				IN size_t Size,
+				OUT PVOID Buffer
+			)
+			{
+				if (!Address || !Size || !Buffer)
+					return false;
+
+				// The whole range has to be readable right now, so that nothing that is known
+				// to be a guard page or PAGE_NOACCESS is ever handed to a read.
+				// MEASURED with the host test on Windows 11 (26200): ReadProcessMemory on its own also
+				// fails on a guard page and leaves it armed. That is not documented behaviour, so this
+				// check stays, but the test cannot tell the two apart.
+				if (GmpiGetReadableSpan(Address, Size) != Size)
+					return false;
+
+				// The copy itself is done by the OS, which fails instead of faulting
+				// if another thread pulled the page from under us in the meantime.
+				// That race is ASSUMED to be possible, it was never observed.
+				SIZE_T bytes_read = 0;
+				if (!ReadProcessMemory(GetCurrentProcess(), reinterpret_cast<LPCVOID>(Address), Buffer, Size, &bytes_read))
+					return false;
+
+				return bytes_read == Size;
+			}
+
+			// Checks OUR OWN copy of a name: terminated within Size bytes, not empty, graphic ASCII only.
+			// Buffer is never game memory, so this is a plain loop.
+			inline bool GmpiIsFunctionName(
+				IN const char* Buffer,
+				IN size_t Size
+			)
+			{
+				for (size_t i = 0; i < Size; i++)
+				{
+					const unsigned char current = static_cast<unsigned char>(Buffer[i]);
+					if (current == '\0')
+						return i != 0;
+
+					// No spaces, no control characters, nothing above 0x7E
+					if (current < 0x21 || current > 0x7E)
+						return false;
+				}
+
+				return false;
+			}
+
+			// Keeps a reason short enough to be logged, see MAXIMUM_REASON_LENGTH
+			inline void GmpiCapReasonLength(
+				IN OUT std::string& Reason,
+				IN size_t MaximumLength
+			)
+			{
+				if (MaximumLength < 3 || Reason.size() <= MaximumLength)
+					return;
+
+				Reason.resize(MaximumLength - 3);
+				Reason += "...";
+			}
+
+			// Returns nullptr if the entry was copied into Entry, otherwise why it was not.
+			inline const char* GmpiSnapshotFunctionEntry(
+				IN uintptr_t ArrayBase,
+				IN size_t EntrySize,
+				IN size_t Index,
+				OUT FunctionEntrySnapshot& Entry
+			)
+			{
+				memset(&Entry, 0, sizeof(Entry));
+
+				const uintptr_t entry_address = ArrayBase + (EntrySize * Index);
+				if (entry_address < ArrayBase)
+					return "is outside of the address space";
+
+				if (EntrySize == sizeof(ReferentialEntryLayout))
+				{
+					ReferentialEntryLayout raw_entry = {};
+					if (!GmpiCopyMemory(entry_address, sizeof(raw_entry), &raw_entry))
+						return "is not readable";
+
+					Entry.Routine = reinterpret_cast<uintptr_t>(raw_entry.m_Routine);
+
+					// A literal may sit right before an unmapped page, so only take what is there.
+					// The last byte of Entry.Name is never written, which keeps it terminated for logging.
+					const uintptr_t name_address = reinterpret_cast<uintptr_t>(raw_entry.m_Name);
+					const size_t name_span = GmpiGetReadableSpan(name_address, sizeof(Entry.Name) - 1);
+					if (!name_span || !GmpiCopyMemory(name_address, name_span, Entry.Name))
+						return "has a name pointer that is not readable";
+
+					if (!GmpiIsFunctionName(Entry.Name, name_span))
+					{
+						Entry.Name[0] = '\0';
+						return "has a name that is not a terminated graphic ASCII string";
+					}
+
+					return nullptr;
+				}
+
+				if (EntrySize == sizeof(EmbeddedEntryLayout))
+				{
+					EmbeddedEntryLayout raw_entry = {};
+					if (!GmpiCopyMemory(entry_address, sizeof(raw_entry), &raw_entry))
+						return "is not readable";
+
+					// The name is embedded, so it is checked in our own copy of the entry
+					Entry.Routine = reinterpret_cast<uintptr_t>(raw_entry.m_Routine);
+					if (!GmpiIsFunctionName(raw_entry.m_Name, sizeof(raw_entry.m_Name)))
+						return "has a name that is not a terminated graphic ASCII string";
+
+					memcpy(Entry.Name, raw_entry.m_Name, sizeof(raw_entry.m_Name));
+					return nullptr;
+				}
+
+				return "has an unsupported size";
+			}
+
+			// Checks the first SAMPLE_COUNT entries of the table at ArrayBase under one layout.
+			// On success Summary describes what was found, on failure Reason says what was not.
+			inline bool GmpiCheckFunctionsArrayLayout(
+				IN uintptr_t ArrayBase,
+				IN size_t EntrySize,
+				IN LPCVOID ImageBase,
+				IN FunctionFinder Finder,
+				OUT std::string& Summary,
+				OUT std::string& Reason
+			)
+			{
+				FunctionEntrySnapshot entries[SAMPLE_COUNT];
+
+				// Structure first. The game is only ever asked about names
+				// that come from a table which parses from start to end.
+				for (size_t i = 0; i < SAMPLE_COUNT; i++)
+				{
+					const char* failure = GmpiSnapshotFunctionEntry(ArrayBase, EntrySize, i, entries[i]);
+					if (failure)
+					{
+						Reason = "entry " + std::to_string(i) + " " + failure;
+						return false;
+					}
+
+					// Builtins are implemented by the runner itself
+					if (!GmpiIsExecutableImageAddress(entries[i].Routine, ImageBase))
+					{
+						Reason = "entry " + std::to_string(i) + " ('" + entries[i].Name + "') has a routine that is not executable game image code";
+						return false;
+					}
+				}
+
+				// Then ask the game where it thinks these names live.
+				// At least one has to agree, and none may contradict.
+				size_t confirmed_count = 0;
+				for (size_t i = 0; i < SAMPLE_COUNT; i++)
+				{
+					// The name passed in is our own, validated and terminated copy
+					int reported_index = -1;
+					Finder(entries[i].Name, &reported_index);
+
+					// Unknown to the game, or shadowed by a script / extension function: tells us nothing
+					if (reported_index < 0 || reported_index >= BUILTIN_INDEX_LIMIT)
+						continue;
+
+					if (static_cast<size_t>(reported_index) == i)
+					{
+						confirmed_count++;
+						continue;
+					}
+
+					// A name registered twice is fine, as long as the entry
+					// the game points us at really carries that name.
+					FunctionEntrySnapshot reported_entry;
+					const char* failure = GmpiSnapshotFunctionEntry(ArrayBase, EntrySize, static_cast<size_t>(reported_index), reported_entry);
+					if (failure || strcmp(reported_entry.Name, entries[i].Name))
+					{
+						Reason = "Code_Function_Find places entry " + std::to_string(i) + " ('" + entries[i].Name + "') at index " +
+							std::to_string(reported_index) + ", which " + (failure ? failure : "holds another name");
+						return false;
+					}
+
+					confirmed_count++;
+				}
+
+				if (!confirmed_count)
+				{
+					Reason = "Code_Function_Find confirmed none of the sampled names (entry 0 is '" + std::string(entries[0].Name) + "')";
+					return false;
+				}
+
+				Summary = "entry 0 is '" + std::string(entries[0].Name) + "', " + std::to_string(confirmed_count) + " of " +
+					std::to_string(SAMPLE_COUNT) + " names confirmed by Code_Function_Find";
+				return true;
+			}
+
+			// Candidate is the address of a global that is *supposed* to be "RFunction* the_functions".
+			// Nothing about it is trusted, and nothing reachable from it is dereferenced directly.
+			// Returns true and the entry size if it is, false and the reason if it is not.
+			inline bool GmpiValidateFunctionsArray(
+				IN uintptr_t Candidate,
+				IN LPCVOID ImageBase,
+				IN FunctionFinder Finder,
+				OUT size_t& EntrySize,
+				OUT std::string& Reason
+			)
+			{
+				EntrySize = 0;
+				Reason.clear();
+
+				if (!Finder || !ImageBase)
+				{
+					Reason = "there is nothing to check it against";
+					return false;
+				}
+
+				// the_functions is a global of the runner
+				if (!GmpiIsReadableImageAddress(Candidate, ImageBase))
+				{
+					Reason = "global is not readable game image memory";
+					return false;
+				}
+
+				if (Candidate % alignof(void*))
+				{
+					Reason = "global is not pointer-aligned";
+					return false;
+				}
+
+				// This is the value upstream dereferenced blindly
+				uintptr_t array_base = 0;
+				if (!GmpiCopyMemory(Candidate, sizeof(array_base), &array_base))
+				{
+					Reason = "global could not be read";
+					return false;
+				}
+
+				if (!array_base || (array_base % alignof(void*)))
+				{
+					Reason = "global does not hold an aligned pointer";
+					return false;
+				}
+
+				// The table has to parse from start to end under ONE layout.
+				// A table that parses as referential cannot parse as embedded, since
+				// pointer bytes are not graphic ASCII, so the order does not matter.
+				std::string referential_reason;
+				if (GmpiCheckFunctionsArrayLayout(array_base, sizeof(ReferentialEntryLayout), ImageBase, Finder, Reason, referential_reason))
+				{
+					EntrySize = sizeof(ReferentialEntryLayout);
+					return true;
+				}
+
+				std::string embedded_reason;
+				if (GmpiCheckFunctionsArrayLayout(array_base, sizeof(EmbeddedEntryLayout), ImageBase, Finder, Reason, embedded_reason))
+				{
+					EntrySize = sizeof(EmbeddedEntryLayout);
+					return true;
+				}
+
+				Reason = "as referential: " + referential_reason + "; as embedded: " + embedded_reason;
+				GmpiCapReasonLength(Reason, MAXIMUM_REASON_LENGTH);
+
+				return false;
+			}
+
+			// Goes through Candidates in the order given and picks the one that is the functions array.
+			// A value that shows up more than once is looked at (and reported) once, the first time.
+			// Reporter is told about every candidate that was looked at:
+			//   Reporter(size_t Index, uintptr_t Candidate, bool Accepted, size_t EntrySize, const std::string& Text)
+			// where Text is the reason for a rejected candidate, and the summary for an accepted one.
+			//
+			// PreferLowest == false: the first valid candidate wins, nothing behind it is looked at.
+			// PreferLowest == true:  every distinct candidate is looked at, the valid one lowest in memory wins.
+			//
+			// There is no "least bad" pick. If no candidate is valid this returns false,
+			// and nothing but ExaminedCount is set in Selection.
+			template <typename TReporter>
+			inline bool GmpiSelectFunctionsArray(
+				IN const uintptr_t* Candidates,
+				IN size_t CandidateCount,
+				IN LPCVOID ImageBase,
+				IN FunctionFinder Finder,
+				IN bool PreferLowest,
+				IN TReporter&& Reporter,
+				OUT FunctionsArraySelection& Selection
+			)
+			{
+				memset(&Selection, 0, sizeof(Selection));
+
+				if (!Candidates)
+					return false;
+
+				bool is_anything_selected = false;
+				for (size_t i = 0; i < CandidateCount; i++)
+				{
+					// Quadratic, but the list is bounded by the caller's scan window (a few hundred bytes of code)
+					bool is_duplicate = false;
+					for (size_t k = 0; k < i && !is_duplicate; k++)
+						is_duplicate = (Candidates[k] == Candidates[i]);
+
+					if (is_duplicate)
+						continue;
+
+					size_t entry_size = 0;
+					std::string text;
+					const bool is_accepted = GmpiValidateFunctionsArray(
+						Candidates[i],
+						ImageBase,
+						Finder,
+						entry_size,
+						text
+					);
+
+					Selection.ExaminedCount++;
+					Reporter(i, Candidates[i], is_accepted, entry_size, text);
+
+					if (!is_accepted)
+						continue;
+
+					if (!is_anything_selected || Candidates[i] < Selection.Candidate)
+					{
+						is_anything_selected = true;
+						Selection.Candidate = Candidates[i];
+						Selection.CandidateIndex = i;
+						Selection.EntrySize = entry_size;
+					}
+
+					if (!PreferLowest)
+						break;
+				}
+
+				return is_anything_selected;
+			}
+
+			// Stage 2 asks this before it runs both finders again, see MAXIMUM_FAILED_SEARCHES
+			inline bool GmpiIsSearchWorthRepeating(
+				IN size_t FailedSearchCount
+			)
+			{
+				return FailedSearchCount < MAXIMUM_FAILED_SEARCHES;
+			}
+		}
+	}
+}
