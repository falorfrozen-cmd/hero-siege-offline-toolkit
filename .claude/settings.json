{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "extraKnownMarketplaces": {
    "claude-plugins-official": {
      "source": { "source": "git", "url": "https://github.com/anthropics/claude-plugins-official.git" }
    },
    "impeccable": {
      "source": { "source": "github", "repo": "pbakaus/impeccable" }
    },
    "taste-skill": {
      "source": { "source": "github", "repo": "Leonxlnx/taste-skill" }
    }
  },
  "enabledPlugins": {
    "claude-code-setup@claude-plugins-official": true,
    "impeccable@impeccable": true,
    "taste-skill@taste-skill": true
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|Bash|PowerShell|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "py -3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/post_tool_use.py\"",
            "timeout": 60
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(py -3 -m unittest discover -s tests:*)",
      "Bash(py -3 -m unittest tests.test_claude_hooks:*)",
      "Bash(py -3 tools/minisign.py verify:*)",
      "Bash(node --test:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)"
    ]
  }
}
