{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "py -3 .claude/hooks/catalog_signature.py"
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "py -3 .claude/hooks/tauri_command_guard.py"
          },
          {
            "type": "command",
            "command": "py -3 .claude/hooks/hub_frontend_tests.py"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(py -3 -m unittest discover -s tests:*)",
      "Bash(py -3 tools/minisign.py verify:*)",
      "Bash(node --test:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)"
    ]
  }
}
