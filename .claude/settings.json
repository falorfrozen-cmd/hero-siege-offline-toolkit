{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|Bash|PowerShell|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "py -3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/catalog_signature.py\""
          },
          {
            "type": "command",
            "command": "py -3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/tauri_command_guard.py\""
          },
          {
            "type": "command",
            "command": "py -3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/hub_frontend_tests.py\""
          },
          {
            "type": "command",
            "command": "py -3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/decompiled_output.py\""
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(py -3 -m unittest discover -s tests:*)",
      "Bash(py -3 -m unittest tests.test_claude_hooks:*)",
      "Bash(py -3 tools/minisign.py verify:*)",
      "Bash(node --test:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)"
    ]
  }
}
